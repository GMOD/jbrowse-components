// Shared by every package's `tsconfig.build.esm.json`, which then carries
// nothing but its generated `references` array (see
// scripts/generate-tsconfig-references.ts). `${configDir}` resolves against the
// *extending* config, so the paths below land in each package, not here.
{
  "extends": "./tsconfig.json",
  "include": ["${configDir}/src/**/*.ts*"],
  // `*.node.ts` is a helper that only a test or a script runs, reaching for
  // `node:fs` and friends. This build has no node types and no business
  // emitting it into a browser bundle, so the suffix keeps it out — a plain
  // name lands in the build and fails it on the imports alone.
  "exclude": [
    "${configDir}/src/**/*.test.ts*",
    "${configDir}/src/**/*.node.ts"
  ],
  "compilerOptions": {
    "declaration": true,
    "outDir": "${configDir}/esm",
    "rootDir": "${configDir}/src",
    "noEmit": false,
    "composite": true
  }
}
