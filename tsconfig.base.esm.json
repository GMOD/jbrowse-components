// Shared by every package's `tsconfig.build.esm.json`, which then carries
// nothing but its generated `references` array (see
// scripts/generate-tsconfig-references.ts). `${configDir}` resolves against the
// *extending* config, so the paths below land in each package, not here.
{
  "extends": "./tsconfig.json",
  "include": ["${configDir}/src/**/*.ts*"],
  // The one definition of test-only source: these stay out of the published
  // package, and scripts/declaredDependencies.test.ts reads this list to hold
  // them to devDependencies. A helper only tests import is `*.fixture.ts`,
  // `testEnv.ts` or `testUtils.ts`. `*.node.ts` is excluded too: it imports
  // `node:*`, and this build has no node types.
  "exclude": [
    "${configDir}/src/**/*.test.ts*",
    "${configDir}/src/**/*.fixture.ts*",
    "${configDir}/src/**/testEnv.ts*",
    "${configDir}/src/**/testUtils.ts*",
    "${configDir}/src/**/test_data/**",
    "${configDir}/src/tests/**",
    "${configDir}/src/**/*.node.ts"
  ],
  "compilerOptions": {
    // No jest globals, so a shipped file that reaches for `expect` or `jest.fn`
    // fails the build instead of publishing a test helper.
    "types": [],
    "declaration": true,
    "outDir": "${configDir}/esm",
    "rootDir": "${configDir}/src",
    "noEmit": false,
    "composite": true
  }
}
