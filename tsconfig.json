{
  "compilerOptions": {
    "target": "esnext",
    "verbatimModuleSyntax": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "rootDir": "./",
    "outDir": "dist",
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "module": "esnext",
    "removeComments": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["jest"],
    "typeRoots": ["./node_modules/@types", "."]
  },
  "exclude": [
    "products/aws/",
    "**/build/",
    "**/docs/",
    "**/dist/",
    "**/esm/",
    "**/config/jest/",
    "**/embedded_demos/",
    "**/component_tests/",
    "**/examples-site/",
    "**/website",
    // Excluded from *this* project because they run in electron/node, not the
    // browser: they need `lib: esnext` (no DOM) and node's globals, so e.g.
    // `fetch`/`ReadableStream` resolve to node's rather than the DOM's. They
    // are not unchecked: each has its own tsconfig and `pnpm typecheck` runs
    // all three projects. Leaving them out of a typecheck entirely is how a
    // @gmod/faidx signature change reached a Windows release unnoticed.
    "products/jbrowse-desktop/test",
    "products/jbrowse-desktop/electron"
  ]
}
