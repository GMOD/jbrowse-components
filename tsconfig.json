{
  "compilerOptions": {
    "target": "esnext",
    "verbatimModuleSyntax": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "rootDir": "./",
    "noEmit": true,
    // Whole-repo `--noEmit` is 27-35s with no cache. With one: ~1.5s when
    // nothing changed or the edit didn't move a type, up to ~20s after an edit
    // that fans out from packages/core. `*.tsbuildinfo` is gitignored; the
    // composite build projects keep writing their own.
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "module": "esnext",
    // Jest and vite both transpile file-by-file, so the repo already lives
    // under these semantics — assert it rather than rely on it.
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["jest"]
  },
  // Selects exactly what the implicit `**/*` does — `tsconfigInclude.test.ts`
  // holds it to that, so a new top-level directory fails there rather than
  // leaving the typecheck unnoticed. Naming them is what makes `--watch`
  // usable: the implicit form registers one recursive watch on the repo root,
  // and tsgo 7.0.2 then reports a change roughly every 1.6s with nothing on
  // disk changing. In the primary checkout that watch also covers every
  // worktree under `.claude/`, i.e. every other agent's live tree.
  "include": [
    "global.d.ts",
    "agent-docs",
    "config",
    "demos",
    "embedded_demos",
    "example-plugins",
    "extra_test_data",
    "packages",
    "plugins",
    "products",
    "scripts",
    "test_data",
    "types"
  ],
  "exclude": [
    "products/aws/",
    "**/build/",
    "**/docs/",
    "**/dist/",
    "**/esm/",
    "**/config/jest/",
    "**/component_tests/",
    "**/examples-site/",
    "**/website",
    // Excluded from *this* project because they run in electron/node, not the
    // browser: they need `lib: esnext` (no DOM) and node's globals, so e.g.
    // `fetch`/`ReadableStream` resolve to node's rather than the DOM's. They
    // are not unchecked: each has its own tsconfig and `pnpm typecheck` runs
    // every one. Leaving them out of a typecheck entirely is how a
    // @gmod/faidx signature change reached a Windows release unnoticed.
    "products/jbrowse-desktop/test",
    "products/jbrowse-desktop/electron",
    "products/jbrowse-cli"
  ]
}
