{
  "$schema": "https://jbrowse.org/jb2/schema/v5/config.json",
  "assemblies": [
    {
      "name": "Col-0",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Col-0-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Col-0.chrom.sizes"
        }
      }
    },
    {
      "name": "Ler",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Ler-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Ler.chrom.sizes"
        }
      }
    },
    {
      "name": "Cvi",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Cvi-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Cvi.chrom.sizes"
        }
      }
    },
    {
      "name": "Eri",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Eri-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Eri.chrom.sizes"
        }
      }
    },
    {
      "name": "Kyo",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Kyo-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Kyo.chrom.sizes"
        }
      }
    },
    {
      "name": "Sha",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "Sha-ReferenceSequenceTrack",
        "adapter": {
          "type": "ChromSizesAdapter",
          "uri": "Sha.chrom.sizes"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "SyntenyTrack",
      "trackId": "syri",
      "name": "SyRI regions",
      "assemblyNames": ["Col-0", "Ler", "Cvi", "Eri", "Kyo", "Sha"],
      "adapter": {
        "type": "MultiGenomePAFAdapter",
        "uri": "syri.paf",
        "attributeColumns": ["syri", "color"]
      },
      "displays": [
        {
          "type": "MultiWaySyntenyDisplay",
          "rows": {
            "sort": ["Ler", "Cvi", "Eri", "Kyo", "Sha"]
          },
          "ribbons": {
            "encoding": {
              "color": {
                "field": "syri",
                "scale": {
                  "domain": ["SYN", "INV", "TRANS", "INVTR", "DUP", "INVDP"]
                }
              },
              "opacity": 0.7
            }
          }
        }
      ]
    },
    {
      "type": "FeatureTrack",
      "trackId": "syri_regions_on_Col-0",
      "name": "SyRI regions on Col-0, by genome",
      "assemblyNames": ["Col-0"],
      "adapter": {
        "type": "BedAdapter",
        "uri": "syri_regions.bed",
        "columnNames": [
          "chrom",
          "chromStart",
          "chromEnd",
          "name",
          "score",
          "strand",
          "thickStart",
          "thickEnd",
          "itemRgb",
          "query"
        ],
        "disableGeneHeuristic": true
      },
      "displays": [
        {
          "type": "LinearMultiRowFeatureDisplay",
          "rows": {
            "field": "query",
            "sort": ["Ler", "Cvi", "Eri", "Kyo", "Sha"]
          },
          "encoding": {
            "color": {
              "field": "name",
              "scale": {
                "domain": ["SYN", "INV", "TRANS", "INVTR", "DUP", "INVDP"],
                "range": [
                  "#cccccc",
                  "#ffa500",
                  "#9acd32",
                  "#9acd32",
                  "#00bbff",
                  "#00bbff"
                ]
              },
              "legend": {
                "title": "syri"
              }
            }
          }
        }
      ]
    }
  ],
  "defaultSession": {
    "name": "SyRI regions",
    "views": [
      {
        "type": "LinearSyntenyView",
        "views": [
          {
            "assembly": "Col-0"
          },
          {
            "assembly": "Ler"
          },
          {
            "assembly": "Cvi"
          },
          {
            "assembly": "Eri"
          },
          {
            "assembly": "Kyo"
          },
          {
            "assembly": "Sha"
          }
        ],
        "tracks": ["syri"],
        "encoding": {
          "color": {
            "field": "syri",
            "scale": {
              "domain": ["SYN", "INV", "TRANS", "INVTR", "DUP", "INVDP"]
            }
          },
          "opacity": 0.9
        },
        "filter": [
          {
            "field": "length",
            "gte": 10000
          }
        ],
        "mark": {
          "interpolate": "bump"
        },
        "render": {
          "antialias": false
        },
        "collapseEmptyRows": true,
        "levelHeights": [150, 150, 150, 150, 150]
      }
    ]
  }
}
