      "category": [
        "Single cell"
      ],
      "assemblyNames": [
        "hg38"
      ],
      "adapter": {
        "type": "MultiWiggleZarrAdapter",
        "uri": "https://jbrowse.org/demos/scrna_pbmc5k/percell.zarr"
      },
