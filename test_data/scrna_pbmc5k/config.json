          },
          {
            "type": "BigWigAdapter",
            "name": "CD16 Mono",
            "group": "Monocyte",
            "color": "#e377c2",
            "uri": "https://jbrowse.org/demos/scrna_pbmc5k/CD16_Mono.bw"
          },
          {
            "type": "BigWigAdapter",
            "name": "cDC",
            "group": "Dendritic",
            "color": "#9467bd",
            "uri": "https://jbrowse.org/demos/scrna_pbmc5k/cDC.bw"
