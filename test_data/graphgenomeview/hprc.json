      }
    },
    {
      "type": "FeatureTrack",
      "trackId": "hprc_minigraph_bubbles",
      "name": "HPRC release 2 bubbles",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "MinigraphBubbleAdapter",
