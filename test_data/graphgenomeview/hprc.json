          "displayId": "hprc2_pgbi_grch38_regular",
          "renderingMode": "phased"
        }
      ]
    },
    {
      "type": "FeatureTrack",
      "trackId": "hprc_minigraph_segments",
      "name": "HPRC release 2 graph (rGFA segments)",
      "assemblyNames": ["hg38", "hs1"],
      "adapter": {
        "type": "RgfaTabixAdapter",
        "uri": "https://jbrowse.org/demos/hprc/hprc-v2.0-mc-grch38",
        "assemblyNameToPanSN": {
          "hg38": "GRCh38",
          "hs1": "CHM13"
        }
      },
      "displayDefaults": {
        "color": "jexl:get(feature,'rank')==0?'rgb(52,152,219)':'rgb(237,137,44)'"
      }
    },
    {
      "type": "SyntenyTrack",
      "trackId": "hprc_cfhr_synteny_HG01109_1",
