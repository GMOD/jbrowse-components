{
  "plugins": [
    {
      "name": "GraphGenomeView",
      "esmUrl": "https://jbrowse.org/plugins/jbrowse-plugin-graphgenomeviewer/latest/dist/jbrowse-plugin-graphgenomeviewer.esm.js"
    },
    {
      "name": "Zarr",
      "url": "https://jbrowse.org/demos/zarr/jbrowse-plugin-zarr.umd.production.min.js"
    }
  ],
  "assemblies": [
    {
      "name": "hg38",
      "aliases": ["GRCh38"],
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "P6R5xbRqRr",
        "adapter": {
          "type": "BgzipFastaAdapter",
          "uri": "https://jbrowse.org/genomes/GRCh38/fasta/hg38.prefix.fa.gz"
        }
      },
      "refNameAliases": {
        "adapter": {
          "type": "RefNameAliasAdapter",
          "uri": "https://s3.amazonaws.com/jbrowse.org/genomes/GRCh38/hg38_aliases.txt"
        }
      },
      "cytobands": {
        "adapter": {
          "type": "CytobandAdapter",
          "uri": "https://s3.amazonaws.com/jbrowse.org/genomes/GRCh38/cytoBand.txt"
        }
      }
    }
  ],
  "tracks": [
    {
      "trackId": "cnv_1000g_zarr",
      "name": "1000 Genomes copy number, 2504 individuals (Zarr)",
      "category": ["Copy number"],
      "type": "MultiQuantitativeTrack",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "MultiWiggleZarrAdapter",
        "uri": "https://jbrowse.org/demos/1000g/qm2_cn_1kb.zarr"
      },
      "displayDefaults": {
        "mark": "span",
        "origin": 2,
        "scales": {
          "y": {
            "domainMin": 0,
            "domainMax": 4
          }
        },
        "color": {
          "field": "score",
          "scale": "threshold",
          "range": ["#2166ac", "#b2182b"]
        },
        "height": 500
      }
    },
    {
      "type": "GraphTrack",
      "trackId": "hprc_minigraph_segments",
      "name": "HPRC release 2.1 graph (rGFA segments)",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "RgfaTabixAdapter",
        "uri": "https://jbrowse.org/demos/hprc/hprc-v2.1-mc-grch38.anchored",
        "assemblyNameToPanSN": {
          "hg38": "GRCh38"
        },
        "coarse": {
          "uri": "https://jbrowse.org/demos/hprc/hprc-v2.1-mc-grch38.tier10000",
          "aboveBpPerPx": 1014
        }
      },
      "displayDefaults": {
        "color": {
          "field": "rank",
          "scale": "threshold",
          "domain": ["1"],
          "range": ["rgb(52,152,219)", "rgb(237,137,44)"],
          "labels": ["reference", "other assemblies"],
          "title": "Segment rank"
        }
      },
      "displays": [
        {
          "type": "LinearGraphDisplay",
          "displayId": "hprc_minigraph_segments-LinearGraphDisplay"
        },
        {
          "type": "LinearBasicDisplay",
          "displayId": "hprc_minigraph_segments-LinearBasicDisplay"
        }
      ]
    }
  ]
}
