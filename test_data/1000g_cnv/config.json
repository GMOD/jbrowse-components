{
  "plugins": [
    {
      "name": "Zarr",
      "url": "https://jbrowse.org/demos/zarr/jbrowse-plugin-zarr.umd.production.min.js"
    }
  ],
  "assemblies": [
    {
      "name": "hg38",
      "aliases": ["GRCh38"],
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "P6R5xbRqRr",
        "adapter": {
          "type": "BgzipFastaAdapter",
          "uri": "https://jbrowse.org/genomes/GRCh38/fasta/hg38.prefix.fa.gz"
        }
      },
      "refNameAliases": {
        "adapter": {
          "type": "RefNameAliasAdapter",
          "uri": "https://s3.amazonaws.com/jbrowse.org/genomes/GRCh38/hg38_aliases.txt"
        }
      },
      "cytobands": {
        "adapter": {
          "type": "CytobandAdapter",
          "uri": "https://s3.amazonaws.com/jbrowse.org/genomes/GRCh38/cytoBand.txt"
        }
      }
    }
  ],
  "tracks": [
    {
      "trackId": "cnv_1000g_zarr",
      "name": "1000 Genomes copy number, 2504 individuals (Zarr)",
      "category": ["Copy number"],
      "type": "MultiQuantitativeTrack",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "MultiWiggleZarrAdapter",
        "uri": "https://jbrowse.org/demos/1000g/qm2_cn_1kb.zarr"
      },
      "displayDefaults": {
        "defaultRendering": "multirowdensity",
        "bicolorPivot": 2,
        "minScore": 0,
        "maxScore": 4,
        "posColor": "#b2182b",
        "negColor": "#2166ac",
        "height": 500
      }
    },
    {
      "trackId": "cnv_1000g_zarr_wg",
      "name": "1000 Genomes copy number, 2504 individuals, genome-wide (Zarr)",
      "category": ["Copy number"],
      "type": "MultiQuantitativeTrack",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "MultiWiggleZarrAdapter",
        "uri": "https://jbrowse.org/demos/1000g/qm2_cn_wg_10kb.zarr"
      },
      "displayDefaults": {
        "defaultRendering": "multirowdensity",
        "bicolorPivot": 2,
        "minScore": 0,
        "maxScore": 4,
        "posColor": "#b2182b",
        "negColor": "#2166ac",
        "height": 500
      }
    },
    {
      "trackId": "ncbi_refseq_hg38",
      "name": "NCBI RefSeq genes",
      "category": ["Annotation"],
      "type": "FeatureTrack",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://jbrowse.org/ucsc/hg38/ncbiRefSeq.gff.gz",
        "csi": true
      }
    },
    {
      "trackId": "integrated_sv_map_v2",
      "name": "1000 Genomes integrated SV map (phase 3)",
      "category": ["Variants"],
      "type": "VariantTrack",
      "assemblyNames": ["hg38"],
      "adapter": {
        "type": "VcfTabixAdapter",
        "uri": "https://1000genomes.s3.amazonaws.com/phase3/integrated_sv_map/supporting/GRCh38_positions/ALL.wgs.integrated_sv_map_v2_GRCh38.20130502.svs.genotypes.vcf.gz"
      }
    }
  ]
}
