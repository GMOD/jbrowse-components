{
  "name": "@jbrowse/website-astro",
  "type": "module",
  "//": "private, like every other unpublished workspace package: it is in pnpm-workspace.yaml, so `pnpm publish -r` in publish.yml walks it. It survives today only because it carries no version and pnpm skips it for that reason rather than on purpose.",
  "private": true,
  "scripts": {
    "dev": "pnpm figures:pull && pnpm gen:derived-figures && astro dev",
    "build": "pnpm figures:pull && pnpm gen:derived-figures && astro build && pagefind --site dist",
    "index": "pnpm figures:pull && pnpm gen:derived-figures && astro build && pagefind --site dist --output-path static/pagefind",
    "preview": "astro preview",
    "typecheck": "astro check && node ../node_modules/typescript7/bin/tsc --noEmit -p scripts/api-docs",
    "lint-docs": "node scripts/generate-guide-indexes.ts",
    "check-doc-imports": "node scripts/check-doc-imports.ts",
    "check-rename-archaeology": "node scripts/check-rename-archaeology.ts",
    "check-sidebar": "node scripts/check-sidebar.ts",
    "check-wiki-titles": "node scripts/check-wiki-titles.ts",
    "check-captions": "node scripts/check-captions.ts",
    "check-tldr": "node scripts/check-tldr.ts",
    "check-gallery-links": "node scripts/check-gallery-links.ts",
    "check-remote-hosts": "node scripts/check-remote-hosts.ts",
    "check-links": "node scripts/check-links.ts",
    "check-external-links": "node scripts/check-external-links.ts",
    "check-menu-paths": "node scripts/check-menu-paths.ts",
    "check-menu-labels": "node scripts/check-menu-labels.ts",
    "check-llms": "node scripts/check-llms.ts",
    "check-dupe-ids": "node scripts/check-duplicate-ids.ts",
    "check-widget-styles": "node scripts/check-widget-styles.ts",
    "check-todo-index": "node scripts/check-todo-index.ts",
    "check-reference-citations": "node scripts/check-reference-citations.ts",
    "snapshot": "node scripts/snapshot.ts",
    "screenshots": "pnpm figures:pull && node scripts/generate-screenshots.ts",
    "screenshots:build": "pnpm figures:pull && pnpm --filter @jbrowse/web build && pnpm --filter @jbrowse/react-linear-genome-view2 build:webpack && node scripts/generate-screenshots.ts",
    "//video": "The motion tours (scripts/video-specs.ts). Deliberately OFF the screenshots path: a screencast is not content-stable, so it is regenerated on demand and never by a sweep.",
    "video": "node scripts/generate-video.ts",
    "video:build": "pnpm --filter @jbrowse/web build && node scripts/generate-video.ts",
    "media": "node scripts/media.ts",
    "media:pull": "node scripts/media.ts pull",
    "media:push": "node scripts/media.ts push",
    "check-media": "node scripts/media.ts check",
    "check-spec-recipes": "node scripts/check-spec-recipes.ts",
    "check-specs": "node scripts/check-specs.ts",
    "check-live-configs": "node scripts/check-live-configs.ts",
    "check-figure-refs": "node scripts/check-figure-refs.ts",
    "check-paste-configs": "node scripts/check-paste-configs.ts",
    "check-config-cli": "node scripts/check-config-cli.ts",
    "check-config-blocks": "node scripts/check-config-blocks.ts",
    "check-session-urls": "node scripts/check-session-urls.ts",
    "check-script-commands": "node scripts/check-script-commands.ts",
    "check-doc-slots": "node scripts/check-doc-slots.ts",
    "check-doc-surfaces": "node scripts/check-doc-surfaces.ts",
    "gen:gallery-links": "node scripts/gen-gallery-links.ts",
    "gen:live-links": "node scripts/gen-live-links.ts",
    "//gen:derived-figures": "Every image computed from a figure rather than captured. The store holds none of them, so this has to run before anything renders the site — see isDerivedFigure in scripts/figure-store.ts.",
    "gen:derived-figures": "pnpm gen:gallery-thumbs && pnpm gen:tutorial-thumbs && pnpm gen:home-images",
    "gen:gallery-thumbs": "node scripts/gen-gallery-thumbs.ts",
    "gen:tutorial-thumbs": "node scripts/gen-tutorial-thumbs.ts",
    "gen:home-images": "node scripts/gen-home-images.ts",
    "review": "pnpm figures:pull && node scripts/review-screenshots-web.ts",
    "audit-figures": "node scripts/audit-figures.ts",
    "figures:pull": "node scripts/figures.ts pull",
    "figures:triage": "node scripts/triage-figure-diffs.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "astro": "^7.2.2",
    "astro-icon": "^1.1.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@iconify-json/mdi": "^1.2.3",
    "@jbrowse/browser-test-utils": "workspace:*",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "pagefind": "^1.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  }
}
