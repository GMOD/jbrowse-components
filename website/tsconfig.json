{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "noUncheckedIndexedAccess": true
  },
  "exclude": [
    "dist",
    "static/pagefind",
    // Own standalone tsconfig (jest globals for its tests, which astro check
    // has no types for). `pnpm typecheck` runs that project as a second step,
    // so it is excluded here but not unchecked.
    "scripts/api-docs"
  ]
}
