---
import { getCollection } from 'astro:content'

import SidebarLayout from './SidebarLayout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import CopyMarkdown from '../components/CopyMarkdown.astro'
import DocsSidebarNav from '../components/DocsSidebarNav.astro'
import TableOfContents from '../components/TableOfContents.astro'
import { baseUrl } from '../lib/base-url.ts'
import { entrySlug } from '../lib/docs-sidebar.ts'

import type { TocItem } from '../lib/rehype-collect-toc.ts'

interface Props {
  title: string
  currentSlug: string
  description?: string
  toc?: TocItem[]
  rawMarkdown?: string
}

const {
  title,
  currentSlug,
  description,
  toc = [],
  rawMarkdown = '',
} = Astro.props

const allDocs = await getCollection('docs')
// Raw-Markdown alternate emitted by emit-raw-markdown.ts (introduction, whose
// slug is "", lives at index.md). Only real doc-collection pages get one — a
// landing page reusing this layout (e.g. /docs/tutorials/) has no emitted .md.
const isRealDoc = allDocs.some(doc => entrySlug(doc.id) === currentSlug)
const mdHref = isRealDoc
  ? `${baseUrl}/docs/${currentSlug || 'index'}.md`
  : undefined
// every tutorial gets the same feedback line, so no page carries its own copy
const isTutorial = isRealDoc && currentSlug.startsWith('tutorials/')
---

<SidebarLayout
  title={`${title} | JBrowse Docs`}
  description={description}
  toggleLabel="Contents"
  navLabel="Documentation navigation"
  mdHref={mdHref}
>
  <DocsSidebarNav slot="nav" currentSlug={currentSlug} />
  <article class="docs-content" data-pagefind-body>
    <Breadcrumbs currentSlug={currentSlug} />
    <h1>{title}</h1>
    <slot />
    {
      isTutorial && (
        <p class="tutorial-feedback">
          Feedback on this tutorial is welcome:{' '}
          <a href={`${baseUrl}/contact/`}>contact us</a>.
        </p>
      )
    }
  </article>
  <CopyMarkdown markdown={rawMarkdown} title={title} />
  {toc.length > 0 && <TableOfContents toc={toc} />}
</SidebarLayout>

{
  /* Cell dialogs are emitted into the generated HTML by the api-docs scripts,
    so they are wired here rather than mounted as an island. */
}
<script>
  // open the dialog holding a table cell's full value (a long type signature, a
  // jexl default, an #example) — see dialogCell in scripts/api-docs/util.ts
  //
  // The recipe dialog beside a figure, its Copy buttons, and the backdrop
  // light-dismiss this dialog also relies on, all live in
  // components/SpecDialog.astro, which BaseLayout mounts on every page — the
  // gallery renders the same recipe dialog and cannot reach a docs-only
  // listener.
  document.addEventListener('click', event => {
    const target = event.target
    if (target instanceof HTMLElement) {
      const trigger = target.closest('.cell-more-trigger')
      const dialog = trigger?.parentElement?.querySelector('dialog')
      if (dialog instanceof HTMLDialogElement && !dialog.open) {
        dialog.showModal()
      }
    }
  })
</script>

<style>
  .docs-content {
    flex: 1;
    max-width: min(1060px, 100%);
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    min-width: 0;
    line-height: 1.7;
    overflow-wrap: break-word;
  }

  .tutorial-feedback {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .docs-content h1 {
    font-size: 2.25rem;
    font-weight: 700;
    margin-top: 0;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  .docs-content :global(h2) {
    font-size: 1.6rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-text);
  }
  .docs-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-top: 2rem;
    color: var(--color-text);
  }
  .docs-content :global(h4) {
    font-size: 1.05rem;
    font-weight: 700;
    margin-top: 1.5rem;
    color: var(--color-text);
  }

  .docs-content :global(h2),
  .docs-content :global(h3),
  .docs-content :global(h4) {
    position: relative;
  }

  /* Autogenerated config/model docs wrap each section in a <details> whose
     <summary> stands in for an h3 heading — style it to match (see the
     `collapsible` helper in docs/util.ts). */
  .docs-content :global(details) {
    margin-top: 2rem;
  }
  .docs-content :global(details > summary) {
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  /* A table cell's oversized value (long type signature, jexl default,
     #example): the trigger reads as the truncated code itself, and the full
     value opens in a modal rather than reflowing the table. See dialogCell in
     scripts/api-docs/util.ts. */
  .docs-content :global(.cell-more-trigger) {
    display: inline;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    text-decoration: underline dotted var(--color-text-muted);
    text-underline-offset: 3px;
  }
  .docs-content :global(.cell-more-trigger:hover) {
    text-decoration-color: var(--color-accent);
  }
  .docs-content :global(.cell-dialog) {
    width: min(60rem, 92vw);
    max-height: 85vh;
    padding: 1rem 1.25rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-text);
    overflow: auto;
  }
  .docs-content :global(.cell-dialog::backdrop) {
    background: rgba(0, 0, 0, 0.55);
  }
  .docs-content :global(.cell-dialog pre) {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .docs-content :global(.cell-dialog-close) {
    float: right;
    padding: 0.15rem 0.4rem;
    border: none;
    border-radius: 4px;
    background: none;
    color: var(--color-text-muted);
    font-size: 1rem;
    cursor: pointer;
  }
  .docs-content :global(.cell-dialog-close:hover) {
    background: var(--color-code-bg);
    color: var(--color-text);
  }
  /* The header row introducing a base config's run of inherited slots in an
     autogenerated config page's slot table (slotGroupRow in
     scripts/api-docs/generateConfigDocs.ts). It takes the table header's own
     fill across both cells — which also beats the zebra stripe — so the run
     reads as one section a reader can skip past rather than as another slot. */
  .docs-content :global(tr:has(.slot-group) td) {
    background: var(--color-table-header-bg);
    border-top: 2px solid var(--color-text-muted);
    font-weight: 600;
  }
  .docs-content :global(.slot-group-count) {
    float: right;
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .docs-content :global(.heading-anchor) {
    opacity: 0;
    margin-left: 0.4rem;
    font-size: 0.8em;
    font-weight: 400;
    color: var(--color-accent);
    text-decoration: none !important;
    transition: opacity 0.15s;
  }
  .docs-content :global(h2:hover .heading-anchor),
  .docs-content :global(h3:hover .heading-anchor),
  .docs-content :global(h4:hover .heading-anchor) {
    opacity: 1;
  }

  .docs-content :global(pre),
  .docs-content :global(code) {
    font-family: var(--font-mono);
  }
  .docs-content :global(pre) {
    background: var(--color-code-bg);
    color: var(--color-code-text);
    padding: 1rem 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 1rem 0;
  }
  /* Inline code is bare mono, no chip: prose like file_types.md is mostly
     backticks, and a bordered box per token reads as noise. Inheriting the color
     also means code inside a link looks like a link. */
  .docs-content :global(code:not(pre code)) {
    font-size: 0.9em;
  }
  .docs-content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1rem auto;
    border-radius: 4px;
    border: 1px solid var(--color-border);
  }
  .docs-content :global(figure) {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem;
    margin: 1.5rem 0;
    background: var(--color-surface);
  }
  .docs-content :global(figcaption) {
    text-align: center;
    font-style: italic;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }
  /* set on the live link of a figure whose session is slow to open (heavy remote
     data or whole-genome clustering) — see slowNote in lib/remark-figure.ts */
  .docs-content :global(.figure-slow-note) {
    font-style: normal;
    font-size: 0.85em;
  }
  /* display:block is what makes a too-wide table (a config slot table with long
     type signatures) scroll instead of blowing out the column; the table inside
     that block sizes to its content, so hug it rather than leaving dead space to
     the right of the border. */
  .docs-content :global(table) {
    border-collapse: collapse;
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.25rem 0;
    font-size: 0.9rem;
  }
  .docs-content :global(th),
  .docs-content :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.45rem 0.7rem;
    text-align: left;
    vertical-align: top;
  }
  .docs-content :global(th) {
    background: var(--color-table-header-bg);
    font-weight: 600;
  }
  /* Auto table layout hands a column room for its longest unbreakable run, so
     one long type signature in a config page's Slot column claimed 522 of 980px
     and squeezed every description into a 268px ribbon. Letting code wrap where
     it has to gives the descriptions the space (measured: 252/538, a quarter
     shorter table) and leaves every other table's columns unchanged. */
  .docs-content :global(td code) {
    overflow-wrap: anywhere;
  }
  .docs-content :global(tbody tr:nth-child(even)) {
    background: var(--color-table-stripe);
  }
  .docs-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    margin: 1.5rem 0;
    padding: 0.5rem 1.25rem;
    background: var(--color-blockquote-bg);
    color: var(--color-text);
    border-radius: 0 4px 4px 0;
  }
  .docs-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }
  .docs-content :global(a:hover) {
    color: var(--color-accent-dark);
    text-decoration: underline;
  }
  /* Links in running prose carry an underline, so they don't rely on color
     alone; chrome links (heading anchors, figure live links, recipe dialogs)
     keep the hover-only treatment above. */
  .docs-content :global(p a),
  .docs-content :global(li a),
  .docs-content :global(td a) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .docs-content :global(ul),
  .docs-content :global(ol) {
    padding-left: 1.75rem;
    margin: 0.5rem 0 1rem;
  }
  .docs-content :global(li) {
    margin: 0.3rem 0;
  }

  .docs-content :global(.admonition) {
    border-radius: 6px;
    padding: 0.75rem 1rem;
    margin: 1.5rem 0;
  }
  .docs-content :global(.admonition > *:last-child) {
    margin-bottom: 0;
  }
  .docs-content :global(.admonition-title) {
    font-weight: 700;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }
  .docs-content :global(.admonition-note) {
    background: #f0f4ff;
    border-left: 4px solid #4a6cf7;
  }
  .docs-content :global(.admonition-note .admonition-title) {
    color: #4a6cf7;
  }
  .docs-content :global(.admonition-info) {
    background: #f0faf8;
    border-left: 4px solid var(--color-accent);
  }
  .docs-content :global(.admonition-info .admonition-title) {
    color: var(--color-accent);
  }
  .docs-content :global(.admonition-tip) {
    background: #f0fdf4;
    border-left: 4px solid #16a34a;
  }
  .docs-content :global(.admonition-tip .admonition-title) {
    color: #16a34a;
  }
  .docs-content :global(.admonition-caution) {
    background: #fffbeb;
    border-left: 4px solid #d97706;
  }
  .docs-content :global(.admonition-caution .admonition-title) {
    color: #d97706;
  }
  .docs-content :global(.admonition-warning) {
    background: #fff1f0;
    border-left: 4px solid #e53e3e;
  }
  .docs-content :global(.admonition-warning .admonition-title) {
    color: #e53e3e;
  }

  @media (max-width: 768px) {
    .docs-content h1 {
      font-size: 1.5rem;
    }
    .docs-content :global(h2) {
      font-size: 1.25rem;
    }
    .docs-content :global(h3) {
      font-size: 1.1rem;
    }
  }
</style>
