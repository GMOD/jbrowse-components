---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description?: string
  toggleLabel: string
  navLabel: string
  mdHref?: string
}

const { title, description, toggleLabel, navLabel, mdHref } = Astro.props
---

<BaseLayout title={title} description={description} mdHref={mdHref}>
  <div class="sidebar-layout">
    <button
      class="sidebar-toggle"
      id="sidebar-toggle"
      aria-expanded="false"
      aria-controls="sidebar-nav"
    >
      ☰ {toggleLabel}
    </button>
    <nav class="sidebar" id="sidebar-nav" aria-label={navLabel}>
      <slot name="nav" />
    </nav>
    <slot />
  </div>
</BaseLayout>

<script>
  const sidebar = document.querySelector('.sidebar') as HTMLElement | null
  // ancestor <details> are already server-rendered open (containsSlug / year
  // match); just center the active link in the scroll viewport
  const active = sidebar?.querySelector('a[aria-current="page"]')
  if (active && sidebar) {
    const offset =
      active.getBoundingClientRect().top - sidebar.getBoundingClientRect().top
    sidebar.scrollTop += offset - sidebar.clientHeight / 2
  }

  document
    .getElementById('sidebar-toggle')
    ?.addEventListener('click', function () {
      const expanded = this.getAttribute('aria-expanded') === 'true'
      this.setAttribute('aria-expanded', String(!expanded))
      sidebar?.classList.toggle('sidebar-open', !expanded)
    })
</script>

<style>
  .sidebar-layout {
    display: flex;
    min-height: calc(100vh - var(--nav-height));
  }

  .sidebar-toggle {
    display: none;
  }

  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    border-right: 1px solid var(--color-border);
    overflow-y: auto;
    /* No top padding: a `position: sticky` child (the docs filter box) is
       clamped to its containing block, which is this element's *content* box,
       so any padding here becomes a strip the child pins below and scrolled
       rows show through. The first child carries the gap as a margin instead —
       a margin doesn't move the containing-block edge, so the child still pins
       flush with the top of the scrollport. */
    padding: 0 0 1rem;
    position: sticky;
    top: var(--nav-height);
    height: calc(100vh - var(--nav-height));
  }
  .sidebar > :global(:first-child) {
    margin-top: 1rem;
  }

  .sidebar :global(ul) {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.5rem;
  }
  .sidebar > :global(ul) {
    padding: 0;
  }

  .sidebar :global(a) {
    display: block;
    padding: var(--sidebar-link-padding);
    color: var(--color-sidebar-text);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    border-radius: 3px;
    transition: background 0.15s;
    /* Hanging indent, so the few labels long enough to wrap don't read as two
       entries. The negative indent pulls the first line back to the 12px the
       shorthand above sets. */
    padding-left: calc(12px + 1em);
    text-indent: -1em;
  }

  /* A subcategory label, not a control: no caret, no hover, not focusable. It
     sits in the same <ul> at the same text offset as the links it heads (the
     12px here lands on the same x as their calc(12px + 1em) first line, after
     the -1em text-indent), so the list still reads as one flat column. */
  .sidebar :global(.sidebar-heading) {
    margin: 0.85rem 0 0.1rem;
    padding: 0 12px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .sidebar :global(li:first-child.sidebar-heading) {
    margin-top: 0.2rem;
  }
  .sidebar :global(a:hover) {
    background: var(--color-sidebar-hover-bg);
    color: var(--color-navy);
  }
  .sidebar :global(a.active) {
    background: var(--color-sidebar-active-bg);
    color: var(--color-sidebar-active-text);
    font-weight: 500;
    border-left: 3px solid var(--color-accent);
    padding-left: calc(12px + 1em - 3px);
  }

  .sidebar :global(details > summary) {
    cursor: pointer;
    padding: var(--sidebar-link-padding);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-sidebar-text);
    list-style: none;
    user-select: none;
    display: flex;
    align-items: center;
    gap: 0.5em;
    border-radius: 3px;
    transition: background 0.15s;
  }
  .sidebar :global(details > summary:hover) {
    background: var(--color-sidebar-hover-bg);
    color: var(--color-navy);
  }
  .sidebar :global(details > summary::-webkit-details-marker) {
    display: none;
  }
  .sidebar :global(details > summary::before) {
    content: '';
    display: inline-block;
    flex-shrink: 0;
    width: 0.4em;
    height: 0.4em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.15s ease;
    opacity: 0.7;
  }
  .sidebar :global(details[open] > summary::before) {
    transform: rotate(45deg);
  }

  /* A summary that is itself a page link (a category with an `overview` page):
     the summary supplies the padding + caret, so the inner link is plain text
     that fills the row. The caret still toggles — clicking it, or the padding
     around the label, opens the category without leaving the page — and the
     underline on hover is what distinguishes these headers from the two that
     have no page of their own and are pure toggles. */
  .sidebar :global(summary > .summary-link) {
    display: block;
    flex: 1;
    padding: 0;
    color: inherit;
    font-weight: inherit;
    border-radius: 0;
    /* Cancel the hanging indent every other sidebar link carries: here the row's
       first line starts after the caret, and a -1em pull puts the label on top
       of it — which reads as the category having lost its disclosure arrow. */
    text-indent: 0;
  }
  .sidebar :global(summary > .summary-link:hover) {
    background: none;
    color: var(--color-navy);
    text-decoration: underline;
  }
  .sidebar :global(summary > .summary-link.active) {
    background: none;
    border-left: none;
    padding-left: 0;
    color: var(--color-sidebar-active-text);
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .sidebar-layout {
      flex-direction: column;
    }

    .sidebar-toggle {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
      padding: 0.6rem 1rem;
      background: var(--color-surface);
      border: none;
      border-bottom: 1px solid var(--color-border);
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--color-sidebar-text);
      cursor: pointer;
      text-align: left;
    }

    .sidebar {
      display: none;
      width: 100%;
      height: auto;
      max-height: 50vh;
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      overflow-y: auto;
    }
    .sidebar.sidebar-open {
      display: block;
    }
  }
</style>
