---
interface Props {
  href: string
}

const { href } = Astro.props
---

<button
  id="copy-markdown"
  class="rail-button"
  data-href={href}
  type="button"
  title="Copy this page as raw Markdown (for pasting into an LLM)"
>
  <svg width="15" height="15" viewBox="0 0 24 24" aria-hidden="true">
    <path
      class="copy-icon"
      d="M9 9h9v11H9zM6 15H4V4h9v2"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"
    ></path>
    <path
      class="check-icon"
      d="M5 13l4 4L19 7"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linejoin="round"
      stroke-linecap="round"
      style="display: none"
    ></path>
  </svg>
  <span>Copy markdown</span>
</button>

<script>
  const btn = document.getElementById('copy-markdown')
  const label = btn?.querySelector('span')
  const copyIcon = btn?.querySelector('.copy-icon')
  const checkIcon = btn?.querySelector('.check-icon')
  const original = label?.textContent ?? 'Copy markdown'
  let reset: ReturnType<typeof setTimeout> | undefined

  async function markdownBlob(href: string) {
    const response = await fetch(href)
    if (!response.ok) {
      throw new Error(`${href}: ${response.status}`)
    }
    return new Blob([await response.text()], { type: 'text/plain' })
  }

  // The fetch's promise goes into the ClipboardItem rather than being awaited
  // first: Safari drops the click's permission to write across an await.
  btn?.addEventListener('click', async () => {
    const href = btn.dataset.href ?? ''
    let ok = true
    try {
      await navigator.clipboard.write([
        new ClipboardItem({ 'text/plain': markdownBlob(href) }),
      ])
    } catch {
      ok = false
    }
    if (label) {
      label.textContent = ok ? 'Copied!' : 'Copy failed'
    }
    if (ok) {
      copyIcon?.setAttribute('style', 'display: none')
      checkIcon?.setAttribute('style', '')
      btn.classList.add('copied')
    }
    clearTimeout(reset)
    reset = setTimeout(() => {
      if (label) {
        label.textContent = original
      }
      copyIcon?.setAttribute('style', '')
      checkIcon?.setAttribute('style', 'display: none')
      btn.classList.remove('copied')
    }, 1500)
  })
</script>

<style>
  #copy-markdown.copied {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: var(--color-sidebar-active-bg);
  }

  /* On wide viewports the TOC toggle occupies the top-right slot; stack the
     copy button just below it. Below 1200px the toggle is hidden, so the copy
     button takes the top slot. */
  @media (min-width: 1201px) {
    #copy-markdown {
      top: calc(var(--nav-height) + 0.75rem + 2.6rem);
    }
  }
  @media (max-width: 768px) {
    #copy-markdown {
      display: none;
    }
  }
</style>
