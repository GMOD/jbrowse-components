---
import { getCollection } from 'astro:content'

import { baseUrl } from '../lib/base-url.ts'
import { buildSearchCategoryPrefixes } from '../lib/docs-sidebar.ts'

const searchPrefixes = buildSearchCategoryPrefixes(await getCollection('docs'))
---

<!-- Header search: a compact input with an instant pagefind results dropdown.
     Enter (or the dropdown footer) opens the full /search/ page, which reruns
     the same query. Pagefind is loaded lazily on first input; if it is absent
     (local dev without `pnpm index`), the box still submits to /search/. -->
<form class="hs-form" role="search" action={`${baseUrl}/search/`} method="get">
  <svg
    class="hs-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path>
  </svg>
  <input
    id="hs-input"
    name="q"
    type="search"
    class="hs-input"
    placeholder="Search docs..."
    autocomplete="off"
    aria-label="Search documentation"
  />
  <div id="hs-results" class="hs-results" hidden></div>
</form>

<script is:inline define:vars={{ baseUrl, searchPrefixes }}>
  const form = document.querySelector('.hs-form')
  const input = document.getElementById('hs-input')
  const panel = document.getElementById('hs-results')
  let pagefind
  let debounce

  // The generated reference (config schema, state models, exported functions) is
  // 244 of the ~390 indexed doc pages, so on a word that appears in a lot of
  // JSDoc it can take the whole dropdown: measured against this index, "session"
  // returned six state-model internals and nothing else, and "display" five of
  // six. Those are ordinary user-level words, and the six slots here are the
  // only search result most readers ever see.
  //
  // A quota rather than a re-rank. Sorting reference below guides outright — the
  // way the /search page's CATEGORY_PRIORITY does, where it costs less because
  // every result is on the page — would push config/bamadapter out of the
  // dropdown for the query "bam", which is the one hit that should be first.
  // Keeping pagefind's order and only dropping reference hits past the third
  // leaves a name match at the top and still guarantees half the panel to
  // everything else.
  const REFERENCE_SLOTS = 3
  const HITS = 6
  // Enough to find three non-reference hits under the worst query measured
  // ("display" needed 29 to find six; three arrive far sooner). Each costs one
  // small fragment fetch, and only for the results we actually rank.
  const WINDOW = 24

  // shortPath is hoisted; a non-docs page (gallery, features) has no "docs/"
  // prefix to strip, finds no bucket, and is never reference — which is right.
  function isReference(url) {
    const path = shortPath(url)
    if (!path.startsWith('docs/')) {
      return false
    }
    const slug = path.slice('docs/'.length)
    const slash = slug.indexOf('/')
    return (
      (slash === -1
        ? searchPrefixes.slugs[slug]
        : searchPrefixes.dirs[slug.slice(0, slash)]) === 'autogen'
    )
  }

  async function getPagefind() {
    if (pagefind === undefined) {
      try {
        pagefind = await import(`${baseUrl}/pagefind/pagefind.js`)
      } catch {
        pagefind = null // absent in local dev; Enter still submits to /search/
      }
    }
    return pagefind
  }

  function close() {
    panel.hidden = true
    panel.replaceChildren()
  }

  // Site-root-relative, with no base path and no trailing slash — both the
  // dropdown's second line and the bucket lookup in isReference() key off it.
  // baseUrl, not a literal "/jb2": deploy_staging.sh builds with
  // SITE_BASE_PATH=/jb2-staging, and under that a hardcoded prefix strips
  // nothing, so every row read "jb2-staging/docs/..." AND isReference() stopped
  // matching "docs/" — silently retiring the whole reference quota below on the
  // one deploy where docs changes get looked at first.
  function shortPath(url) {
    const path = new URL(url, location.href).pathname
    const stripped = path.startsWith(`${baseUrl}/`)
      ? path.slice(baseUrl.length)
      : path
    return stripped.replace(/^\//, '').replace(/\/$/, '')
  }

  async function run(query) {
    if (!query.trim()) {
      close()
      return
    }
    const pf = await getPagefind()
    if (!pf) {
      return
    }
    const { results } = await pf.search(query)
    const window = await Promise.all(
      results.slice(0, WINDOW).map(r => r.data()),
    )
    if (input.value !== query) {
      return // a newer keystroke already superseded this search
    }
    // one pass in relevance order, skipping reference hits past the quota
    const items = []
    let reference = 0
    for (const hit of window) {
      if (isReference(hit.url)) {
        if (reference === REFERENCE_SLOTS) {
          continue
        }
        reference++
      }
      items.push(hit)
      if (items.length === HITS) {
        break
      }
    }
    const all = `${baseUrl}/search/?q=${encodeURIComponent(query)}`
    panel.innerHTML = items.length
      ? `${items
          .map(
            it =>
              `<a class="hs-hit" href="${it.url}"><span class="hs-hit-title">${it.meta?.title ?? shortPath(it.url)}</span><span class="hs-hit-path">${shortPath(it.url)}</span></a>`,
          )
          .join('')}<a class="hs-all" href="${all}">See all results</a>`
      : `<a class="hs-all" href="${all}">No quick matches — search all docs</a>`
    panel.hidden = false
  }

  input.addEventListener('input', () => {
    clearTimeout(debounce)
    debounce = setTimeout(() => run(input.value), 150)
  })
  input.addEventListener('focus', () => {
    if (input.value.trim()) {
      run(input.value)
    }
  })
  input.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      close()
      input.blur()
    }
  })
  document.addEventListener('click', e => {
    if (!form.contains(e.target)) {
      close()
    }
  })
</script>

<style is:global>
  .hs-form {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 4px 10px;
  }
  .hs-form:focus-within {
    background: rgba(255, 255, 255, 0.18);
    border-color: var(--color-teal-bright);
  }
  .hs-icon {
    color: rgba(255, 255, 255, 0.8);
    flex-shrink: 0;
  }
  .hs-input {
    background: none;
    border: none;
    outline: none;
    color: white;
    font-size: 0.9rem;
    width: 150px;
    max-width: 40vw;
  }
  .hs-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }
  .hs-results {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: min(360px, 90vw);
    max-height: 70vh;
    overflow-y: auto;
    background: white;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
    z-index: 300;
  }
  /* Prefix with .hs-results so these beat the header's `.navRight a { color:
     white }` (specificity 0,1,1) — otherwise the dropdown text inherits white
     on a white background. */
  .hs-results .hs-hit,
  .hs-results .hs-all {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    padding: 8px 12px;
    border-bottom: 1px solid var(--color-border);
  }
  .hs-results .hs-hit:hover,
  .hs-results .hs-all:hover {
    background: var(--color-surface);
  }
  .hs-results .hs-hit-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }
  .hs-results .hs-hit-path {
    display: block;
    font-size: 0.75rem;
    color: var(--color-accent);
  }
  .hs-results .hs-all {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    border-bottom: none;
  }
</style>
