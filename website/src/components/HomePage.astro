---
import { Icon } from 'astro-icon/components'

import NewsletterSignup from './NewsletterSignup.astro'
import { baseUrl } from '../lib/base-url.ts'
import { newsletterApiUrl } from '../lib/newsletter.ts'
import btn from '../styles/button.module.css'
---

<div class="outer-box">
  <!-- Hero row -->
  <div class="hero-row">
    <div class="hero-text">
      <h1 class="hero-title">JBrowse</h1>
      <p class="hero-subtitle">The next-generation genome browser</p>
      <p class="body-text">
        JBrowse is a genome browser that runs on the web, on your desktop, or
        embedded in your app.
      </p>
      <div class="btn-row">
        <a class:list={[btn.btn, btn.btnPrimary]} href={`${baseUrl}/download/`}>
          <Icon name="mdi:tray-arrow-down" width="20" height="20" />
          Download
        </a>
        <a
          class:list={[btn.btn, btn.btnAccent]}
          href={`${baseUrl}/docs/tutorials/`}
        >
          <Icon name="mdi:play-circle-outline" width="20" height="20" />
          Tutorials
        </a>
      </div>
      {
        newsletterApiUrl && (
          <div class="newsletter-hero">
            <p class="newsletter-label">
              Get notified about new releases (
              <a href={`${baseUrl}/blog/`}>latest release notes</a>)
            </p>
            <NewsletterSignup />
          </div>
        )
      }
    </div>
    <div class="hero-image">
      <button
        type="button"
        class="lightbox-trigger"
        data-label="A linear genome view of a somatic deletion at CUZD1"
        aria-label="Enlarge: JBrowse linear genome view screenshot"
      >
        <img
          src={`${baseUrl}/img/screenshot.webp`}
          width="1400"
          height="747"
          fetchpriority="high"
          alt="JBrowse linear genome view of human chr10 at CUZD1: NCBI RefSeq genes, a somatic structural-variant VCF calling a 1.8kb deletion over two exons, and a PacBio HiFi pileup with coverage where the reads carrying that deletion sort to the top as a dark block"
        />
      </button>
    </div>
  </div>
</div>

<div class="outer-box">
  <!-- Gallery preview -->

  <!-- Genome Hubs -->
  <section class="section-box">
    <h2 class="section-title">Ready-made genome browsers</h2>
    <div class="hubs-row">
      <div class="hubs-text">
        <ul class="hubs-list">
          <li>
            Full featured hg38, hg19, hs1, and mm39 genomes pre-loaded with UCSC
            Genome Browser tracks
          </li>
          <li>
            Thousands of plant, animal and microbial assemblies from UCSC
            GenArk/NCBI Genomes
          </li>
          <li>Customized portals to help launch comparative views</li>
        </ul>
        <div class="btn-row">
          <a
            class:list={[btn.btn, btn.btnSecondary]}
            href="https://genomes.jbrowse.org"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="mdi:open-in-new" width="20" height="20" />
            genomes.jbrowse.org
          </a>
        </div>
      </div>
      <div class="hubs-image">
        <button
          type="button"
          class="lightbox-trigger"
          data-label="JBrowse Desktop's Available genomes picker"
          aria-label="Enlarge: JBrowse Desktop available genomes picker"
        >
          <img
            src={`${baseUrl}/img/desktop-available-genomes.webp`}
            width="1400"
            height="763"
            loading="lazy"
            decoding="async"
            alt="JBrowse Desktop 'Available genomes' picker, a searchable list of human, mouse, and other assemblies each with a one-click launch link"
          />
        </button>
      </div>
    </div>
  </section>

  <!-- Resources -->
  <section class="section-box">
    <h2 class="section-title">Get started</h2>
    <div class="cards">
      <div class="card">
        <Icon
          class="card-icon"
          name="mdi:rocket-launch-outline"
          width="28"
          height="28"
        />
        <h3 class="card-title">Install &amp; run</h3>
        <p class="card-desc">Open your first genome.</p>
        <ul class="card-links">
          <li>
            <a href={`${baseUrl}/docs/quickstart_desktop/`}
              >Desktop quick start</a
            >
          </li>
          <li>
            <a href={`${baseUrl}/docs/quickstart_web/`}>Web quick start</a>
          </li>
        </ul>
      </div>
      <div class="card">
        <Icon
          class="card-icon"
          name="mdi:book-open-page-variant-outline"
          width="28"
          height="28"
        />
        <h3 class="card-title">Learn</h3>
        <p class="card-desc">Using, configuring and extending JBrowse.</p>
        <ul class="card-links">
          <li><a href={`${baseUrl}/docs/user_guide/`}>User guide</a></li>
          <li><a href={`${baseUrl}/docs/config_guide/`}>Config guide</a></li>
          <li>
            <a href={`${baseUrl}/docs/developer_guide/`}>Developer guide</a>
          </li>
          <li><a href={`${baseUrl}/docs/tutorials/`}>Tutorials</a></li>
          <li><a href={`${baseUrl}/features/`}>Feature overview</a></li>
        </ul>
      </div>
      <div class="card">
        <Icon class="card-icon" name="mdi:code-tags" width="28" height="28" />
        <h3 class="card-title">Build with it</h3>
        <p class="card-desc">Embed JBrowse and extend it with plugins.</p>
        <ul class="card-links">
          <li>
            <a href={`${baseUrl}/docs/tutorials/embed_linear_genome_view/`}
              >Embed a genome view</a
            >
          </li>
          <li>
            <a href={`${baseUrl}/docs/embedded_components/`}
              >Embedded components reference</a
            >
          </li>
          <li>
            <a href={`${baseUrl}/docs/developer_guides/simple_plugin/`}
              >Write a plugin</a
            >
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Citation -->
  <section class="section-box">
    <h2 class="section-title">Citation</h2>
    <p class="body-text">
      Citations are how the consortium demonstrates JBrowse's value when
      applying for funding. If you publish research using JBrowse, please cite:
    </p>
    <cite>
      Diesh <em>et al</em>, 2023. JBrowse 2: a modular genome browser with views
      of synteny and structural variation. Genome Biology 24:74.
      <a href="https://doi.org/10.1186/s13059-023-02914-z">
        https://doi.org/10.1186/s13059-023-02914-z
      </a>
    </cite>
  </section>

  <!-- Funding -->
  <section class="section-box">
    <h2 class="section-title">Funding and collaboration</h2>
    <p class="body-text">
      Supported by the US National Institutes of Health (U41 HG003751), the Chan
      Zuckerberg Initiative, the Ontario Institute for Cancer Research (OICR),
      and the University of California, Berkeley. Released under the <a
        href="https://www.apache.org/licenses/LICENSE-2.0"
        >Apache License, Version 2.0</a
      >.
    </p>
  </section>
</div>

<style>
  /* Vertical rhythm is `gap` only: every flex column below owns the spacing of
     its children, and no child carries a margin that would add to it. */
  .hero-title {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 400;
    line-height: 1.167;
    margin: 0;
  }
  .hero-subtitle,
  .section-title {
    font-size: clamp(1.4rem, 3.5vw, 2.125rem);
    font-weight: 400;
    line-height: 1.235;
    margin: 0;
  }
  .section-title {
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .body-text {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.5;
    margin: 0;
  }

  .outer-box {
    max-width: 1600px;
    margin: clamp(0.75rem, 4vw, 3rem) auto;
    padding-left: clamp(1rem, 4vw, 3rem);
    padding-right: clamp(1rem, 4vw, 3rem);
  }
  .section-box {
    margin-bottom: clamp(2rem, 5vw, 3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Hero and Genome Hubs are the same layout: a column of copy that becomes a
     half-width pair with its screenshot on a wide screen. */
  .hero-row,
  .hubs-row {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hero-row {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
  .hero-text,
  .hubs-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .hero-image img,
  .hubs-image img {
    border-radius: var(--card-radius);
    border: 1px solid var(--color-border);
    height: auto;
    width: 100%;
    display: block;
  }
  /* A desktop-app screenshot scaled to a phone width is unreadable, and it's
     only reinforcing the text beside it. */
  .hubs-image {
    display: none;
  }

  .newsletter-hero {
    text-align: center;
    padding: 20px 24px;
    border: 1px solid color-mix(in srgb, var(--color-primary) 20%, transparent);
    border-radius: var(--card-radius);
    background: color-mix(in srgb, var(--color-primary) 5%, white);
  }
  .newsletter-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 8px;
  }
  .hubs-list {
    margin: 0;
    padding-left: 1.2rem;
    line-height: 1.6;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 1rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    background: var(--color-surface);
  }
  .card:hover {
    border-color: var(--card-hover-border);
    box-shadow: var(--card-hover-shadow);
  }

  .card {
    gap: 0.5rem;
    padding: 1.25rem;
  }
  .card-icon {
    color: var(--color-primary);
  }
  .card-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0;
  }
  .card-desc {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    margin: 0;
  }
  .card-links {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Buttons stretch to share the row on phones, then size to content. */
  .btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .btn-row > * {
    flex: 1 1 auto;
    justify-content: center;
  }

  /* Declared here rather than undone in a `reduce` block, so the hover lift
     simply never exists for a reader who asked for less motion. */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition: 150ms ease;
      transition-property: border-color, box-shadow, transform;
    }
    .card:hover {
      transform: translateY(-2px);
    }
  }

  @media (min-width: 640px) {
    .btn-row > * {
      flex: 0 0 auto;
    }
    .hero-text .btn-row {
      justify-content: center;
    }
  }

  @media (min-width: 900px) {
    .hero-row,
    .hubs-row {
      flex-direction: row;
      align-items: center;
    }
    .hero-text,
    .hero-image,
    .hubs-text,
    .hubs-image {
      flex: 50%;
    }
    .hubs-image {
      display: block;
    }
  }
</style>
