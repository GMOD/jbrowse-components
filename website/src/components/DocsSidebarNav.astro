---
import { getCollection } from 'astro:content'

import SidebarItem from './SidebarItem.astro'
import { baseUrl } from '../lib/base-url.ts'
import { buildSiteSidebar } from '../lib/docs-sidebar.ts'

interface Props {
  currentSlug: string
}
const { currentSlug } = Astro.props

const allDocs = await getCollection('docs')
const sidebar = buildSiteSidebar(allDocs, baseUrl)
---

{
  /* A filter over the nav itself, not a search: 370-odd pages sit behind ten
     categories that are collapsed unless they hold the current page, so a
     reader who knows a page's name ("cookbook", "jexl", "BamAdapter") but not
     which category owns it had no way in short of opening every drawer.
     Filtering keeps the structure rather than flattening it — a matching
     category opens itself and keeps its heading, and the section heading above
     a surviving row survives with it, so a hit still reads as "MAF track" under
     "Track types" under "User guide". That is what tells apart the several
     pages the same feature has in different categories. Distinct from the
     header search, which is full-text over page bodies and leaves the page. */
}
<div class="sidebar-filter">
  <label class="sr-only" for="sidebar-filter-input">Filter documentation</label>
  <input
    id="sidebar-filter-input"
    type="search"
    placeholder="Filter pages..."
    autocomplete="off"
    spellcheck="false"
  />
</div>
<p
  class="sidebar-filter-empty"
  id="sidebar-filter-empty"
  aria-live="polite"
  hidden
>
  No page titles match. <a href={`${baseUrl}/search/`} id="sidebar-filter-all"
    >Search all docs</a
  >
</p>
<ul id="docs-sidebar-list">
  {sidebar.map(item => <SidebarItem item={item} currentSlug={currentSlug} />)}
</ul>

<script>
  const inputEl = document.getElementById('sidebar-filter-input')
  const listEl = document.getElementById('docs-sidebar-list')
  const emptyEl = document.getElementById('sidebar-filter-empty')
  const allEl = document.getElementById('sidebar-filter-all')

  if (
    inputEl instanceof HTMLInputElement &&
    listEl &&
    emptyEl &&
    allEl instanceof HTMLAnchorElement
  ) {
    const input = inputEl
    const list = listEl
    const empty = emptyEl
    const allLink = allEl
    const searchHref = allLink.href

    const groups = [...list.querySelectorAll('details')]

    // Which categories are open is otherwise derived entirely from the current
    // page (`open={containsSlug(...)}` in SidebarItem.astro), so a category a
    // reader opened to browse closes again the moment they click anything —
    // including anything inside it. Remembered per tab, by label.
    //
    // The current page's own category is deliberately never stored: it is
    // already open from the server on the page that needs it, and storing it
    // would leave it open on every later page, until enough browsing had
    // accumulated that every category was open and the memory said nothing.
    const OPEN_KEY = 'jbrowse-docs-sidebar-open'
    const labelOf = (details: HTMLDetailsElement) =>
      details.querySelector(':scope > summary')?.textContent?.trim() ?? ''
    const isCurrent = (details: HTMLDetailsElement) =>
      !!details.querySelector('[aria-current="page"]')

    let remembered: string[] = []
    try {
      remembered = JSON.parse(sessionStorage.getItem(OPEN_KEY) ?? '[]')
    } catch {
      // a malformed value is not worth breaking the nav over
    }
    if (Array.isArray(remembered)) {
      const open = new Set(remembered)
      for (const details of groups) {
        // only ever opens: the server already decided the current one, and
        // closing that would hide the page the reader is on
        details.open ||= open.has(labelOf(details))
      }
    }

    // Captured after the restore above, and before the first filter run, so
    // clearing the box restores the categories the reader had open (and the one
    // the current page opened) rather than collapsing everything.
    const wasOpen = new WeakMap<HTMLDetailsElement, boolean>()
    for (const details of groups) {
      wasOpen.set(details, details.open)
    }

    for (const details of groups) {
      details.addEventListener('toggle', () => {
        // Filtering opens every category holding a match, which is not the
        // reader saying they want it open. Clearing the box restores wasOpen
        // and re-fires this with the query empty, so their own state is what
        // ends up stored.
        if (input.value.trim()) {
          return
        }
        try {
          sessionStorage.setItem(
            OPEN_KEY,
            JSON.stringify(
              groups.filter(d => d.open && !isCurrent(d)).map(labelOf),
            ),
          )
        } catch {
          // private mode, or a full quota: the nav works, it just forgets
        }
      })
    }

    // Every token has to appear somewhere in the label, in any order, so both
    // "maf track" and "track maf" find "Track types: MAF track".
    function matches(text: string, tokens: string[]) {
      const haystack = text.toLowerCase()
      return tokens.every(token => haystack.includes(token))
    }

    // A page's section is no longer in its visible label — it is the heading row
    // above it — but it IS in the aria-label the same heading puts there
    // (SidebarItem.astro), so matching on that keeps "track types" finding the
    // pages under Track types rather than only the heading itself.
    function searchText(link: Element | null) {
      return link?.getAttribute('aria-label') ?? link?.textContent ?? ''
    }

    // Returns whether anything under `ul` survived. `forced` is set for the
    // children of a category whose own label matched, so filtering on
    // "tutorials" lists the tutorials instead of emptying the drawer that
    // matched.
    //
    // A heading row has no page of its own: it survives only if a page under it
    // did, which is why it is resolved one row late, when the next heading (or
    // the end of the list) says its run is over.
    function filterList(
      ul: Element,
      tokens: string[],
      forced: boolean,
    ): boolean {
      let anyVisible = false
      let heading: HTMLElement | undefined
      let headingKept = false
      for (const li of ul.children) {
        if (!(li instanceof HTMLElement)) {
          continue
        }
        if (li.classList.contains('sidebar-heading')) {
          if (heading) {
            heading.hidden = !headingKept
          }
          heading = li
          headingKept = false
          continue
        }
        const details = li.querySelector(':scope > details')
        let visible: boolean
        if (details instanceof HTMLDetailsElement) {
          const summary = details.querySelector(':scope > summary')
          const childUl = details.querySelector(':scope > ul')
          const self = forced || matches(summary?.textContent ?? '', tokens)
          const kept = childUl ? filterList(childUl, tokens, self) : false
          visible = self || kept
          details.open = visible
        } else {
          visible =
            forced ||
            matches(searchText(li.querySelector(':scope > a')), tokens)
        }
        li.hidden = !visible
        anyVisible ||= visible
        headingKept ||= visible
      }
      if (heading) {
        heading.hidden = !headingKept
      }
      return anyVisible
    }

    function reset() {
      for (const li of list.querySelectorAll('li')) {
        li.hidden = false
      }
      for (const details of groups) {
        details.open = wasOpen.get(details) ?? false
      }
      empty.hidden = true
    }

    function apply() {
      const query = input.value.trim()
      if (!query) {
        reset()
        return
      }
      const tokens = query.toLowerCase().split(/\s+/)
      empty.hidden = filterList(list, tokens, false)
      allLink.href = `${searchHref}?q=${encodeURIComponent(query)}`
    }

    input.addEventListener('input', apply)
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        input.value = ''
        reset()
      } else if (event.key === 'Enter') {
        event.preventDefault()
        // A filtered list is usually down to one obvious hit; Enter takes it
        // rather than making the reader move back to the mouse.
        for (const link of list.querySelectorAll(
          ':scope li:not([hidden]) > a',
        )) {
          if (link instanceof HTMLAnchorElement) {
            link.click()
            break
          }
        }
      }
    })
    // A restore from bfcache repopulates the input without firing `input`, so
    // reapply — otherwise the box shows a query the list no longer reflects.
    window.addEventListener('pageshow', apply)
  }
</script>

<style>
  /* Sticks to the top of the sidebar's own scrollport: an open category runs to
     116 rows, and a filter you have to scroll back up to reach is one you stop
     using. */
  .sidebar-filter {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.25rem 12px 0.5rem;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.5rem;
  }
  .sidebar-filter input {
    width: 100%;
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.8rem;
  }
  .sidebar-filter input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    background: #fff;
  }
  .sidebar-filter-empty {
    margin: 0 0 0.5rem;
    padding: 0 12px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
  /* The layout styles every sidebar link as a padded block row with a hanging
     indent (SidebarLayout.astro); this one is inline prose. */
  .sidebar-filter-empty a {
    display: inline;
    padding: 0;
    text-indent: 0;
    font-size: inherit;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
