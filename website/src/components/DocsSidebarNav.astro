---
import { getCollection } from 'astro:content'

import SidebarItem from './SidebarItem.astro'
import { baseUrl } from '../lib/base-url.ts'
import {
  buildSearchCategoryMap,
  buildSiteSidebar,
} from '../lib/docs-sidebar.ts'

interface Props {
  currentSlug: string
}
const { currentSlug } = Astro.props

const allDocs = await getCollection('docs')
const sidebar = buildSiteSidebar(allDocs, baseUrl)
const referenceSlugs = Object.entries(buildSearchCategoryMap(allDocs))
  .filter(([, category]) => category === 'autogen')
  .map(([slug]) => slug)
---

{/* A filter over the nav itself, not a search: 370-odd pages sit behind ten
     categories that are collapsed unless they hold the current page, so a
     reader who knows a page's name ("cookbook", "jexl", "BamAdapter") but not
     which category owns it had no way in short of opening every drawer.
     Filtering keeps the structure rather than flattening it — a matching
     category opens itself and keeps its heading, and the section heading above
     a surviving row survives with it, so a hit still reads as "MAF track" under
     "Track types" under "User guide". That is what tells apart the several
     pages the same feature has in different categories. Pages that only
     mention the words follow the title matches under "In page text", from the
     header search's pagefind index. */}
<div class="sidebar-filter">
  <label class="sr-only" for="sidebar-filter-input">
    Search documentation
  </label>
  <input
    id="sidebar-filter-input"
    type="search"
    placeholder="Search docs..."
    autocomplete="off"
    spellcheck="false"
  />
</div>
<ul id="docs-sidebar-list">
  {sidebar.map(item => (
    <SidebarItem item={item} currentSlug={currentSlug} />
  ))}
</ul>
<p class="sr-only" id="sidebar-filter-status" aria-live="polite"></p>
<div
  class="sidebar-filter-text"
  id="sidebar-filter-text"
  data-base={baseUrl}
  data-reference={JSON.stringify(referenceSlugs)}
  hidden
>
  <p class="sidebar-filter-text-heading" id="sidebar-filter-text-heading">
    In page text
  </p>
  <ul id="sidebar-filter-text-list"></ul>
  <a href={`${baseUrl}/search/`} id="sidebar-filter-all">
    All results
  </a>
</div>

<script>
  const inputEl = document.getElementById('sidebar-filter-input')
  const listEl = document.getElementById('docs-sidebar-list')
  const textEl = document.getElementById('sidebar-filter-text')
  const textHeadingEl = document.getElementById('sidebar-filter-text-heading')
  const textListEl = document.getElementById('sidebar-filter-text-list')
  const allEl = document.getElementById('sidebar-filter-all')
  const statusEl = document.getElementById('sidebar-filter-status')

  interface PagefindHit {
    url: string
    meta?: { title?: string }
  }
  interface Pagefind {
    search: (
      query: string,
    ) => Promise<{ results: { data: () => Promise<PagefindHit> }[] }>
  }

  if (
    inputEl instanceof HTMLInputElement &&
    listEl &&
    textEl &&
    textHeadingEl &&
    textListEl &&
    allEl instanceof HTMLAnchorElement &&
    statusEl
  ) {
    const input = inputEl
    const list = listEl
    const textSection = textEl
    const textHeading = textHeadingEl
    const textList = textListEl
    const allLink = allEl
    const searchHref = allLink.href
    const status = statusEl
    const base = textSection.dataset.base ?? ''
    const referenceSlugs = new Set<string>(
      JSON.parse(textSection.dataset.reference ?? '[]'),
    )
    const TEXT_HITS = 6
    // as the header search: generated reference pages would otherwise take
    // every row for a common word ("color by" ranks 15 of them first)
    const REFERENCE_SLOTS = 3
    const WINDOW = 24

    const groups = [...list.querySelectorAll('details')]

    // Which categories are open is otherwise derived entirely from the current
    // page (`open={containsSlug(...)}` in SidebarItem.astro), so a category a
    // reader opened to browse closes again the moment they click anything —
    // including anything inside it. Remembered per tab, by label.
    //
    // The current page's own category is deliberately never stored: it is
    // already open from the server on the page that needs it, and storing it
    // would leave it open on every later page, until enough browsing had
    // accumulated that every category was open and the memory said nothing.
    const OPEN_KEY = 'jbrowse-docs-sidebar-open'
    const labelOf = (details: HTMLDetailsElement) =>
      details.querySelector(':scope > summary')?.textContent?.trim() ?? ''
    const isCurrent = (details: HTMLDetailsElement) =>
      !!details.querySelector('[aria-current="page"]')

    let remembered: string[] = []
    try {
      remembered = JSON.parse(sessionStorage.getItem(OPEN_KEY) ?? '[]')
    } catch {
      // a malformed value is not worth breaking the nav over
    }
    if (Array.isArray(remembered)) {
      const open = new Set(remembered)
      for (const details of groups) {
        // only ever opens: the server already decided the current one, and
        // closing that would hide the page the reader is on
        details.open ||= open.has(labelOf(details))
      }
    }

    // Captured after the restore above, and before the first filter run, so
    // clearing the box restores the categories the reader had open (and the one
    // the current page opened) rather than collapsing everything.
    const wasOpen = new WeakMap<HTMLDetailsElement, boolean>()
    for (const details of groups) {
      wasOpen.set(details, details.open)
    }

    for (const details of groups) {
      details.addEventListener('toggle', () => {
        // Filtering opens every category holding a match, which is not the
        // reader saying they want it open. Clearing the box restores wasOpen
        // and re-fires this with the query empty, so their own state is what
        // ends up stored.
        if (input.value.trim()) {
          return
        }
        try {
          sessionStorage.setItem(
            OPEN_KEY,
            JSON.stringify(
              groups.filter(d => d.open && !isCurrent(d)).map(labelOf),
            ),
          )
        } catch {
          // private mode, or a full quota: the nav works, it just forgets
        }
      })
    }

    // Every token has to appear somewhere in the label, in any order, so both
    // "maf track" and "track maf" find "Track types: MAF track".
    function matches(text: string, tokens: string[]) {
      const haystack = text.toLowerCase()
      return tokens.every(token => haystack.includes(token))
    }

    // A page's section is no longer in its visible label — it is the heading row
    // above it — but it IS in the aria-label the same heading puts there
    // (SidebarItem.astro), so matching on that keeps "track types" finding the
    // pages under Track types rather than only the heading itself.
    function searchText(link: Element | null) {
      return link?.getAttribute('aria-label') ?? link?.textContent ?? ''
    }

    // Returns whether anything under `ul` survived. `forced` is set for the
    // children of a category whose own label matched, so filtering on
    // "tutorials" lists the tutorials instead of emptying the drawer that
    // matched.
    //
    // A heading row has no page of its own: it survives only if a page under it
    // did, which is why it is resolved one row late, when the next heading (or
    // the end of the list) says its run is over.
    function filterList(
      ul: Element,
      tokens: string[],
      forced: boolean,
    ): boolean {
      let anyVisible = false
      let heading: HTMLElement | undefined
      let headingKept = false
      for (const li of ul.children) {
        if (!(li instanceof HTMLElement)) {
          continue
        }
        if (li.classList.contains('sidebar-heading')) {
          if (heading) {
            heading.hidden = !headingKept
          }
          heading = li
          headingKept = false
          continue
        }
        const details = li.querySelector(':scope > details')
        let visible: boolean
        if (details instanceof HTMLDetailsElement) {
          const summary = details.querySelector(':scope > summary')
          const childUl = details.querySelector(':scope > ul')
          const self = forced || matches(summary?.textContent ?? '', tokens)
          const kept = childUl ? filterList(childUl, tokens, self) : false
          visible = self || kept
          details.open = visible
        } else {
          visible =
            forced ||
            matches(searchText(li.querySelector(':scope > a')), tokens)
        }
        li.hidden = !visible
        anyVisible ||= visible
        headingKept ||= visible
      }
      if (heading) {
        heading.hidden = !headingKept
      }
      return anyVisible
    }

    let pagefind: Pagefind | null | undefined
    let debounce: ReturnType<typeof setTimeout> | undefined

    async function getPagefind() {
      if (pagefind === undefined) {
        try {
          pagefind = await import(
            /* @vite-ignore */ `${base}/pagefind/pagefind.js`
          )
        } catch {
          pagefind = null
        }
      }
      return pagefind
    }

    function pathOf(url: string) {
      return new URL(url, location.href).pathname.replace(/\/$/, '')
    }

    // Several pages share a title across categories ("Quantitative track" is
    // both a user guide and a config guide), so a hit names its drawers.
    function categoriesOf(link: Element) {
      const names: string[] = []
      for (
        let details = link.closest('details');
        details;
        details = details.parentElement?.closest('details') ?? null
      ) {
        names.unshift(
          details.querySelector(':scope > summary')?.textContent?.trim() ?? '',
        )
      }
      return names.join(' › ')
    }

    function isReference(path: string) {
      const prefix = `${base}/docs/`
      return (
        path.startsWith(prefix) && referenceSlugs.has(path.slice(prefix.length))
      )
    }

    function categoryOf(path: string) {
      return (
        categoryByPath.get(path) ??
        (path.startsWith(`${base}/blog/`) ? 'Blog' : '')
      )
    }

    let shownQuery = ''

    const categoryByPath = new Map(
      [...list.querySelectorAll('a')].map(link => [
        pathOf(link.href),
        categoriesOf(link),
      ]),
    )

    function showTextHits(
      query: string,
      hits: PagefindHit[],
      titleCount: number,
      searched: boolean,
    ) {
      textList.replaceChildren(
        ...hits.map(hit => {
          const li = document.createElement('li')
          const a = document.createElement('a')
          const title = document.createElement('span')
          const category = document.createElement('span')
          a.href = hit.url
          title.textContent = hit.meta?.title ?? pathOf(hit.url)
          category.className = 'sidebar-filter-text-category'
          category.textContent = categoryOf(pathOf(hit.url))
          a.append(title, category)
          li.append(a)
          return li
        }),
      )
      textHeading.textContent = hits.length
        ? 'In page text'
        : searched && !titleCount
          ? 'No matches'
          : ''
      textHeading.hidden = !textHeading.textContent
      textSection.hidden = false
      shownQuery = query
      status.textContent = `Title matches: ${titleCount}. In page text: ${hits.length}. Enter opens the first.`
    }

    function visibleTitleLinks() {
      return [...list.querySelectorAll('li:not([hidden]) > a')].filter(
        link => link instanceof HTMLAnchorElement,
      )
    }

    async function runTextSearch(query: string) {
      const pf = await getPagefind()
      const titled = new Set(visibleTitleLinks().map(link => pathOf(link.href)))
      const { results } = pf ? await pf.search(query) : { results: [] }
      const fetched = await Promise.all(
        results.slice(0, WINDOW).map(result => result.data()),
      )
      const hits: PagefindHit[] = []
      let reference = 0
      for (const hit of fetched) {
        const path = pathOf(hit.url)
        const overQuota = isReference(path) && reference === REFERENCE_SLOTS
        if (!titled.has(path) && !overQuota && hits.length < TEXT_HITS) {
          hits.push(hit)
          reference += isReference(path) ? 1 : 0
        }
      }
      if (input.value.trim() === query) {
        showTextHits(query, hits, titled.size, !!pf)
      }
    }

    function reset() {
      clearTimeout(debounce)
      for (const li of list.querySelectorAll('li')) {
        li.hidden = false
      }
      for (const details of groups) {
        details.open = wasOpen.get(details) ?? false
      }
      textSection.hidden = true
      textList.replaceChildren()
      shownQuery = ''
      status.textContent = ''
    }

    function apply() {
      const query = input.value.trim()
      if (!query) {
        reset()
        return
      }
      const tokens = query.toLowerCase().split(/\s+/)
      filterList(list, tokens, false)
      allLink.href = `${searchHref}?q=${encodeURIComponent(query)}`
      clearTimeout(debounce)
      debounce = setTimeout(() => runTextSearch(query), 150)
    }

    input.addEventListener('input', apply)
    input.addEventListener('keydown', event => {
      if (event.key === 'Escape') {
        input.value = ''
        reset()
      } else if (event.key === 'Enter') {
        event.preventDefault()
        // A filtered list is usually down to one obvious hit; Enter takes it
        // rather than making the reader move back to the mouse, falling back
        // to the first page-text hit when no title matched.
        const textHit =
          shownQuery === input.value.trim() ? textList.querySelector('a') : null
        const first = visibleTitleLinks()[0] ?? textHit
        if (first instanceof HTMLAnchorElement) {
          first.click()
        }
      }
    })
    // A restore from bfcache repopulates the input without firing `input`, so
    // reapply — otherwise the box shows a query the list no longer reflects.
    window.addEventListener('pageshow', apply)
  }
</script>

<style>
  /* Sticks to the top of the sidebar's own scrollport: an open category runs to
     116 rows, and a filter you have to scroll back up to reach is one you stop
     using. */
  .sidebar-filter {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 0.25rem 12px 0.5rem;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.5rem;
  }
  .sidebar-filter input {
    width: 100%;
    padding: 5px 8px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-size: 0.8rem;
  }
  .sidebar-filter input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: -1px;
    background: #fff;
  }
  .sidebar-filter-text {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--color-border);
  }
  .sidebar-filter-text ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Built by the script, so outside the scoped-style attribute. */
  .sidebar-filter-text :global(.sidebar-filter-text-category) {
    display: block;
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }
  .sidebar-filter-text :global(.sidebar-filter-text-category:empty) {
    display: none;
  }
  .sidebar-filter-text-heading {
    margin: 0 0 0.25rem;
    padding: 0 12px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  /* The layout styles every sidebar link as a padded block row
     (SidebarLayout.astro); the footer link reads as an action. */
  .sidebar-filter-text #sidebar-filter-all {
    font-size: 0.8rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
