---
import { Icon } from 'astro-icon/components'

import { currentVersion } from '../config.ts'
import BaseLayout from '../layouts/BaseLayout.astro'
import { baseUrl } from '../lib/base-url.ts'
import btn from '../styles/button.module.css'
import page from '../styles/page.module.css'
const releases = 'https://github.com/GMOD/jbrowse-components/releases'
const releaseNotes = `${releases}/tag/${currentVersion}`
const assetBase = `${releases}/download/${currentVersion}`
const webZip = `${assetBase}/jbrowse-web-${currentVersion}.zip`
const examplesBase = 'https://jbrowse.org/storybook'

const desktopDownloads = [
  {
    os: 'macOS',
    detail: 'Apple silicon and Intel',
    suffix: 'mac.dmg',
    icon: 'mdi:apple',
  },
  {
    os: 'Windows',
    detail: '64-bit installer',
    suffix: 'win.exe',
    icon: 'mdi:microsoft-windows',
  },
  {
    os: 'Linux',
    detail: '64-bit AppImage',
    suffix: 'linux.AppImage',
    icon: 'mdi:linux',
  },
]

const embeddedComponents = [
  {
    pkg: '@jbrowse/react-app2',
    what: 'the full JBrowse app',
    examples: 'app',
  },
  {
    pkg: '@jbrowse/react-linear-genome-view2',
    what: 'a linear genome view',
    examples: 'lgv',
  },
  {
    pkg: '@jbrowse/react-circular-genome-view2',
    what: 'a circular genome view',
    examples: 'cgv',
  },
]
---

<BaseLayout
  title="Download JBrowse"
  description="Download JBrowse Desktop or JBrowse Web, install the JBrowse CLI tools, or embed JBrowse as a React component, Jupyter widget, or R/Shiny widget."
>
  <div class={page.content}>
    <h1>Download JBrowse</h1>
    <p class="release">
      Current release {currentVersion} ·{' '}
      <a href={releaseNotes}>release notes</a>
    </p>

    <h2>JBrowse Desktop</h2>
    <p>
      An app for your own computer. It opens files on your disk as well as
      remote data, and updates itself when a new release is out.
    </p>
    <div class="download-cards">
      {desktopDownloads.map(({ os, detail, suffix, icon }) => (
        <div class="download-card">
          <Icon name={icon} width="40" height="40" />
          <h3>{os}</h3>
          <span class="caption">{detail}</span>
          <a
            class:list={[btn.btn, btn.btnPrimary, btn.btnSmall]}
            href={`${assetBase}/jbrowse-desktop-${currentVersion}-${suffix}`}
          >
            Download
          </a>
        </div>
      ))}
    </div>
    <p>
      Then follow the{' '}
      <a href={`${baseUrl}/docs/quickstart_desktop/`}>desktop quick start</a>.
      On Linux, <code>chmod a+x</code> the AppImage before running it.
    </p>
    <p class="caption">
      Windows builds are signed through{' '}
      <a href="https://about.signpath.io">SignPath.io</a> with a certificate
      from the <a href="https://signpath.org">SignPath Foundation</a>, and macOS
      builds are notarized by Apple. See the{' '}
      <a href={`${baseUrl}/code-signing-policy/`}>code signing policy</a>, or{' '}
      <a href={releases}>all releases</a> for older versions.
    </p>

    <h2 id="jbrowse-web">JBrowse Web</h2>
    <p>
      A genome browser you host on your own web server for others to open. It is
      a folder of static files, and the JBrowse CLI creates it and adds
      assemblies and tracks to its config:
    </p>
    <pre><code>npm install -g @jbrowse/cli
jbrowse create jbrowse2</code></pre>
    <p>
      Then follow the{' '}
      <a href={`${baseUrl}/docs/quickstart_web/`}>web quick start</a>. To skip
      the CLI, <a href={webZip}>download the JBrowse Web zip</a> directly.
    </p>

    <h2>Static image generator</h2>
    <p>
      <a href={`${baseUrl}/docs/jbrowse-img/`}>@jbrowse/img</a> renders JBrowse
      views to images from the command line, with no browser:
    </p>
    <pre><code>npm install -g @jbrowse/img</code></pre>

    <h2>Embedded components</h2>
    <p>React components on NPM that put a JBrowse view in your own web app:</p>
    <ul>
      {embeddedComponents.map(({ pkg, what, examples }) => (
        <li>
          <a href={`https://www.npmjs.com/package/${pkg}`}>{pkg}</a>, {what}.
          <a href={`${examplesBase}/${examples}/`}>Live examples</a>
        </li>
      ))}
    </ul>
    <p>
      The <a href={`${baseUrl}/docs/embedded_components/`}>embedded docs</a>{' '}
      have examples for Vite, Next.js and plain JavaScript.
    </p>

    <h2>Python and R</h2>
    <ul>
      <li>
        Python, as a Jupyter widget:{' '}
        <a href={`${baseUrl}/docs/jbrowse_anywidget/`}>documentation</a>,{' '}
        <a href="https://github.com/GMOD/jbrowse-anywidget">source code</a>
      </li>
      <li>
        R and Shiny, with the{' '}
        <a href="https://gmod.github.io/JBrowseR/">JBrowseR</a> package on CRAN:{' '}
        <a href={`${baseUrl}/docs/jbrowser/`}>documentation</a>
      </li>
    </ul>
  </div>
</BaseLayout>

<style>
  .release {
    color: var(--color-text-muted);
    margin-top: -0.5rem;
  }
  .download-cards {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 1.5rem 0;
  }
  .download-card {
    background: var(--color-surface);
    border-radius: 8px;
    padding: 1.5rem;
    text-align: center;
    min-width: 160px;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .download-card h3 {
    margin: 0;
  }
  .caption {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  pre {
    background: var(--color-surface);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }
</style>
