---
import { getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import { baseUrl } from '../lib/base-url.ts'
import { buildSearchCategoryMap } from '../lib/docs-sidebar.ts'
import page from '../styles/page.module.css'
import styles from '../styles/search.module.css'

const searchCategories = buildSearchCategoryMap(await getCollection('docs'))

// The filterable buckets, in the order they are offered and ranked. One list
// rather than three: the checkboxes, the enabled-set and the sort priority were
// each written out per category, so adding a bucket (or renaming one, as the
// 2026-07 reorg did) meant three edits that nothing tied together. 'other' is
// deliberately absent — it is the always-shown fallthrough, so it has no
// checkbox and sorts last (see renderResults).
const FILTERS = [
  { id: 'user', label: 'User guides' },
  { id: 'config', label: 'Config guides' },
  { id: 'developer', label: 'Developer guides' },
  { id: 'autogen', label: 'Reference (config schema, state models)' },
]
---

<BaseLayout
  title="Search — JBrowse"
  description="Search JBrowse documentation, user guides, config reference, and API docs."
>
  <div class={page.content}>
    <h1 class={styles.heading}>Search</h1>
    <div class={styles.inputWrap}>
      <input
        id="search-input"
        type="search"
        placeholder="Search docs..."
        autocomplete="off"
        autofocus
        class={styles.input}
      />
      <span class={styles.count} id="search-count"></span>
    </div>
    <div class={styles.filters}>
      {
        FILTERS.map(filter => (
          <label class={styles.filterLabel}>
            <input
              type="checkbox"
              id={`filter-${filter.id}`}
              data-category={filter.id}
              checked
            />{' '}
            {filter.label}
          </label>
        ))
      }
    </div>
    <ul id="search-results" class={styles.results}></ul>
  </div>
</BaseLayout>

<script is:inline define:vars={{ baseUrl, searchCategories, FILTERS }}>
  const input = document.getElementById('search-input')
  const countEl = document.getElementById('search-count')
  const resultsList = document.getElementById('search-results')
  const checkboxes = [
    ...document.querySelectorAll('input[type="checkbox"][data-category]'),
  ]

  let pagefind
  let debounce
  let lastResults = []

  // Rank is the offered order, with the unfilterable 'other' bucket after every
  // named one. Read off FILTERS so it cannot disagree with the checkboxes.
  const CATEGORY_PRIORITY = Object.fromEntries([
    ...FILTERS.map((filter, i) => [filter.id, i]),
    ['other', FILTERS.length],
  ])

  // searchCategories is generated from sidebars.json (buildSearchCategoryMap
  // in docs-sidebar.ts) so this stays in sync with the actual sidebar
  // placement instead of hand-listing slugs here.
  function getCategory(url) {
    const path = new URL(url, location.href).pathname
    const match = path.match(/\/docs\/(.*)/)
    if (!match) {
      return 'other'
    }
    const slug = match[1].replace(/\/$/, '')
    return searchCategories[slug] ?? 'other'
  }

  function renderResults() {
    // 'other' is never filtered out — it is where a page with no bucket lands,
    // so no checkbox may hide it.
    const enabled = new Set(['other'])
    for (const checkbox of checkboxes) {
      if (checkbox.checked) {
        enabled.add(checkbox.dataset.category)
      }
    }

    const visible = lastResults.filter(item => enabled.has(item.category))
    countEl.textContent = `${visible.length} result${visible.length === 1 ? '' : 's'}`
    resultsList.innerHTML = visible
      .map(item => {
        const path = new URL(item.url, location.href).pathname
        return `<li class="search-result">
          <a href="${item.url}">
            <div class="search-title">${item.meta?.title ?? path}</div>
            <div class="search-path">${path}</div>
            <div class="search-excerpt">${item.excerpt}</div>
          </a>
        </li>`
      })
      .join('')
  }

  async function getPagefind() {
    if (!pagefind) {
      pagefind = await import(`${baseUrl}/pagefind/pagefind.js`)
    }
    return pagefind
  }

  function syncUrl(q) {
    const url = new URL(location.href)
    if (q) {
      url.searchParams.set('q', q)
    } else {
      url.searchParams.delete('q')
    }
    history.replaceState({}, '', url)
  }

  async function runSearch(query) {
    syncUrl(query)
    if (!query.trim()) {
      lastResults = []
      resultsList.replaceChildren()
      countEl.textContent = ''
      return
    }
    const pf = await getPagefind()
    const { results: found } = await pf.search(query)
    const items = await Promise.all(found.slice(0, 40).map(r => r.data()))
    if (input.value !== query) {
      return // a newer keystroke already superseded this search (as SearchBox.astro)
    }
    lastResults = items
      .map(item => ({ ...item, category: getCategory(item.url) }))
      .sort(
        (a, b) => CATEGORY_PRIORITY[a.category] - CATEGORY_PRIORITY[b.category],
      )
    renderResults()
  }

  for (const checkbox of checkboxes) {
    checkbox.addEventListener('change', renderResults)
  }

  input.addEventListener('input', () => {
    clearTimeout(debounce)
    debounce = setTimeout(() => runSearch(input.value), 200)
  })

  // the page is statically prerendered, so ?q= can only be read at runtime
  const initialQuery = new URL(location.href).searchParams.get('q') ?? ''
  if (initialQuery) {
    input.value = initialQuery
    runSearch(initialQuery)
  }
</script>

<style is:global>
  .search-result a {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 14px 0;
    border-bottom: 1px solid var(--color-border);
  }
  .search-result a:hover .search-title {
    text-decoration: underline;
  }
  .search-title {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    margin-bottom: 2px;
  }
  .search-path {
    font-size: 0.78rem;
    color: var(--color-accent);
    margin-bottom: 6px;
  }
  .search-excerpt {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .search-excerpt mark {
    background: var(--color-highlight-bg);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
    font-weight: 600;
  }
</style>
