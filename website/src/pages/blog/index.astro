---
import { getCollection } from 'astro:content'

import BlogLayout from '../../layouts/BlogLayout.astro'
import { baseUrl } from '../../lib/base-url.ts'
import { blogPath, formatBlogDate } from '../../lib/blog-path.ts'
import { blogFeed } from '../../lib/blog-summary.ts'

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)

const items = posts.map(post => ({
  id: post.id,
  body: post.body ?? '',
  title: post.data.title,
  date: post.data.date,
  description: post.data.description,
  href: `${baseUrl}/blog/${blogPath(post)}/`,
}))
const latest = items[0]!
const years = blogFeed(items)

function withBase(src: string) {
  return src.startsWith('/') && !src.startsWith('//') ? `${baseUrl}${src}` : src
}

function version(post: { title: string }) {
  return post.title.replace(/ Release$/, '')
}

function day(date: Date) {
  return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })
}
---

<BlogLayout
  title="JBrowse Blog"
  description="Release announcements and news from the JBrowse project."
>
  <div class="content">
    <h1>Blog</h1>
    <p class="latest">
      Latest release: <a href={latest.href}>{latest.title}</a>,
      {formatBlogDate(latest.date)}
    </p>
    {years.map(({ year, featured, others }) => (
      <section>
        <h2 class="year">{year}</h2>
        {featured.map(post => (
          <article class="post">
            <div class="text">
              <h3>
                <a href={post.href}>{post.title}</a>
              </h3>
              <time datetime={post.date.toISOString()}>{day(post.date)}</time>
              {post.lede && <p class="lede">{post.lede}</p>}
            </div>
            {post.image && (
              <a
                class="thumb"
                href={post.href}
                tabindex="-1"
                aria-hidden="true"
              >
                <img
                  src={withBase(post.image.src)}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </a>
            )}
          </article>
        ))}
        {others.length > 0 && (
          <p class="others">
            {featured.length > 0 ? 'Other releases' : 'Releases'}:
            <span class="other-list">
              {others.map(post => (
                <a href={post.href} title={post.lede}>
                  {version(post)}
                </a>
              ))}
            </span>
          </p>
        )}
      </section>
    ))}
  </div>
</BlogLayout>

<style>
  .content {
    max-width: 800px;
    margin: 0 auto;
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-text);
  }
  .latest {
    margin: 0.4rem 0 0;
    color: var(--color-text-muted);
  }
  a {
    color: var(--color-accent);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
  .year {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 2.5rem 0 0.5rem;
  }
  .post {
    display: grid;
    grid-template-columns: 1fr 144px;
    gap: 1.5rem;
    align-items: start;
    padding: 1rem 0;
  }
  .text {
    grid-column: 1;
  }
  h3 {
    display: inline;
    font-size: 1.15rem;
    font-weight: 500;
    margin: 0;
  }
  time {
    margin-left: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .lede {
    margin: 0.3rem 0 0;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .thumb {
    grid-column: 2;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .others {
    margin: 0.75rem 0 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
  .other-list {
    display: inline-flex;
    flex-wrap: wrap;
    column-gap: 0.4em;
  }
  .other-list a {
    display: inline-flex;
  }
  .other-list a:not(:last-child)::after {
    content: ',';
    color: var(--color-text-muted);
  }
  @media (max-width: 560px) {
    .post {
      grid-template-columns: 1fr 96px;
      gap: 1rem;
    }
    .lede {
      -webkit-line-clamp: 4;
    }
  }
</style>
