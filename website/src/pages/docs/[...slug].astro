---
import { getCollection } from 'astro:content'

import DocsLayout from '../../layouts/DocsLayout.astro'
import { entrySlug } from '../../lib/docs-sidebar.ts'
import { renderDoc } from '../../lib/markdown-pool.ts'

export async function getStaticPaths() {
  const docs = await getCollection('docs')
  return docs.map(entry => {
    const slug = entrySlug(entry.id) || undefined
    return { params: { slug }, props: { entry } }
  })
}

const { entry } = Astro.props
const currentSlug = Astro.params.slug ?? ''
const { html, toc, videos } = await renderDoc(entry.id, entry.body ?? '')
---

<DocsLayout
  title={entry.data.title}
  currentSlug={currentSlug}
  description={entry.data.description}
  toc={toc}
  videos={videos}
  rawMarkdown={entry.body ?? ''}
>
  <Fragment set:html={html} />
</DocsLayout>
