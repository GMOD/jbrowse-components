---
import { getCollection } from 'astro:content'

import DocsLayout from '../../../layouts/DocsLayout.astro'
import { baseUrl } from '../../../lib/base-url.ts'
import { entrySlug } from '../../../lib/docs-sidebar.ts'
import {
  TUTORIAL_CATEGORIES,
  TUTORIAL_DATA_COSTS,
  TUTORIAL_FALLBACK,
  TUTORIAL_NO_THUMB,
  TUTORIAL_ORDER,
} from '../../../lib/guide-categories.ts'

// Section order for the landing page. A tutorial declares its section via the
// `tutorial_category` frontmatter field; anything missing or unlisted falls
// into a trailing "More tutorials" bucket, so a new tutorial always appears
// even before it is categorized. The order is shared with the user guide index
// (scripts/generate-guide-indexes.ts) so the two groupings can't drift.
const CATEGORY_ORDER = new Set(TUTORIAL_CATEGORIES)
const FALLBACK = TUTORIAL_FALLBACK

// Some docs live outside tutorials/ but belong on this landing page: the
// quickstarts are, in practice, the first tutorials a new user follows, and the
// cookbook is a natural companion to the configuration walkthroughs. Map each to
// the section it should appear in.
const EXTRA_DOCS = new Map([
  ['quickstart_web', 'Getting started'],
  ['quickstart_desktop', 'Getting started'],
  ['cookbook', 'Configuration & embedding'],
])

// Curated order within each section, shared with the user guide index. The
// hosted-site pages lead, Getting started is the two quickstarts; the domain
// analysis sections follow; and the more advanced, developer/admin-oriented
// configuration work (display defaults, embedding, CLI-config walkthroughs)
// sits last in its own Configuration & embedding section.
const ORDER = TUTORIAL_ORDER
const rank = (key: string) => {
  const i = ORDER.indexOf(key)
  return i === -1 ? ORDER.length : i
}

// A doc id ("tutorials/rnaseq", "quickstart_web") maps to a thumbnail at
// static/img/tutorial-thumbs/<key>.webp illustrating what the page produces. A
// page with no thumbnail (e.g. the text-only CLI walkthrough) renders a compact
// chromeless card instead.
const key = (id: string) =>
  id.startsWith('tutorials/') ? id.slice('tutorials/'.length) : id

const docs = await getCollection('docs')
const cardFrom = (entry: (typeof docs)[number], category: string) => ({
  key: key(entry.id),
  href: `${baseUrl}/docs/${entrySlug(entry.id)}/`,
  title: entry.data.title,
  description: entry.data.description,
  category,
  cost: entry.data.data,
  // A page carrying a video tutorial says so in the grid. The videos are the one
  // thing on these pages a reader might come looking for and cannot find by
  // reading: 14 of them sit inside 9 tutorials, and a still and a clip look the
  // same in a search result. Read off the page's own `<Video>` rather than
  // declared in frontmatter, so adding one to a page is the whole of the work.
  hasVideo: /<Video\s/.test(entry.body ?? ''),
  external: false,
})

// Live example sites linked straight from the section, so readers who want to
// embed can jump to runnable examples rather than only the prose tutorial. Its
// thumbnail is a capture of the examples site itself.
const EXTERNAL_CARDS = [
  {
    key: 'embedding_examples',
    href: 'https://jbrowse.org/storybook/lgv/',
    title: 'Embedded component examples',
    description:
      'Live, copy-paste examples for the embeddable React components: themes, per-feature colors, sessions, text search, and more.',
    category: 'Configuration & embedding',
    cost: undefined as string | undefined,
    hasVideo: false,
    external: true,
  },
]

const tutorials = [
  ...docs
    .filter(entry => EXTRA_DOCS.has(entry.id))
    .map(entry => cardFrom(entry, EXTRA_DOCS.get(entry.id)!)),
  ...docs
    .filter(entry => entry.id.startsWith('tutorials/'))
    .map(entry => cardFrom(entry, entry.data.tutorial_category ?? FALLBACK)),
  ...EXTERNAL_CARDS,
].sort((a, b) => rank(a.key) - rank(b.key) || a.title.localeCompare(b.title))

// A mistyped tutorial_category isn't a visible typo — it silently drops the page
// into the FALLBACK bucket. Fail the build instead so the frontmatter and
// CATEGORY_ORDER can't drift apart. Tutorials with no category are fine; they
// intentionally fall through to FALLBACK.
const miscategorized = docs
  .filter(entry => entry.id.startsWith('tutorials/'))
  .filter(
    entry =>
      entry.data.tutorial_category &&
      !CATEGORY_ORDER.has(entry.data.tutorial_category),
  )
  .map(entry => `${entry.id}: "${entry.data.tutorial_category}"`)
if (miscategorized.length > 0) {
  throw new Error(
    `Unknown tutorial_category (add it to CATEGORY_ORDER or fix the typo):\n  ${miscategorized.join('\n  ')}`,
  )
}

// Same reasoning as the category check above, and it matters more here: an
// unknown `data` value renders no chip at all, which is indistinguishable from
// a page that deliberately has none. A typo would quietly demote a page to
// "cost unstated" rather than show a wrong badge.
// Every doc that sets the field, not just tutorials/: the quickstarts carry one
// too, and a typo on those would escape a tutorials-only check.
const miscosted = docs
  .filter(entry => entry.data.data && !(entry.data.data in TUTORIAL_DATA_COSTS))
  .map(entry => `${entry.id}: "${entry.data.data}"`)
if (miscosted.length > 0) {
  throw new Error(
    `Unknown data cost (add it to TUTORIAL_DATA_COSTS or fix the typo):\n  ${miscosted.join('\n  ')}`,
  )
}

const grouped = [...CATEGORY_ORDER, FALLBACK]
  .map(category => ({
    category,
    items: tutorials.filter(t =>
      CATEGORY_ORDER.has(t.category)
        ? t.category === category
        : category === FALLBACK,
    ),
  }))
  .filter(group => group.items.length > 0)

// Pages with no generated thumbnail render a compact chromeless card instead of
// a broken image; see TUTORIAL_NO_THUMB for which and why. gen-tutorial-thumbs
// reads the same set, so a card here always has a webp to ask for.
const HAS_THUMB = new Set(
  tutorials.map(t => t.key).filter(k => !TUTORIAL_NO_THUMB.has(k)),
)
---

<DocsLayout
  title="Tutorials"
  currentSlug="tutorials"
  description="Step-by-step, data-driven walkthroughs of common JBrowse workflows."
>
  <p class="lead">
    Hands-on walkthroughs of common JBrowse workflows, from first setup to
    advanced analysis. The first section runs on
    <a href="https://genomes.jbrowse.org" target="_blank" rel="noopener"
      >genomes.jbrowse.org</a
    >, which hosts a configured JBrowse for every UCSC genome, so those pages
    need nothing installed and no data prepared.
  </p>
  {
    grouped.map(group => (
      <section class="tut-section">
        <h2 class="tut-heading">{group.category}</h2>
        <div class="tut-grid">
          {group.items.map(tutorial => (
            <a
              class="tut-card"
              href={tutorial.href}
              target={tutorial.external ? '_blank' : undefined}
              rel={tutorial.external ? 'noopener' : undefined}
            >
              {HAS_THUMB.has(tutorial.key) ? (
                <img
                  class="tut-thumb"
                  src={`${baseUrl}/img/tutorial-thumbs/${tutorial.key}.webp`}
                  loading="lazy"
                  decoding="async"
                  alt={`Preview of ${tutorial.title}`}
                />
              ) : (
                <span class="tut-thumb tut-thumb-empty">
                  {tutorial.key === 'cli_desktop' ? '$ jbrowse' : 'JBrowse 2'}
                </span>
              )}
              <span class="tut-card-body">
                <span class="tut-card-title">
                  {tutorial.title}
                  {tutorial.external && <span class="tut-ext"> ↗</span>}
                </span>
                {(tutorial.hasVideo ||
                  (tutorial.cost && TUTORIAL_DATA_COSTS[tutorial.cost])) && (
                  <span class="tut-chips">
                    {tutorial.cost && TUTORIAL_DATA_COSTS[tutorial.cost] && (
                      <span
                        class={`tut-cost tut-cost-${tutorial.cost}`}
                        title={TUTORIAL_DATA_COSTS[tutorial.cost]!.title}
                      >
                        {TUTORIAL_DATA_COSTS[tutorial.cost]!.label}
                      </span>
                    )}
                    {tutorial.hasVideo && (
                      <span
                        class="tut-cost tut-video"
                        title="Includes a video tutorial"
                      >
                        ▶ Video
                      </span>
                    )}
                  </span>
                )}
                {tutorial.description && (
                  <span class="tut-card-desc">{tutorial.description}</span>
                )}
              </span>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</DocsLayout>

<style>
  .lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }
  .tut-section {
    margin: 0 0 2rem;
  }
  .tut-heading {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tut-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }
  .tut-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }
  .tut-card:hover,
  .tut-card:focus-visible {
    border-color: var(--card-hover-border);
    box-shadow: var(--card-hover-shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tut-card {
      transition: 150ms ease;
      transition-property: border-color, box-shadow, transform;
    }
    .tut-card:hover,
    .tut-card:focus-visible {
      transform: translateY(-2px);
    }
  }
  .tut-thumb {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
  }
  .tut-thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    background: var(--color-blockquote-bg);
  }
  .tut-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.7rem 0.8rem 0.85rem;
  }
  .tut-card-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .tut-ext {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .tut-card-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
  /* The card body is a flex column, so without a row of its own each chip
     stretches to the card width and stops reading as a chip. */
  .tut-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .tut-cost {
    align-self: flex-start;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.5;
    padding: 0 0.45rem;
    border: 1px solid;
    border-radius: 999px;
    white-space: nowrap;
  }
  /* Weight descends with cost, which is the point: the zero-setup pages are
     what a reader scanning the grid is usually hunting for, so those are the
     ones that pop and the pipelines recede into the card. */
  .tut-cost-hosted {
    color: var(--color-accent-dark);
    border-color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }
  .tut-cost-download {
    color: var(--color-primary);
    border-color: color-mix(in srgb, var(--color-primary) 35%, transparent);
    background: color-mix(in srgb, var(--color-primary) 8%, transparent);
  }
  .tut-cost-pipeline {
    color: var(--color-text-muted);
    border-color: var(--color-border);
    background: transparent;
  }
  /* Quieter than every cost chip: the cost is what a reader filters the grid
     by, and a video is a bonus on whichever page they land on. */
  .tut-video {
    color: var(--color-text-muted);
    border-color: var(--color-border);
    background: var(--color-blockquote-bg);
  }
</style>
