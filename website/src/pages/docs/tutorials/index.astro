---
import { getCollection } from 'astro:content'

import DocsLayout from '../../../layouts/DocsLayout.astro'
import { baseUrl } from '../../../lib/base-url.ts'
import { entrySlug } from '../../../lib/docs-sidebar.ts'
import {
  TUTORIAL_CATEGORIES,
  TUTORIAL_FALLBACK,
  TUTORIAL_NO_THUMB,
  TUTORIAL_ORDER,
  TUTORIAL_SUBCATEGORIES,
} from '../../../lib/guide-categories.ts'

const CATEGORY_ORDER = new Set(TUTORIAL_CATEGORIES)
const FALLBACK = TUTORIAL_FALLBACK

// Docs outside tutorials/ that this page also shows, with their section.
const EXTRA_DOCS = new Map([
  ['quickstart_web', 'Getting started'],
  ['quickstart_desktop', 'Getting started'],
  ['cookbook', 'Configuration & embedding'],
  ['agents', 'Automation'],
])

const rank = (key: string) => {
  const i = TUTORIAL_ORDER.indexOf(key)
  return i === -1 ? TUTORIAL_ORDER.length : i
}

// A card's thumbnail is static/img/tutorial-thumbs/<key>.webp.
const key = (id: string) =>
  id.startsWith('tutorials/') ? id.slice('tutorials/'.length) : id

interface TutorialCard {
  key: string
  href: string
  title: string
  description?: string
  category: string
  subcategory?: string
  external: boolean
}

const docs = await getCollection('docs')
const cardFrom = (
  entry: (typeof docs)[number],
  category: string,
): TutorialCard => ({
  key: key(entry.id),
  href: `${baseUrl}/docs/${entrySlug(entry.id)}/`,
  title: entry.data.title,
  description: entry.data.description,
  category,
  subcategory: entry.data.tutorial_subcategory,
  external: false,
})

const EXTERNAL_CARDS: TutorialCard[] = [
  {
    key: 'embedding_examples',
    href: 'https://jbrowse.org/storybook/lgv/',
    title: 'Embedded component examples',
    description:
      'Live, copy-paste examples for the embeddable React components: themes, per-feature colors, sessions, text search, and more.',
    category: 'Configuration & embedding',
    external: true,
  },
]

const tutorialDocs = docs.filter(entry => entry.id.startsWith('tutorials/'))

const tutorials = [
  ...docs
    .filter(entry => EXTRA_DOCS.has(entry.id))
    .map(entry => cardFrom(entry, EXTRA_DOCS.get(entry.id)!)),
  ...tutorialDocs.map(entry =>
    cardFrom(entry, entry.data.tutorial_category ?? FALLBACK),
  ),
  ...EXTERNAL_CARDS,
].sort((a, b) => rank(a.key) - rank(b.key) || a.title.localeCompare(b.title))

// A mistyped category or subcategory would silently move the page, so fail the
// build instead.
const misfiled = tutorialDocs.flatMap(entry => {
  const { tutorial_category: category, tutorial_subcategory: sub } = entry.data
  if (category && !CATEGORY_ORDER.has(category)) {
    return [`${entry.id}: unknown tutorial_category "${category}"`]
  }
  if (sub && !TUTORIAL_SUBCATEGORIES[category ?? '']?.includes(sub)) {
    return [
      `${entry.id}: tutorial_subcategory "${sub}" is not listed under "${category}"`,
    ]
  }
  return []
})
if (misfiled.length > 0) {
  throw new Error(
    `Fix the frontmatter or TUTORIAL_CATEGORIES/TUTORIAL_SUBCATEGORIES:\n  ${misfiled.join('\n  ')}`,
  )
}

const grouped = [...CATEGORY_ORDER, FALLBACK]
  .map(category => {
    const items = tutorials.filter(t =>
      CATEGORY_ORDER.has(t.category)
        ? t.category === category
        : category === FALLBACK,
    )
    const subsections = [undefined, ...(TUTORIAL_SUBCATEGORIES[category] ?? [])]
      .map(subcategory => ({
        subcategory,
        items: items.filter(t => t.subcategory === subcategory),
      }))
      .filter(sub => sub.items.length > 0)
    return { category, subsections }
  })
  .filter(group => group.subsections.length > 0)

const HAS_THUMB = new Set(
  tutorials.map(t => t.key).filter(k => !TUTORIAL_NO_THUMB.has(k)),
)
---

<DocsLayout
  title="Tutorials"
  currentSlug="tutorials"
  description="Step-by-step, data-driven walkthroughs of common JBrowse workflows."
>
  <p class="lead">
    Hands-on walkthroughs of common JBrowse workflows, from first setup to
    advanced analysis. The first section runs on
    <a href="https://genomes.jbrowse.org" target="_blank" rel="noopener">
      genomes.jbrowse.org
    </a>
    , which hosts a configured JBrowse for every UCSC genome, so those pages
    need nothing installed and no data prepared.
  </p>
  {grouped.map(group => (
    <section class="tut-section">
      <h2 class="tut-heading">{group.category}</h2>
      {group.subsections.map(sub => (
        <>
          {sub.subcategory && <h3 class="tut-subheading">{sub.subcategory}</h3>}
          <div class="tut-grid">
            {sub.items.map(tutorial => (
              <div class="tut-card">
                <a
                  class="tut-card-head"
                  href={tutorial.href}
                  target={tutorial.external ? '_blank' : undefined}
                  rel={tutorial.external ? 'noopener' : undefined}
                >
                  {HAS_THUMB.has(tutorial.key) ? (
                    <img
                      class="tut-thumb"
                      src={`${baseUrl}/img/tutorial-thumbs/${tutorial.key}.webp`}
                      loading="lazy"
                      decoding="async"
                      alt={`Preview of ${tutorial.title}`}
                    />
                  ) : (
                    <span class="tut-thumb tut-thumb-empty">
                      {tutorial.key === 'cli_desktop'
                        ? '$ jbrowse'
                        : 'JBrowse 2'}
                    </span>
                  )}
                  <span class="tut-card-body">
                    <span class="tut-card-title">
                      {tutorial.title}
                      {tutorial.external && <span class="tut-ext"> ↗</span>}
                    </span>
                    {tutorial.description && (
                      <span class="tut-card-desc">{tutorial.description}</span>
                    )}
                  </span>
                </a>
              </div>
            ))}
          </div>
        </>
      ))}
    </section>
  ))}
</DocsLayout>

<style>
  .lead {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    margin: 0 0 1.5rem;
  }
  .tut-section {
    margin: 0 0 2rem;
  }
  .tut-heading {
    font-size: 1.15rem;
    margin: 0 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-border);
  }
  .tut-subheading {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 1.25rem 0 0.6rem;
  }
  .tut-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1rem;
  }
  .tut-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--card-radius);
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    color: inherit;
  }
  .tut-card:hover,
  .tut-card:focus-within {
    border-color: var(--card-hover-border);
    box-shadow: var(--card-hover-shadow);
  }
  @media (prefers-reduced-motion: no-preference) {
    .tut-card {
      transition: 150ms ease;
      transition-property: border-color, box-shadow, transform;
    }
    .tut-card:hover,
    .tut-card:focus-within {
      transform: translateY(-2px);
    }
  }
  .tut-thumb {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
    object-position: top;
    display: block;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
  }
  .tut-thumb-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    background: var(--color-blockquote-bg);
  }
  .tut-card-head {
    display: flex;
    flex: 1;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }
  .tut-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.7rem 0.8rem 0.85rem;
  }
  .tut-card-title {
    font-weight: 600;
    line-height: 1.3;
  }
  .tut-ext {
    color: var(--color-text-muted);
    font-weight: 400;
  }
  .tut-card-desc {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
</style>
