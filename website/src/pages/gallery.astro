---
import { Buffer } from 'node:buffer'
import { closeSync, openSync, readSync } from 'node:fs'
import path from 'node:path'

import DocsSidebarNav from '../components/DocsSidebarNav.astro'
import SidebarLayout from '../layouts/SidebarLayout.astro'
import { baseUrl } from '../lib/base-url.ts'
import {
  LIVE_LABEL,
  gallerySections,
  itemGuideHref,
  itemGuideLabel,
  itemImg,
  itemLiveHref,
  itemPrimary,
} from '../lib/gallery.ts'
import page from '../styles/page.module.css'

// Intrinsic dimensions from the PNG IHDR header (width @ byte 16, height @ 20),
// stamped on each <img> so the browser reserves the right box and the page
// doesn't jump as the lazy-loaded screenshots arrive.
function pngSize(file: string) {
  // Astro bundles this frontmatter into a chunk under dist/ for prerendering,
  // so an import.meta.url-relative path resolves against the compiled chunk's
  // location (varies with chunking) instead of the source tree — read from
  // cwd (the site root `pnpm build` always runs from) instead.
  const filePath = path.resolve(process.cwd(), 'static/img', file)
  const fd = openSync(filePath, 'r')
  const buf = Buffer.alloc(24)
  readSync(fd, buf, 0, 24, 0)
  closeSync(fd)
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) }
}

// Cards paint at most 594x260 CSS px, so they show a downscaled thumbnail
// (`pnpm gen:gallery-thumbs`) rather than the ~3000px capture — 6.72MB of
// figures over the full scroll becomes 3.25MB. The card still carries the
// original's path, which is what the lightbox enlarges.
const thumbOf = (file: string) => `gallery-thumbs/${file}`

// A gallery item added without regenerating fails the build here, so name the
// fix — the bare ENOENT from pngSize doesn't say which command produces these.
function thumbSize(file: string) {
  try {
    return pngSize(thumbOf(file))
  } catch {
    throw new Error(
      `no gallery thumbnail for ${file} — run \`pnpm gen:gallery-thumbs\``,
    )
  }
}

// Sections shown as screenshot cards vs. compact link lists: an item appears in
// the card grid when it has a figure, otherwise in the "more examples" list.
const sections = gallerySections
  .map(s => ({
    ...s,
    cards: s.items.flatMap(i => {
      const file = itemImg(i)
      // Sized from the thumbnail, which is what the card paints; the full-size
      // original is only ever handed to the lightbox.
      return file ? [{ item: i, file, thumb: thumbOf(file), size: thumbSize(file) }] : []
    }),
    links: s.items.filter(i => !itemImg(i)),
  }))
  .filter(s => s.cards.length > 0 || s.links.length > 0)
---

<SidebarLayout
  title="JBrowse 2 Visualizations Gallery"
  description="A gallery of genome visualizations built with JBrowse 2, including synteny, structural variants, alignments, methylation, and Hi-C contact matrices."
  toggleLabel="Explore"
  navLabel="Site navigation"
>
  <DocsSidebarNav slot="nav" currentSlug="gallery" />
  <div class="showcase-main">
    <div class={`${page.content} wide`}>
      <h1>JBrowse 2 visualizations gallery</h1>

      {
        sections.map(s => (
          <section>
            <h2 id={s.id}>{s.title}</h2>
            {s.cards.length > 0 && (
              <div class="grid">
                {s.cards.map(({ item, file, thumb, size }) => {
                  const src = `${baseUrl}/img/${thumb}`
                  const full = `${baseUrl}/img/${file}`
                  const liveHref = itemLiveHref(item)
                  const guideHref = itemGuideHref(item, baseUrl)
                  // Enlarging opens the live view when there is one, else the guide.
                  const primary = itemPrimary(item, baseUrl)
                  return (
                    <figure class="card">
                      <button
                        type="button"
                        class="card-img-btn lightbox-trigger"
                        data-label={item.label}
                        data-full={full}
                        data-href={primary.href}
                        data-open-label={primary.label}
                        aria-label={`Enlarge: ${item.label}`}
                      >
                        <img
                          src={src}
                          alt={item.label}
                          loading="lazy"
                          width={size.width}
                          height={size.height}
                        />
                      </button>
                      <figcaption>
                        <h3 class="card-title">{item.label}</h3>
                        {item.description && <p>{item.description}</p>}
                        <p class="card-links">
                          {guideHref ? (
                            <a
                              href={guideHref}
                              class="card-open"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {itemGuideLabel(item)}
                            </a>
                          ) : (
                            liveHref && (
                              <a
                                href={liveHref}
                                class="card-open"
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                {LIVE_LABEL}
                              </a>
                            )
                          )}
                        </p>
                      </figcaption>
                    </figure>
                  )
                })}
              </div>
            )}
            {s.links.length > 0 && (
              <>
                {s.cards.length > 0 && <p class="more">More examples</p>}
                <ul class="links">
                  {s.links.map(item => (
                    <li>
                      <a href={itemPrimary(item, baseUrl).href}>{item.label}</a>
                      {item.description && <span> — {item.description}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        ))
      }
    </div>
  </div>
</SidebarLayout>

<style>
  .showcase-main {
    flex: 1;
    min-width: 0;
  }
  .wide {
    max-width: 1280px;
  }

  h1 {
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.75rem;
  }
  h2 {
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 5rem;
  }

  /* Two cards per row from 760px up, so the page reads as a contact sheet
     rather than one tall column; the lightbox is where a figure gets read at
     full size, so a half-width card only has to be legible enough to pick. */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem 1.75rem;
    align-items: start;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .card {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .card-img-btn {
    margin: 0;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .card img {
    display: block;
    width: 100%;
    height: auto;
    /* Figures range from wide panoramas to 1100-row stacks. A wide one fills the
       card at its own ratio; a tall one is capped and fits inside instead of
       setting the height of everything beside it. Nothing is cropped — the
       lightbox is where a figure gets read at full size. */
    max-height: 260px;
    object-fit: contain;
  }

  figcaption {
    padding: 0.5rem 0 0;
  }
  .card-title {
    margin: 0 0 0.25rem;
  }
  figcaption p {
    margin: 0.25rem 0;
    /* Descriptions can contain long unbreakable tokens (file paths, URLs).
       `anywhere` (not `break-word`) is required: it also shrinks the min-content
       width, so the grid's 1fr track collapses instead of the token forcing the
       card wider than a narrow mobile viewport. */
    overflow-wrap: anywhere;
  }
  .card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0.4rem 0 0;
  }
  .card-open {
    display: inline-block;
  }

  .more {
    margin: 1.25rem 0 0.25rem;
  }
  .links {
    margin: 0.25rem 0;
    padding-left: 1.25rem;
    line-height: 1.7;
  }
</style>
