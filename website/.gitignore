
# debug screenshots dumped by generate-screenshots on failure. Deliberately
# outside static/, which astro.config publishes wholesale as `publicDir` —
# .gitignore does not stop Astro copying a file into dist/. The static/img
# pattern stays as a backstop so an older dump, or a writer that regresses to
# the old path, still cannot be committed.
debug-screenshots/
static/img/debug_*.png

# staging files for the atomic PNG rename in scripts/image-pipeline.ts. They
# exist for the microseconds between the copy and the rename; one only survives
# a regen killed mid-write, and must not be committed (or, since static/ is
# Astro's publicDir, published) if it does.
static/img/**/*.tmp

# pagefind search index; generated by `pnpm index` for local dev search, and by
# `pnpm build` straight into dist/ for production. Never commit it.
static/pagefind/

# card thumbnails and homepage images, cropped from the figures by
# `pnpm gen:derived-figures` (which `dev`, `build` and `index` run for you).
# Neither committed nor pushed to the figure store: they are regenerated from
# files the repo already has, the figures they derive from churn hard (517
# revisions in three months), and a stored copy of a crop is a copy that goes
# stale the next time its source moves. figure-store.ts's isDerivedFigure is the
# half of this rule the store reads; these lines are the half git reads.
static/img/gallery-thumbs/
static/img/tutorial-thumbs/
static/img/home-gallery/
static/img/segment-maps/
static/img/screenshot.webp
static/img/desktop-available-genomes.webp

# what the last `pnpm screenshots` run noticed, written by screenshot-report.ts
# and read by review-screenshots-web to mark specs that failed to render or
# rendered differently twice. Describes one run on one machine, so committing it
# would churn every sweep and mean nothing on anyone else's checkout.
scripts/screenshot-run.json
