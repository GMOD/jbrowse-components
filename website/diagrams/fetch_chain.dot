// Every box says what happens in ENGLISH, with the identifier under it in small
// grey monospace. Reading the chain and finding the code are two different
// tasks, and a label that only names `boundsValid && isCacheValid()` serves the
// second at the cost of the first — you cannot follow the flow until you have
// read four function signatures. The English line is what the eye lands on; the
// identifier is there when the reader goes looking.
//
// The English is plain rather than merely spelt out, which is a second pass and
// not the same one: "is this block already covered?" is a sentence made of our
// own vocabulary, and a block, a fetch and a region are all things the reader is
// here to learn.
//
// It is also DRY (review: "try to use somewhat 'dry' language, so that this
// could be included in a scientific paper"). The two are not the same pass
// either, and the first draft of the plain version was conversational where it
// should only have been unspecialized: no first or second person ("do we already
// have data", "while we waited"), no colloquial verb where a neutral one exists
// ("ask a background worker" -> "request the data from a worker", "throw it
// away" -> "discard the result"), and no vagueness bought with informality
// ("is that too much data?" -> "over the byte budget?", which is the actual
// test). Plain still rules the top line — nothing there is a term this page has
// to define first — and the identifier under it is where the precision lives.
//
// That needs HTML-like labels (`label=<…>` rather than `label="…"`), so `&` is
// `&amp;` inside them, and a malformed one renders as literal angle brackets
// rather than failing — check the render, not the exit code.
//
// The three questions are rounded boxes rather than diamonds. A diamond sized to
// hold a sentence is about twice as wide as the sentence, and there are three of
// them; the "?" and the yes/no edges already say it is a branch.
//
// Two nodes and a cluster came out by the rule that a step whose whole job is to
// hand off to the next one is an EDGE, not a box:
//
//   collect into `needed`    -> the check's "no" branch, which also carries
//                               fetchNeeded(needed), the call it makes
//   rotate stop token /      -> "cancels whatever was still in flight" in the
//     capture fetchGeneration   cluster's own label, since that is what entering
//                               fetchRegions does
//   FetchVisibleRegions      -> the edge from the view moving to the check. It
//                               was a cluster drawn around that single question,
//                               which is a label with a border.
//
// That leaves ONE cluster, and it now means something a fill colour could not
// say on its own: everything inside it is the display's to write.
//
// `increment fetchGeneration` looks like the same case and is not. Dropping it
// turns two SOLID in-cluster edges into two more dashed ones leaving the box, so
// the picture pays a crossing and a label sitting on the cluster border to save
// one node. Keeping it holds the whole rule "dashed means look again" to two
// places, both below the chain.
//
// The cluster's label is left-justified AND short because the edge into the box
// enters at the first node's horizontal centre: a label reaching that far right
// gets struck through by the arrow, which is why fetchNeeded moved to the edge
// and fetchRegions lost nothing but its length here.
digraph fetch_chain {
  rankdir=TB
  labelloc=t
  fontname="Helvetica"
  fontsize=18
  label="Data fetching in a linear display: viewport change to loaded data, and back to rest"
  nodesep=0.35
  ranksep=0.5

  node [shape=box, fontname="Helvetica", fontsize=13, style=filled, fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#555555"]

  viewport [
    label=<the visible region changes<br/><font point-size="9" face="Courier" color="#6b6b6b">view.visibleRegions</font>>
    fillcolor="#e1f5fe"
  ]
  check [
    shape=box, style="filled,rounded"
    label=<is this region already<br/>covered by loaded data?<br/><font point-size="9" face="Courier" color="#6b6b6b">boundsValid &amp;&amp; isCacheValid()</font>>
    fillcolor="#e3f2fd"
  ]

  // ── What the display owns ────────────────────────────────────────
  subgraph cluster_fetch {
    label=<<br/><b>the display's own code</b><br/><font point-size="10" face="Courier" color="#5b6b4b">fetchRegions(needed, work)</font><br/><font point-size="10">cancels any fetch in flight</font><br/>>
    labelloc=t
    labeljust=l
    fontname="Helvetica"
    fontsize=13
    style=filled
    fillcolor="#f1f8e9"
    color="#aed581"

    bytes [
      shape=box, style="filled,rounded"
      label=<over the<br/>byte budget?<br/><font point-size="9" face="Courier" color="#6b6b6b">byte estimate vs budget</font>>
      fillcolor="#ffffff"
    ]
    work [
      label=<request the data from a worker<br/><font point-size="9" face="Courier" color="#6b6b6b">rpcManager.call(…, rpcProps(), stopToken)</font>>
    ]
    stale [
      shape=box, style="filled,rounded"
      label=<did the region change<br/>during the fetch?<br/><font point-size="9" face="Courier" color="#6b6b6b">ctx.isStale()</font>>
      fillcolor="#ffffff"
    ]
    commit [
      label=<store the result and draw<br/><font point-size="9" face="Courier" color="#6b6b6b">setRpcData(regionIndex, result)</font>>
      fillcolor="#dcedc8"
    ]
    bump [
      label=<fetch complete<br/><font point-size="9" face="Courier" color="#6b6b6b">fetchGeneration++</font>>
      fillcolor="#dcedc8"
    ]
  }

  toolarge [
    label=<halt, and offer Force load<br/><font point-size="9" face="Courier" color="#8a6d3b">regionTooLarge</font>>
    style="filled,dashed"
    fillcolor="#fff3e0"
  ]
  done [label=<no fetch required>, peripheries=2, fillcolor="#e1f5fe"]

  viewport -> check [label=<  after 600 ms without further change<br align="left"/>  <font face="Courier" color="#6b6b6b">FetchVisibleRegions</font><br align="left"/>>]
  check -> done [label="  yes"]
  check -> bytes [label=<  no; fetch the uncovered regions<br align="left"/>  <font face="Courier" color="#6b6b6b">fetchNeeded(needed)</font><br align="left"/>>]
  bytes -> toolarge [label="  yes"]
  bytes -> work [label="  no"]
  work -> stale
  stale -> commit [label="  no"]
  stale -> bump [label="  yes; discard the result"]
  commit -> bump

  // Both loose ends re-enter the same debounced check, so they meet at a
  // junction and travel back as ONE edge. Drawn as two they were two long dashed
  // sweeps up the whole right side, which is most of what a reader sees before
  // they see the chain — and both said the same thing anyway. What differs is
  // only what re-fires the autorun, which the edge's own label now names.
  reenter [shape=point, width=0.06, color="#555555"]
  // The junction's rank comes from this one edge keeping its constraint, which
  // puts it just below the last node of the chain. `{ rank=same; bump; reenter }`
  // is the obvious alternative and is wrong: a rankset EJECTS its members from
  // their cluster ("bump was already in a rankset, deleted from cluster"), which
  // drops that node out of the green box it belongs to.
  bump -> reenter [style=dashed, arrowhead=none]
  // The other two are constraint=false: they close the loop but must not pull
  // their targets back up a rank, which is what left the entry node stranded
  // mid-graph and crossed every edge around it.
  toolarge -> reenter [style=dashed, constraint=false, arrowhead=none]
  reenter -> check [
    label=<  re-evaluate<br align="left"/>  <font point-size="9">on fetch completion, or at the next settled viewport</font><br align="left"/>>
    style=dashed
    constraint=false
  ]
}
