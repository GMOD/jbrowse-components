// Source for /img/gpu_display_lifecycle.png, embedded by
// docs/developer_guides/creating_gpu_display.md under "Architecture overview".
//
// THE THREE DOORS ON THE LEFT are the figure's second job, and the page's: a
// reader deciding where a new setting goes needs to know how far back each kind
// of change reaches. The chain is one column, each door enters it at the stage
// that change re-enters, and what is left below the door is what it costs.
// `rpcProps()` enters above the worker; `gpuProps()` enters at the upload
// autorun, which is where it is read, so a color scheme re-encodes and
// re-uploads bytes already in hand; everything else is a frame. Same rule
// ARCHITECTURE.md states as `rpcProps()` refetches and `gpuProps()` re-uploads,
// and the one dataflow.md's "Where the GPU sits" carries in prose beside the
// whole-path figure.
//
// They are the light blue this corpus uses for an entry point elsewhere
// (dataflow.dot's "the visible region changes", fetch_chain.dot's), and dashed,
// so a door reads as something happening TO the chain rather than as more of
// it.
digraph gpu_display_lifecycle {
  rankdir=TB
  labelloc=t
  fontname="Helvetica"
  fontsize=18
  label="GPU display: worker data to a drawn frame, and where a change re-enters"
  compound=true
  nodesep=0.4
  ranksep=0.55

  node [shape=box, fontname="Helvetica", fontsize=12, style=filled, fillcolor="#ffffff"]
  edge [fontname="Helvetica", fontsize=10, color="#555555"]

  // TOP TO BOTTOM rather than left to right. As three side-by-side lanes this
  // came out about 7:1, which on a docs page is a strip with unreadable text,
  // and the renderTick edge, the loop the caption says the figure is OF, had
  // to run the whole width back under everything with its label parked in the
  // middle of the frame, attached to neither end. Stacked, each lane is a band
  // and that edge is one rank tall.

  // ── Worker ───────────────────────────────────────────────────────
  subgraph cluster_worker {
    label="Worker (RPC)"
    labelloc=t
    fontname="Helvetica"
    fontsize=13
    style=filled
    fillcolor="#e3f2fd"
    color="#90caf9"

    // `execute()` is the RPC method's own hook, and the name rpc_lifecycle.dot
    // labels "your code". `executeRender()`, which this said, resolves to no
    // symbol in the tree.
    exec [label="execute()\nfetch + pack, absolute uint32 bp"]
  }

  // ── Main thread ──────────────────────────────────────────────────
  subgraph cluster_main {
    label="Main thread (MST model)"
    labelloc=t
    fontname="Helvetica"
    fontsize=13
    style=filled
    fillcolor="#f1f8e9"
    color="#aed581"

    rpcdata [label="rpcDataMap\none entry per region", fillcolor="#dcedc8"]
    // Inside this lane for the same reason `viewstate` is: `gpuProps()` is a
    // view method on the model, read by the upload callback. Drawn outside, its
    // edge came in as a diagonal across the whole lane.
    door_upload [label="gpuProps() changed,\nor a derived region map", shape=box,
                 style="filled,rounded,dashed", fillcolor="#e1f5fe", color="#90caf9"]
    uploadrun [label="upload autorun\none per display, diffed", shape=ellipse]
    // Scroll and zoom are why renderState exists. Without them it reads as a
    // node nothing feeds, and the render autorun looks like it has one trigger
    // when the whole point of the pair is that it has two. Inside this lane
    // because they are main-thread view state; outside it, the edge crossed
    // the cluster's own label on the way in — which is also why this is the one
    // door drawn inside a lane.
    //
    // `config` was the wrong fourth item: a config change is a refetch or a
    // re-upload depending on which list carries it, which is the distinction
    // the other two doors are here to draw. Opacity is the plot-wide scalar
    // that genuinely is a frame — ARCHITECTURE.md, "opacity is a render
    // parameter, never a packed color".
    viewstate [label="scroll, zoom, opacity, resize", shape=box,
               style="filled,rounded,dashed", fillcolor="#e1f5fe", color="#90caf9"]
    renderstate [label="renderState\nframe uniforms, no fetch"]
    renderrun [label="render autorun\nobserves renderTick", shape=ellipse]
  }

  // ── GPU / Canvas ─────────────────────────────────────────────────
  subgraph cluster_gpu {
    // The runtime choice belongs in the lane's own name. As a separate dashed
    // node with a "dispatch" edge it took the rank directly under
    // renderBlocks(), which pushed both outputs two ranks further down and
    // made their edges cross the lane on the way there, and it drew the HAL
    // as something the renderer calls out to, when the HAL is the lane.
    label="GPU / Canvas: the HAL, dispatching to WebGPU | WebGL2 | Canvas2D at runtime"
    labelloc=t
    fontname="Helvetica"
    fontsize=13
    style=filled
    fillcolor="#fff3e0"
    color="#ffcc80"

    upload [label="backend.upload()"]
    render [label="backend.renderBlocks()"]
  }

  // The two things a finished frame produces. `canvasDrawn` was missing
  // entirely, and it is the half of the answer anything outside the display
  // reads: markCanvasDrawn() flips it when renderBlocks() reports it drew, and
  // that flag is what the readiness testids and DisplayChrome's loading state
  // are waiting on. A figure that ends at "frame" says a picture appeared but
  // not how the rest of the app finds out.
  frame [label="frame", fillcolor="#ffe0b2", peripheries=2]
  drawn [label="canvasDrawn = true\n(readiness testids, DisplayChrome)", fillcolor="#ffe0b2"]

  // The third door, and the only one above the worker.
  door_fetch [label="a region with no loaded data,\nor rpcProps() changed", shape=box,
              style="filled,rounded,dashed", fillcolor="#e1f5fe", color="#90caf9"]

  door_fetch -> exec [label=<  <b>refetch</b>  >]
  door_upload -> uploadrun [label=<  <b>re-encode, re-upload</b><br align="left"/>  no fetch<br align="left"/>>]

  exec -> rpcdata [label="  structured clone"]
  rpcdata -> uploadrun [label="  any entry changed"]
  uploadrun -> upload

  // renderNow() bumps renderTick on the MODEL and the RENDER AUTORUN is what
  // observes it (`void self.renderTick`). The old edge landed on renderState
  // instead, which is not a thing renderNow() touches, and renderState is
  // read by the render callback, so pointing the tick there implied the upload
  // path recomputes frame uniforms.
  upload -> renderrun [
    label="  renderNow(): renderTick++"
    style=dashed
    constraint=false
  ]

  viewstate -> renderstate
  renderstate -> renderrun [label=<  <b>redraw</b><br align="left"/>  no fetch, no upload<br align="left"/>>]
  renderrun -> render
  render -> frame
  render -> drawn [label="  if it drew"]
  // Both outputs on one rank under the lanes, so neither lands inside the GPU
  // cluster's box and reads as another thing the HAL owns.
  { rank=same; frame; drawn }
}
