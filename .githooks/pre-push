#!/bin/sh
# Runs the CI gates that nothing else here runs — docs, generated artifacts,
# lint, format and the ESM build — over what you are about to push, so main does
# not go red on something a local check would have caught. `pnpm install` points
# core.hooksPath here; skip with SKIP_DOCS_CHECK=1 or `git push --no-verify`.
#
# IT FIXES RATHER THAN REPORTS. Three of the five gates have an autofixer, so
# this runs the fixer: `pnpm autogen --fix-stale` when its check says anything
# is stale, both linters with `--fix`, and `pnpm format` over the whole tree.
# Reporting "regenerate and commit" only to have the person run the exact
# command the hook already knew was minutes of waiting to be told to wait
# minutes more.
#
# AND IT COMMITS AND PUSHES WHAT IT FIXED. The fixes land in the working tree,
# not in the commits on their way out, so the push git is holding would send
# exactly the state that just failed. Rather than hand that back as a chore, the
# hook commits the fixed paths itself and pushes the refs on its stdin — the
# same refs the outer push was going to send. One `git push` therefore lands the
# work plus its regeneration, with no second command to run.
#
# THE OUTER PUSH THEN REPORTS FAILURE, AND THAT REPORT IS STALE. git resolved
# which commit to send before this hook ran, so once the hook's own push has
# landed a newer commit on the same ref, nothing the outer push can do is a
# fast-forward. It exits nonzero having already got its way. The hook says so in
# as many words before exiting; `git status` is the check — "up to date with
# origin/<branch>" means it landed.
#
# WHAT IT WILL NOT COMMIT: a path that was ALREADY dirty when the run started.
# That is someone else's work in progress on the shared checkout, or a
# half-finished edit here that a fixer happened to rewrite, and neither belongs
# in a commit nobody wrote. Those still block with the old message. Same for a
# push of anything but the current branch, where there is no HEAD to commit onto.
#
# WHAT STILL ONLY REPORTS: `check-docs` and `build:esm` have no fixer, and
# `--fix` on either linter leaves whatever rule has no autofix. Those are still
# yours to fix by hand, and nothing gets pushed until they pass.
#
# CI's `Format` job has no counterpart here and does not need one: the format
# step below runs over the whole tree, so `pnpm check-format` is satisfied by
# construction rather than checked.
#
# WHY PRE-PUSH AND NOT PRE-COMMIT. All of them read the whole tree — there is
# no staged-paths version of "is this generated artifact current", because the
# artifact is a function of every source that feeds it. At minutes that is far
# too slow per commit and about right per push, which is also the moment the
# cost lands on other people rather than on you.
#
# WHAT IT COSTS. Measured warm on 2026-09-01, on a machine at load 6-12 with
# other agents running:
#   pnpm figures:check       1.5s
#   pnpm autogen --check     5.4s  with `--skip-whole-repo-program`; 22.5s
#                                  without it, because `config/model/api docs`
#                                  alone is 21s and the other 29 generators
#                                  hide behind it in the pool
#   pnpm check-docs          9.2s  31s of validators, pooled four at a time.
#                                  Now the longest single gate here
#   pnpm lint               10.1s  type-aware oxlint; `lint:fast` is 4s of it
#   pnpm lint:eslint         5.6s  (127s without --cache)
#   pnpm format              9.4s  whole tree, 6908 files
#   pnpm build:esm           1.7s  incremental
# Every gate here is CPU-bound and this machine runs several agents, so a wall
# number swings by a factor of two with what else is running. That is why the
# end-to-end figures are quoted as interleaved A/B pairs and not as single runs:
# 33-47s here, against 77-96s for the version that ran the whole-repo program,
# alternating on the same tree minutes apart while the load average went from 4
# to 22. The version before that one, which also paid for pnpm seven times over
# and rewrote every generator to heal one, was 81-106s.
#
# THE FIXERS RUN IN SEQUENCE, unlike the old all-parallel version, because they
# write to the same files: autogen emits sources the linters then lint, and both
# linters rewrite the same `.ts`. Only the two read-only gates still overlap.
# That costs nothing in wall time — contention was eating the parallelism
# anyway.
#
# GOING FURTHER DOWN THAT ROAD DOES NOT WORK, and was measured on 2026-09-01
# rather than reasoned about: running `autogen --check` and `check-docs` as one
# read-only lane ALONGSIDE the fixers, which on paper folds two ~23s lanes into
# one, came out at 83s and 84s against the sequential version's 79s and 85s in
# an interleaved A/B. The lanes want ~22 cores between them on a 16-core machine
# that already has 6-12 in use, so the overlap buys nothing and the wall number
# is set by what else is running. What was actually costing the time was the
# 21s program, and the fix for that was not to schedule it differently but to
# stop running it here at all.
#
# A COLD `build:esm` is worse and happens once per checkout — tsc has no
# .tsbuildinfo to reuse and takes a minute or more. Every run after that is the
# 5s above. It compiles what we PUBLISH, which `pnpm typecheck` does not: the
# Typecheck job runs it too now, so this is the local copy of that gate rather
# than the only one there is.
#
# WHY IT EARNS THE WAIT. On 2026-08-10 the first two gates went red on main four
# separate times in one day, every time because a figure or docs commit landed
# without its regeneration. On 2026-08-13 the other three were found red on main
# ALL AT ONCE, having drifted unseen for two days: 11 eslint errors across
# several authors (oldest two days old), check-config-read-types up 147 -> 148,
# and `build:esm` broken that morning by a node-only test helper compiled into
# the browser bundle. None of it was visible to anyone, because work lands
# locally here and these gates only ran on push — and main had not been pushed.
# Every one was a one-line fix at the moment it landed.
#
# IT READS THE WORKING TREE, NOT THE COMMITS BEING PUSHED. Every command here
# answers its question against the files on disk, so pushing from the
# SHARED primary checkout reports on whatever else is uncommitted there — the
# first push after this landed was told `config/model/api docs` was stale, which
# was six model docs another agent had regenerated and not yet committed, not
# anything in the push. Push from your own worktree and the question is about
# your work. There is no cheap fix: checking the pushed commits instead means
# materialising them somewhere clean, which costs more than the check.
#
# NOW THAT IT WRITES AND COMMITS, that same property has teeth: from the shared
# checkout the fixers rewrite whatever else is uncommitted there, and the lists
# at the end will name another agent's work alongside yours. What keeps that out
# of a commit is the already-dirty rule above — a path someone else was midway
# through is dirty when the run starts, so it reports instead. A path they had
# left clean is regeneration, and committing that is the point. One more reason
# to push from your own worktree all the same.
set -eu

if [ "${SKIP_DOCS_CHECK:-}" = 1 ]; then
  exit 0
fi

# git passes the remote's name (or its url, for an unnamed one) as $1. The
# hook's own push reuses it so the autoheal goes exactly where the push it
# interrupted was going.
remote=${1:-origin}

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: no pnpm, skipping docs checks" >&2
  exit 0
fi

# EVERY GATE BELOW RUNS AS ITS OWN BINARY, NOT AS `pnpm run <script>`. pnpm
# spends ~1.7s starting up before it does anything at all (`pnpm --version` is
# 1.65s here), and this hook runs seven of them — twelve seconds of the wait,
# buying nothing. Resolving the commands out of package.json rather than
# spelling them out keeps that from drifting away from what `pnpm run` would
# have done, `post<script>` included, in one 5ms node start.
PATH="$root/node_modules/.bin:$PATH"
export PATH
eval "$(node -e '
  const scripts = require("./package.json").scripts
  for (const name of process.argv.slice(1)) {
    const chain = [scripts[name], scripts[`post${name}`]].filter(Boolean)
    if (chain.length === 0) {
      throw new Error(`package.json has no ${name} script`)
    }
    console.log(`cmd_${name.replace(/\W/g, "_")}=${JSON.stringify(chain.join(" && "))}`)
  }
' figures:check autogen check-docs diagrams:check lint lint:eslint format build:esm)"

# stdin is one `<local ref> <local sha> <remote ref> <remote sha>` line per ref.
# A zero local sha is a branch deletion (nothing to check); a zero remote sha is
# a branch the remote has never seen, so bound the range by what the remote
# already has rather than walking to the root commit.
zero=0000000000000000000000000000000000000000
range_files=
refspecs=
found=
while read -r localref localsha remoteref remotesha; do
  [ "$localsha" = "$zero" ] && continue
  found=1
  refspecs=$refspecs$localref:$remoteref'
'
  if [ "$remotesha" = "$zero" ]; then
    files=$(git diff --name-only "$(git merge-base "$localsha" HEAD@{upstream} 2>/dev/null || echo "$localsha^")" "$localsha" 2>/dev/null || true)
  else
    files=$(git diff --name-only "$remotesha" "$localsha" 2>/dev/null || true)
  fi
  range_files=$range_files$files'
'
done

# No refs on stdin (a hook run by hand) means check anyway rather than silently
# passing; nothing to push at all means nothing to check.
if [ -z "$found" ]; then
  exit 0
fi
if [ -z "$(printf '%s' "$range_files" | tr -d '[:space:]')" ]; then
  exit 0
fi

# The sources these artifacts are generated FROM. Deliberately broad — model and
# config docs come out of plugin and package sources, so a push touching only
# code can still leave a doc table stale. A push that is purely CI config or
# editor settings matches nothing here and skips.
if ! printf '%s' "$range_files" | grep -Eq \
  '^(website/|products/|plugins/|packages/|agent-docs/|scripts/|figures\.lock)'; then
  exit 0
fi

echo "pre-push: checking docs and artifacts, fixing lint and format, building esm (~40s, SKIP_DOCS_CHECK=1 to skip)" >&2

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# What the tree looks like before the fixers touch it, so the end of the run can
# say what they changed. Names alone are not enough — a file already dirty stays
# one `M` line however much a fixer rewrites it — so pair the status with the
# per-file line counts, which do move.
tree_state() {
  git status --porcelain -uall
  git diff HEAD --numstat
}
tree_state >"$tmp/before" 2>/dev/null || true

# The paths already dirty at this point, which the autoheal at the end refuses
# to commit. Rename entries arrive as `R  old -> new`; the destination is the
# path a fixer would have rewritten.
git status --porcelain -uall 2>/dev/null | sed 's/^...//; s/.* -> //' \
  >"$tmp/dirty-before" || : >"$tmp/dirty-before"

# The two files a REVIEW APP writes, which no fixer here writes. The comparison
# above is a before/after over a ~40s window, so anything that changes during
# the run is attributed to the fixers — including someone filing verdicts
# in `pnpm review-screenshots-web` or `pnpm review-snapshots-web` in another
# window, which is a normal thing to be doing while a push runs. Blocking on
# those told someone their own half-finished review was a fixer's output and
# demanded they commit it mid-pass, which is neither true nor what they want.
#
# Narrow on purpose: these are verdict logs, written only by a human clicking,
# never derived from anything. Every other path stays blocking, because for
# every other path the attribution is right.
review_state='website/scripts/screenshot-review.json
products/jbrowse-web/browser-tests/snapshot-review.json'

# Paths that have changed since $1 was taken, so the end of the run can say
# what the fixers did.
changed_since() {
  tree_state >"$tmp/now" 2>/dev/null || true
  diff "$1" "$tmp/now" 2>/dev/null | sed -n 's/^[<>] //p' | awk '{print $NF}' |
    sort -u | grep -Fxv "$review_state" || true
}

status=0

# --- fixers, in sequence: each writes files the next one reads ---------------

# autogen only answers CI's question when this checkout's figures are the ones
# CI will have, and there are two ways for that to be false. Both produce a
# stale-artifact report about the figure corpus rather than about the push,
# which is the kind of false positive that gets a hook switched off.
#
#   - No corpora at all. They are gitignored, so a fresh worktree has none
#     (`pnpm figures:pull`, or the two symlinks in CLAUDE.md), and the
#     jbrowse-img doc and tutorial-thumb generators then report OUT OF DATE
#     rather than failing outright.
#   - Corpora ahead of figures.lock. A regen someone has not pushed yet is
#     invisible to git and to CI: CI pulls the lock's sources, derives the
#     committed thumb and agrees, while the same generators here derive from
#     the newer sources on disk and disagree. On a machine that shoots figures
#     this is the normal state, not the exception.
#
# `pnpm figures:check` settles the second in ~2s, which is worth it to keep the
# 34s answer trustworthy.
#
# When it is NOT trustworthy, drop the generators that read a figure and
# regenerate the other fifteen — `--skip-figure-dependent`, which names what it
# skipped. Running them anyway would be worse than not running them: they would
# derive from the corpus on disk and write artifacts CI, deriving from the lock,
# disagrees with, and the hook would then ask for a commit that makes the drift
# permanent instead of local.
#
# The earlier version of this degraded the WHOLE run to an advisory `--check` in
# that case, and on a machine that shoots figures that is the normal state — so
# the regeneration this hook exists for almost never happened. Before that it
# skipped the check outright, and the very next push went out with gallery links
# and the model docs stale, neither of which reads a figure.
autogen_flags=
autogen_skipped=
if [ ! -d website/static/img ] || [ ! -d products/jbrowse-img/img ]; then
  autogen_skipped="no figure corpora on disk ('pnpm figures:pull' installs them)"
elif ! eval "$cmd_figures_check" >"$tmp/figures.log" 2>&1; then
  autogen_skipped="figures on disk differ from figures.lock ('pnpm figures:check' says which)"
fi
if [ -n "$autogen_skipped" ]; then
  autogen_flags=--skip-figure-dependent
  echo "pre-push: skipping the figure-dependent generators, because $autogen_skipped" >&2
fi

# ASKS BEFORE IT WRITES, AND THEN REWRITES ONLY WHAT MOVED. `--fix-stale` runs
# every generator's `--check` pooled, which writes nothing, and then rewrites
# the ones that failed plus anything downstream reading their output. On the
# push where nothing is stale, which is most of them, the check is the whole of
# the autogen cost; on the push where something is, the rewrite is the three
# tables that drifted rather than all thirty generators.
#
# `--skip-whole-repo-program` DROPS THE ONE GENERATOR THIS HOOK CANNOT AFFORD.
# `config/model/api docs` builds a TypeScript program over every source in the
# tree to read the tags off it, which is 21s whatever the push contains and
# cannot be narrowed to the changed files — it was 22.5s of the 24s autogen
# spent here, and the other 29 generators simply hid behind it in the pool.
# Without it the check is 5.4s.
#
# IT IS NOT UNWATCHED AFTERWARDS, which is what makes the drop cheap rather
# than a hole. Two things still ask:
#
#   - post-merge runs the whole `pnpm autogen --check`, the program included,
#     in the BACKGROUND after every land, and leaves `autogen-stale` for
#     pre-commit to print. So a stale config or model page still reaches
#     whoever is about to edit the same tree, at no interactive cost — it just
#     arrives after the land instead of blocking the push before it.
#   - push.yml's `generated` job runs a bare `pnpm autogen --check` and, on
#     failure, runs the rewrite and uploads it as `autogen.patch`, so the fix
#     is `git apply` rather than reproducing the generation locally.
#
# What the drop actually costs, then, is that a stale config, model or API page
# can land on main and be named minutes later rather than seconds earlier. The
# marker-block tables are not part of that bet at all: `marker tables` covers
# those, needs no program, and still runs on every push at 4s.
astatus=0
eval "$cmd_autogen --fix-stale --skip-whole-repo-program $autogen_flags" \
  >"$tmp/autogen.log" 2>&1 || astatus=$?
if [ "$astatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm autogen failed" >&2
  cat "$tmp/autogen.log" >&2
  status=$astatus
fi

# The two ratcheted lists inside check-docs that DO have a write mode, run as
# writers before check-docs reads them with --check. A grown list is still a
# regression and the banner below says which line grew — but the news is in the
# diff either way, and the version that blocked here only made someone run the
# writer by hand and push again. ~0.1s each.
#
# The rest of check-docs has no writer at all, so this is the whole of what can
# be healed there.
for ratchet in \
  check-remote-hosts:website/scripts/third-party-hosts.txt \
  check-captions:website/scripts/long-captions.txt; do
  script=website/scripts/${ratchet%%:*}.ts
  list=${ratchet#*:}
  cp "$list" "$tmp/ratchet.before" 2>/dev/null || : >"$tmp/ratchet.before"
  node "$script" >/dev/null 2>&1 || true
  added=$(diff "$tmp/ratchet.before" "$list" 2>/dev/null |
    sed -n 's/^> \([^#]\)/  \1/p' || true)
  if [ -n "$added" ]; then
    echo >&2
    echo "pre-push: $list grew — recorded, not blocked:" >&2
    printf '%s\n' "$added" >&2
    echo "Removing a line is the win; $script says what that takes." >&2
    echo >&2
  fi
done

# check-docs has no fixer and reads only what autogen has now finished writing,
# so it is the one thing that can overlap the linters.
eval "$cmd_check_docs" >"$tmp/docs.log" 2>&1 &
docs_pid=$!

# Both linters, because they catch different things and CI runs both: oxlint is
# the fast pass, `lint:eslint` the backstop for the react-compiler and
# import/unicorn rules oxlint has no equivalent for. The 2026-08-13 batch was
# entirely eslint-only rules, so oxlint alone would have caught none of it.
#
# `--fix` still exits nonzero for anything it could not fix, so this is one pass
# and not a fix-then-verify pair.
lstatus=0
eval "$cmd_lint --fix" >"$tmp/lint.log" 2>&1 || lstatus=$?
if [ "$lstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm lint --fix left errors it cannot fix" >&2
  cat "$tmp/lint.log" >&2
  status=$lstatus
fi

#
# `--cache` on the eslint half only, and only here: it keys on each file's
# content and the config's mtime, so a push re-lints what changed and reads the
# rest out of the cache — 127s to 9s on this tree. CI gets a fresh checkout
# every time and would only pay to write a cache nothing reads, which is why the
# flag is on this line rather than in the script.
estatus=0
eval "$cmd_lint_eslint --fix --cache --cache-location node_modules/.cache/eslint/" \
  >"$tmp/eslint.log" 2>&1 || estatus=$?
if [ "$estatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm lint:eslint --fix left errors it cannot fix" >&2
  cat "$tmp/eslint.log" >&2
  status=$estatus
fi

# Format LAST, so it has the final say over whatever the two `--fix` passes
# rewrote. `--fix` is repo-wide, not range-scoped, and it emits formatter-
# hostile code: eslint's fixes to two bench files went in as `if (x) {y += z}`
# on one line and a prefer-template fix with a line break inside the `${`.
#
# WHOLE-TREE, AND UNSCOPED ON PURPOSE — which is worth stating because a scoped
# `pnpm format <paths>` looks like the careful version and is not. Two reasons:
#
#   - Neither formatter touches a file it would not change. Measured
#     2026-08-14: `oxfmt` on an already-formatted file leaves its mtime alone,
#     and so does the `postformat` prettier pass over the .astro files. So the
#     set this rewrites IS the set that is mis-formatted — the same set a scope
#     is trying to approximate, arrived at exactly instead of by guessing.
#   - Any scope narrower than the tree leaves the files a fixer just touched
#     unformatted, since `--fix` ranges over the whole repo and the push does
#     not. The first version of this scoped to the pushed paths and shipped
#     both bench files above.
#
# It also stands in for CI's `Format` job (`pnpm check-format`, push.yml),
# which nothing here covered before: after this runs, that job is satisfied by
# construction rather than checked. ~7s for 6300 files.
fstatus=0
eval "$cmd_format" >"$tmp/format.log" 2>&1 || fstatus=$?
if [ "$fstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm format failed" >&2
  cat "$tmp/format.log" >&2
  status=$fstatus
fi

# --- gates, no fixer --------------------------------------------------------

dstatus=0
wait "$docs_pid" || dstatus=$?
if [ "$dstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm check-docs failed" >&2
  cat "$tmp/docs.log" >&2
  status=$dstatus
fi

# The diagram lock is the one generated artifact autogen does not own (its
# rewrite half needs graphviz), and CI runs this check first in the generated
# job, so a stale lock hides every autogen answer behind it. Reads two files.
gstatus=0
eval "$cmd_diagrams_check" >"$tmp/diagrams.log" 2>&1 || gstatus=$?
if [ "$gstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm diagrams:check failed" >&2
  cat "$tmp/diagrams.log" >&2
  status=$gstatus
fi

# `tsc --noEmit` (what `pnpm typecheck` runs) does NOT stand in for this. That
# reads the root tsconfig, where node types are present and every file is in
# scope; the ESM build reads each package's own config, which has neither. A
# file can typecheck cleanly and still fail the build — a node-only helper
# compiled as browser source is exactly how main broke on 2026-08-13. It runs
# last because it compiles what the fixers have just rewritten.
bstatus=0
eval "$cmd_build_esm" >"$tmp/build.log" 2>&1 || bstatus=$?
if [ "$bstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm build:esm failed" >&2
  cat "$tmp/build.log" >&2
  status=$bstatus
fi

# --- commit and push what the fixers changed --------------------------------

changed=$(changed_since "$tmp/before")

# Split it: what the fixers wrote over a clean path is theirs to commit, what
# they wrote over an already-dirty one belongs to whoever was editing it.
auto=
manual=
oldifs=$IFS
IFS='
'
for f in $changed; do
  if grep -Fxq -- "$f" "$tmp/dirty-before" 2>/dev/null; then
    manual=$manual$f'
'
  else
    auto=$auto$f'
'
  fi
done
IFS=$oldifs

# Committing needs somewhere to commit to: the autoheal writes onto HEAD, which
# is only the right place when HEAD is what is being pushed. A push of some
# other branch, a detached HEAD, or several refs at once falls back to
# reporting.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
one_ref=$(printf '%s' "$refspecs" | grep -c . || true)
if [ -z "$branch" ] || [ "$one_ref" != 1 ] ||
  [ "$refspecs" != "refs/heads/$branch:refs/heads/$branch
" ]; then
  manual=$manual$auto
  auto=
fi

if [ -n "$auto" ]; then
  printf 'chore: pre-push autofix\n\nRegenerated by .githooks/pre-push while pushing:\n\n' \
    >"$tmp/msg"
  printf '%s' "$auto" | sed 's/^/  /' >>"$tmp/msg"
  # Pathspec commit: the index may hold someone else's staged work, and this
  # commit is about these paths only. --no-verify because pre-commit's formatter
  # has already run over everything here, via `pnpm format` above.
  printf '%s' "$auto" | tr '\n' '\0' |
    xargs -0 git commit --quiet --no-verify -F "$tmp/msg" -- >&2
  echo >&2
  echo "pre-push: committed what the fixers changed:" >&2
  printf '%s' "$auto" | sed 's/^/  /' >&2
fi

if [ -n "$manual" ]; then
  echo >&2
  echo "pre-push: the fixers also rewrote files that were already modified:" >&2
  printf '%s' "$manual" | sed 's/^/  /' >&2
  echo >&2
  echo "Those are left alone — a fixer rewriting your unfinished edit is not a" >&2
  echo "commit this hook gets to write. Sort them out and push again." >&2
  exit 1
fi

if [ "$status" != 0 ]; then
  echo >&2
  echo "Push blocked. Fix the above, or push anyway with SKIP_DOCS_CHECK=1." >&2
  exit "$status"
fi

# Nothing was fixed, so the commits on their way out are already clean and the
# push git is holding is the right one. Let it go.
if [ -z "$auto" ]; then
  exit 0
fi

# Something was fixed and is now committed, which the outer push cannot know —
# it resolved its commit before this hook started. Push the new tip here.
pstatus=0
git push --no-verify "$remote" "refs/heads/$branch:refs/heads/$branch" >&2 || pstatus=$?

echo >&2
if [ "$pstatus" = 0 ]; then
  echo "pre-push: pushed that commit to $remote/$branch, so your work HAS landed." >&2
  echo "The 'failed to push some refs' git prints next is the push it was already" >&2
  echo "holding, which now points at an older commit than the remote does. Nothing" >&2
  echo "to do — 'git status' will say you are up to date." >&2
else
  echo "pre-push: the fixes are committed, but pushing them failed (above)." >&2
  echo "Push again once that is sorted." >&2
fi
exit 1
