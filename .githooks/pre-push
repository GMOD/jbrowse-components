#!/bin/sh
# Runs the CI gates that nothing else here runs — docs, generated artifacts,
# lint, format and the ESM build — over what you are about to push, so main does
# not go red on something a local check would have caught. `pnpm install` points
# core.hooksPath here; skip with SKIP_DOCS_CHECK=1 or `git push --no-verify`.
#
# IT FIXES RATHER THAN REPORTS. Three of the five gates have an autofixer, so
# this runs the fixer: `pnpm autogen` (not `--check`), both linters with
# `--fix`, and `pnpm format` over the pushed paths. Reporting "regenerate and
# commit" only to have the person run the exact command the hook already knew
# was ~2min of waiting to be told to wait ~2min more.
#
# WHICH MEANS IT BLOCKS THE PUSH WHEN IT FIXES SOMETHING. The fixes land in the
# working tree, not in the commits on their way out, so a push that went ahead
# would push exactly the state that just failed. When the tree changes the hook
# says which files and exits nonzero; commit them and push again, and the second
# run is clean. Nothing is auto-committed — what to commit, and in which of the
# several commits being pushed it belongs, is not the hook's call.
#
# WHAT STILL ONLY REPORTS: `check-docs` and `build:esm` have no fixer, and
# `--fix` on either linter leaves whatever rule has no autofix. Those are still
# yours to fix by hand.
#
# CI's `Format` job has no counterpart here and does not need one: the format
# step below runs over the whole tree, so `pnpm check-format` is satisfied by
# construction rather than checked.
#
# WHY PRE-PUSH AND NOT PRE-COMMIT. All of them read the whole tree — there is
# no staged-paths version of "is this generated artifact current", because the
# artifact is a function of every source that feeds it. At ~45s that is far too
# slow per commit and about right per push, which is also the moment the cost
# lands on other people rather than on you.
#
# WHAT IT COSTS. Measured warm on this tree (docs/autogen 2026-08-10, the rest
# 2026-08-13):
#   pnpm check-docs         43.1s
#   pnpm autogen            33.9s
#   pnpm lint:eslint        29s
#   pnpm lint                7s
#   pnpm format              7s whole tree, 6309 files
#   pnpm build:esm           1s incremental
# ~115s wall measured, not the ~45s the sum of the long pole would suggest:
# they are all CPU-bound and this machine runs several agents, so they contend
# rather than overlap. Budget two minutes.
#
# THE FIXERS RUN IN SEQUENCE, unlike the old all-parallel version, because they
# write to the same files: autogen emits sources the linters then lint, and both
# linters rewrite the same `.ts`. Only the two read-only gates still overlap.
# That costs nothing in wall time — contention was eating the parallelism
# anyway.
#
# A COLD `build:esm` is worse and happens once per checkout — tsc has no
# .tsbuildinfo to reuse and takes minutes. Every run after that is the 1s above.
#
# WHY IT EARNS THE 45s. On 2026-08-10 the first two gates went red on main four
# separate times in one day, every time because a figure or docs commit landed
# without its regeneration. On 2026-08-13 the other three were found red on main
# ALL AT ONCE, having drifted unseen for two days: 11 eslint errors across
# several authors (oldest two days old), check-config-read-types up 147 -> 148,
# and `build:esm` broken that morning by a node-only test helper compiled into
# the browser bundle. None of it was visible to anyone, because work lands
# locally here and these gates only ran on push — and main had not been pushed.
# Every one was a one-line fix at the moment it landed.
#
# IT READS THE WORKING TREE, NOT THE COMMITS BEING PUSHED. Every command here
# answers its question against the files on disk, so pushing from the
# SHARED primary checkout reports on whatever else is uncommitted there — the
# first push after this landed was told `config/model/api docs` was stale, which
# was six model docs another agent had regenerated and not yet committed, not
# anything in the push. Push from your own worktree and the question is about
# your work. There is no cheap fix: checking the pushed commits instead means
# materialising them somewhere clean, which costs more than the check.
#
# NOW THAT IT WRITES, that same property has teeth: from the shared checkout the
# fixers rewrite whatever else is uncommitted there, and the "these files
# changed" list at the end will name another agent's work alongside yours. One
# more reason to push from your own worktree.
set -eu

if [ "${SKIP_DOCS_CHECK:-}" = 1 ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: no pnpm, skipping docs checks" >&2
  exit 0
fi

# stdin is one `<local ref> <local sha> <remote ref> <remote sha>` line per ref.
# A zero local sha is a branch deletion (nothing to check); a zero remote sha is
# a branch the remote has never seen, so bound the range by what the remote
# already has rather than walking to the root commit.
zero=0000000000000000000000000000000000000000
range_files=
found=
while read -r _localref localsha _remoteref remotesha; do
  [ "$localsha" = "$zero" ] && continue
  found=1
  if [ "$remotesha" = "$zero" ]; then
    files=$(git diff --name-only "$(git merge-base "$localsha" HEAD@{upstream} 2>/dev/null || echo "$localsha^")" "$localsha" 2>/dev/null || true)
  else
    files=$(git diff --name-only "$remotesha" "$localsha" 2>/dev/null || true)
  fi
  range_files=$range_files$files'
'
done

# No refs on stdin (a hook run by hand) means check anyway rather than silently
# passing; nothing to push at all means nothing to check.
if [ -z "$found" ]; then
  exit 0
fi
if [ -z "$(printf '%s' "$range_files" | tr -d '[:space:]')" ]; then
  exit 0
fi

# The sources these artifacts are generated FROM. Deliberately broad — model and
# config docs come out of plugin and package sources, so a push touching only
# code can still leave a doc table stale. A push that is purely CI config or
# editor settings matches nothing here and skips.
if ! printf '%s' "$range_files" | grep -Eq \
  '^(website/|products/|plugins/|packages/|agent-docs/|scripts/|figures\.lock)'; then
  exit 0
fi

echo "pre-push: regenerating docs and artifacts, fixing lint and format, building esm (~2min, SKIP_DOCS_CHECK=1 to skip)" >&2

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# What the tree looks like before the fixers touch it, so the end of the run can
# say what they changed. Names alone are not enough — a file already dirty stays
# one `M` line however much a fixer rewrites it — so pair the status with the
# per-file line counts, which do move.
tree_state() {
  git status --porcelain -uall
  git diff HEAD --numstat
}
tree_state >"$tmp/before" 2>/dev/null || true

# The two files a REVIEW APP writes, which no fixer here writes. The comparison
# above is a before/after over a ~2min window, so anything that changes during
# the run is attributed to the fixers — including a person filing verdicts in
# `pnpm review-screenshots-web` or `pnpm review-snapshots-web` in another
# window, which is a normal thing to be doing while a push runs. Blocking on
# those told someone their own half-finished review was a fixer's output and
# demanded they commit it mid-pass, which is neither true nor what they want.
#
# Narrow on purpose: these are verdict logs, written only by a human clicking,
# never derived from anything. Every other path stays blocking, because for
# every other path the attribution is right.
review_state='website/scripts/screenshot-review.json
products/jbrowse-web/browser-tests/snapshot-review.json'

# Paths that have changed since $1 was taken, so the end of the run can say
# what the fixers did.
changed_since() {
  tree_state >"$tmp/now" 2>/dev/null || true
  diff "$1" "$tmp/now" 2>/dev/null | sed -n 's/^[<>] //p' | awk '{print $NF}' |
    sort -u | grep -Fxv "$review_state" || true
}

status=0

# --- fixers, in sequence: each writes files the next one reads ---------------

# autogen only answers CI's question when this checkout's figures are the ones
# CI will have, and there are two ways for that to be false. Both produce a
# stale-artifact report about the figure corpus rather than about the push,
# which is the kind of false positive that gets a hook switched off.
#
#   - No corpora at all. They are gitignored, so a fresh worktree has none
#     (`pnpm figures:pull`, or the two symlinks in CLAUDE.md), and the
#     jbrowse-img doc and tutorial-thumb generators then report OUT OF DATE
#     rather than failing outright.
#   - Corpora ahead of figures.lock. A regen someone has not pushed yet is
#     invisible to git and to CI: CI pulls the lock's sources, derives the
#     committed thumb and agrees, while the same generators here derive from
#     the newer sources on disk and disagree. On a machine that shoots figures
#     this is the normal state, not the exception.
#
# `pnpm figures:check` settles the second in ~2s, which is worth it to keep the
# 34s answer trustworthy.
#
# When it is NOT trustworthy, drop the three generators that read a figure and
# regenerate the other fifteen — `--skip-figure-dependent`, which names what it
# skipped. Running them anyway would be worse than not running them: they would
# derive from the corpus on disk and write artifacts CI, deriving from the lock,
# disagrees with, and the hook would then ask for a commit that makes the drift
# permanent instead of local.
#
# The earlier version of this degraded the WHOLE run to an advisory `--check` in
# that case, and on a machine that shoots figures that is the normal state — so
# the regeneration this hook exists for almost never happened. Before that it
# skipped the check outright, and the very next push went out with gallery links
# and the model docs stale, neither of which reads a figure.
autogen_flags=
autogen_skipped=
if [ ! -d website/static/img ] || [ ! -d products/jbrowse-img/img ]; then
  autogen_skipped="no figure corpora on disk ('pnpm figures:pull' installs them)"
elif ! pnpm figures:check >"$tmp/figures.log" 2>&1; then
  autogen_skipped="figures on disk differ from figures.lock ('pnpm figures:check' says which)"
fi
if [ -n "$autogen_skipped" ]; then
  autogen_flags=--skip-figure-dependent
  echo "pre-push: skipping the figure-dependent generators, because $autogen_skipped" >&2
fi

astatus=0
pnpm autogen $autogen_flags >"$tmp/autogen.log" 2>&1 || astatus=$?
if [ "$astatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm autogen failed" >&2
  cat "$tmp/autogen.log" >&2
  status=$astatus
fi

# check-docs has no fixer and reads only what autogen has now finished writing,
# so it is the one thing that can overlap the linters.
pnpm check-docs >"$tmp/docs.log" 2>&1 &
docs_pid=$!

# Both linters, because they catch different things and CI runs both: oxlint is
# the fast pass, `lint:eslint` the backstop for the react-compiler and
# import/unicorn rules oxlint has no equivalent for. The 2026-08-13 batch was
# entirely eslint-only rules, so oxlint alone would have caught none of it.
#
# `--fix` still exits nonzero for anything it could not fix, so this is one pass
# and not a fix-then-verify pair.
lstatus=0
pnpm lint --fix >"$tmp/lint.log" 2>&1 || lstatus=$?
if [ "$lstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm lint --fix left errors it cannot fix" >&2
  cat "$tmp/lint.log" >&2
  status=$lstatus
fi

estatus=0
pnpm lint:eslint --fix >"$tmp/eslint.log" 2>&1 || estatus=$?
if [ "$estatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm lint:eslint --fix left errors it cannot fix" >&2
  cat "$tmp/eslint.log" >&2
  status=$estatus
fi

# Format LAST, so it has the final say over whatever the two `--fix` passes
# rewrote. `--fix` is repo-wide, not range-scoped, and it emits formatter-
# hostile code: eslint's fixes to two bench files went in as `if (x) {y += z}`
# on one line and a prefer-template fix with a line break inside the `${`.
#
# WHOLE-TREE, AND UNSCOPED ON PURPOSE — which is worth stating because a scoped
# `pnpm format <paths>` looks like the careful version and is not. Two reasons:
#
#   - Neither formatter touches a file it would not change. Measured
#     2026-08-14: `oxfmt` on an already-formatted file leaves its mtime alone,
#     and so does the `postformat` prettier pass over the .astro files. So the
#     set this rewrites IS the set that is mis-formatted — the same set a scope
#     is trying to approximate, arrived at exactly instead of by guessing.
#   - Any scope narrower than the tree leaves the files a fixer just touched
#     unformatted, since `--fix` ranges over the whole repo and the push does
#     not. The first version of this scoped to the pushed paths and shipped
#     both bench files above.
#
# It also stands in for CI's `Format` job (`pnpm check-format`, push.yml),
# which nothing here covered before: after this runs, that job is satisfied by
# construction rather than checked. ~7s for 6300 files.
fstatus=0
pnpm format >"$tmp/format.log" 2>&1 || fstatus=$?
if [ "$fstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm format failed" >&2
  cat "$tmp/format.log" >&2
  status=$fstatus
fi

# --- gates, no fixer --------------------------------------------------------

dstatus=0
wait "$docs_pid" || dstatus=$?
if [ "$dstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm check-docs failed" >&2
  cat "$tmp/docs.log" >&2
  status=$dstatus
fi

# `tsc --noEmit` (what `pnpm typecheck` runs) does NOT stand in for this. That
# reads the root tsconfig, where node types are present and every file is in
# scope; the ESM build reads each package's own config, which has neither. A
# file can typecheck cleanly and still fail the build — a node-only helper
# compiled as browser source is exactly how main broke on 2026-08-13. It runs
# last because it compiles what the fixers have just rewritten.
bstatus=0
pnpm build:esm >"$tmp/build.log" 2>&1 || bstatus=$?
if [ "$bstatus" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm build:esm failed" >&2
  cat "$tmp/build.log" >&2
  status=$bstatus
fi

# --- did the fixers change anything? ----------------------------------------

changed=$(changed_since "$tmp/before")

if [ -n "$changed" ]; then
  echo >&2
  echo "pre-push: the fixers changed these files:" >&2
  printf '%s\n' "$changed" | sed 's/^/  /' >&2
  echo >&2
  echo "Push blocked — the fixes are in the working tree, not in the commits" >&2
  echo "being pushed. Commit them and push again." >&2
  exit 1
fi

if [ "$status" != 0 ]; then
  echo >&2
  echo "Push blocked. Fix the above, or push anyway with SKIP_DOCS_CHECK=1." >&2
  exit "$status"
fi
