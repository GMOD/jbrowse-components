#!/bin/sh
# Runs `pnpm check-docs` and `pnpm autogen --check` over what you are about to
# push, so main does not go red on something a local check would have caught.
# `pnpm install` points core.hooksPath here; skip with SKIP_DOCS_CHECK=1 or
# `git push --no-verify`.
#
# WHY PRE-PUSH AND NOT PRE-COMMIT. Both commands read the whole tree — there is
# no staged-paths version of "is this generated artifact current", because the
# artifact is a function of every source that feeds it. At ~45s that is far too
# slow per commit and about right per push, which is also the moment the cost
# lands on other people rather than on you.
#
# WHAT IT COSTS. Measured 2026-08-10 on this tree, warm:
#   pnpm check-docs         43.1s
#   pnpm autogen --check    33.9s
# Run in parallel below, so ~45s wall. Against that, the CI jobs they stand in
# for take ~8 and ~4 minutes to report, and until someone fixes it main is red
# for everyone pulling.
#
# WHY IT EARNS THE 45s. On 2026-08-10 these two gates went red on main four
# separate times in one day, every time because a figure or docs commit landed
# without its regeneration: stale gallery links, an unpushed tutorial thumb, a
# jbrowse-img README whose CLI options had moved, three captions over the
# ratchet. Every one of them was already visible locally at commit time.
#
# IT READS THE WORKING TREE, NOT THE COMMITS BEING PUSHED. Both commands answer
# "is this artifact current" against the files on disk, so pushing from the
# SHARED primary checkout reports on whatever else is uncommitted there — the
# first push after this landed was told `config/model/api docs` was stale, which
# was six model docs another agent had regenerated and not yet committed, not
# anything in the push. Push from your own worktree and the question is about
# your work. There is no cheap fix: checking the pushed commits instead means
# materialising them somewhere clean, which costs more than the check.
set -eu

if [ "${SKIP_DOCS_CHECK:-}" = 1 ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "pre-push: no pnpm, skipping docs checks" >&2
  exit 0
fi

# stdin is one `<local ref> <local sha> <remote ref> <remote sha>` line per ref.
# A zero local sha is a branch deletion (nothing to check); a zero remote sha is
# a branch the remote has never seen, so bound the range by what the remote
# already has rather than walking to the root commit.
zero=0000000000000000000000000000000000000000
range_files=
found=
while read -r _localref localsha _remoteref remotesha; do
  [ "$localsha" = "$zero" ] && continue
  found=1
  if [ "$remotesha" = "$zero" ]; then
    files=$(git diff --name-only "$(git merge-base "$localsha" HEAD@{upstream} 2>/dev/null || echo "$localsha^")" "$localsha" 2>/dev/null || true)
  else
    files=$(git diff --name-only "$remotesha" "$localsha" 2>/dev/null || true)
  fi
  range_files=$range_files$files'
'
done

# No refs on stdin (a hook run by hand) means check anyway rather than silently
# passing; nothing to push at all means nothing to check.
if [ -z "$found" ]; then
  exit 0
fi
if [ -z "$(printf '%s' "$range_files" | tr -d '[:space:]')" ]; then
  exit 0
fi

# The sources these artifacts are generated FROM. Deliberately broad — model and
# config docs come out of plugin and package sources, so a push touching only
# code can still leave a doc table stale. A push that is purely CI config or
# editor settings matches nothing here and skips.
if ! printf '%s' "$range_files" | grep -Eq \
  '^(website/|products/|plugins/|packages/|agent-docs/|scripts/|figures\.lock)'; then
  exit 0
fi

echo "pre-push: checking docs and generated artifacts (~45s, SKIP_DOCS_CHECK=1 to skip)" >&2

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# In parallel: they share no state and each is single-digit-percent CPU-bound on
# the other's work. Output is buffered to files and replayed in a fixed order so
# two interleaved streams do not land on top of each other.
pnpm check-docs >"$tmp/docs.log" 2>&1 &
docs_pid=$!

# autogen only answers CI's question when this checkout's figures are the ones
# CI will have, and there are two ways for that to be false. Both produce a
# stale-artifact report about the figure corpus rather than about the push,
# which is the kind of false positive that gets a hook switched off.
#
#   - No corpora at all. They are gitignored, so a fresh worktree has none
#     (`pnpm figures:pull`, or the two symlinks in CLAUDE.md), and the
#     jbrowse-img doc and tutorial-thumb generators then report OUT OF DATE
#     rather than failing outright.
#   - Corpora ahead of figures.lock. A regen someone has not pushed yet is
#     invisible to git and to CI: CI pulls the lock's sources, derives the
#     committed thumb and agrees, while the same generators here derive from
#     the newer sources on disk and disagree. On a machine that shoots figures
#     this is the normal state, not the exception.
#
# `pnpm figures:check` settles the second in ~2s, which is worth it to keep the
# 34s answer trustworthy.
#
# When it is NOT trustworthy the check still runs, and reports without blocking.
# Skipping it outright was the first version of this and it was wrong: the very
# next push went out with gallery links and the model docs stale, neither of
# which reads a figure, because a corpus two thumbnails ahead of the lock had
# switched the whole 34s check off. An advisory report costs a push nothing and
# would have named both.
autogen_pid=
autogen_advisory=
if [ ! -d website/static/img ] || [ ! -d products/jbrowse-img/img ]; then
  autogen_advisory="no figure corpora on disk ('pnpm figures:pull' installs them)"
elif ! pnpm figures:check >"$tmp/figures.log" 2>&1; then
  autogen_advisory="figures on disk differ from figures.lock ('pnpm figures:check' says which)"
fi
pnpm autogen --check >"$tmp/autogen.log" 2>&1 &
autogen_pid=$!

status=0
wait "$docs_pid" || status=$?
if [ "$status" != 0 ]; then
  echo >&2
  echo "pre-push: pnpm check-docs failed" >&2
  cat "$tmp/docs.log" >&2
fi

astatus=0
wait "$autogen_pid" || astatus=$?
if [ "$astatus" != 0 ]; then
  echo >&2
  if [ -n "$autogen_advisory" ]; then
    # Advisory: this run cannot tell a genuinely stale artifact from one the
    # figure state faked, so it names both rather than blocking on either. The
    # figure-derived generators (jbrowse-img doc, tutorial card thumbnails,
    # homepage images) are the ones to discount; anything else in the list is
    # real and CI will fail on it.
    echo "pre-push: 'pnpm autogen --check' reported the following, NOT blocking" >&2
    echo "  because $autogen_advisory." >&2
    echo "  Discount the figure-derived generators; the rest are real." >&2
  else
    echo "pre-push: pnpm autogen --check failed — run 'pnpm autogen' and commit" >&2
    status=$astatus
  fi
  cat "$tmp/autogen.log" >&2
fi

if [ "$status" != 0 ]; then
  echo >&2
  echo "Push blocked. Fix the above, or push anyway with SKIP_DOCS_CHECK=1." >&2
  exit "$status"
fi
