#!/bin/sh
# Runs oxfmt and then oxlint over the files being committed, so `pnpm
# check-format` and `pnpm lint` in CI do not fail on something a three-second
# local check would have caught. `pnpm install` points core.hooksPath here;
# skip the format with `SKIP_OXFMT=1 git commit`, the lint with `SKIP_LINT=1`,
# and both with `git commit --no-verify`.
#
# Only the paths in this commit are formatted or linted. Bare `pnpm format`
# rewrites all ~5800 files, so in a worktree shared by several people it lands
# someone else's reformatting in your diff under your commit message; a
# whole-tree `pnpm lint` has the mirror problem, failing your commit for an
# error in someone else's unfinished work.
#
# WHAT IT COSTS, since that is what you want to know when a commit feels slow.
# Measured 2026-08-10 on real commits. Format: 105ms on 3 files, 305ms on 1,
# 663ms on 10, 819ms on 13. Lint is the larger half and nearly flat in file
# count -- almost all of it is tsgolint building the program, so: 0.80s on 1
# file, 0.89s on 3, 0.97s on 13. Call it a second, whatever you are committing.
#
# eslint is deliberately not here. `pnpm lint:eslint` is ~75s even with
# --concurrency, against the above, and it owns only the syntactic backstop
# rules. It stays a CI job.
set -eu

# The post-merge hook checks generated artifacts in the background after a land
# and leaves this behind when one is stale. Reporting it here costs a stat and
# reaches someone about to add to the same tree; it never blocks, since what it
# names is almost certainly not this commit's doing.
staleness=$(git rev-parse --git-common-dir)/autogen-stale
if [ -f "$staleness" ]; then
  echo >&2
  sed 's/^/pre-commit: /' "$staleness" >&2
  echo >&2
fi

# ---------------------------------------------------------------------------
# The config manifest is a contract, and until now only push checked the things
# that read it. `configManifest.generated.ts` holds the key set every authored
# view object is validated against, so a commit that REGENERATES it can
# invalidate configs it never touches -- and nothing local said so.
#
# That is how `showColorLegend` went on being written into ten demo configs,
# six build scripts and a test fixture after 3b7afee169 stopped it being
# settable. `pnpm check-docs` names every one of them, and check-docs runs at
# push, behind however many commits have queued up there.
#
# So it runs here on the commits that can cause it: 72 of the 6204 commits in
# the 30 days to 2026-09-07 touched the manifest, about one in eighty-five.
# Costs ~0.2s for the demo configs and ~3.8s for the build scripts, and nothing
# at all on a commit that leaves the manifest alone. A commit that only edits
# demo configs pays the 0.2s half. SKIP_CONFIG_CHECK=1 to skip.
# ---------------------------------------------------------------------------
if [ "${SKIP_CONFIG_CHECK:-}" != 1 ]; then
  croot=$(git rev-parse --show-toplevel)
  cached=$(git diff --cached --name-only --diff-filter=ACMR || true)
  manifest=products/jbrowse-cli/src/commands/validate/configManifest.generated.ts
  cstatus=0
  cout=

  if printf '%s\n' "$cached" | grep -qxF "$manifest"; then
    echo "pre-commit: the config manifest changed, so re-checking what reads it" >&2
    cout=$(node --experimental-strip-types "$croot/scripts/validate-built-config.ts" \
      --schema-only "$croot"/demos/*/config.json 2>&1) || cstatus=$?
    bout=$(python3 "$croot/scripts/check-build-scripts.py" 2>&1) || cstatus=$?
    cout="$cout
$bout"
  else
    demos=$(printf '%s\n' "$cached" | grep '^demos/.*/config\.json$' || true)
    if [ -n "$demos" ]; then
      cout=$(printf '%s\n' "$demos" | sed "s|^|$croot/|" | tr '\n' '\0' |
        xargs -0 node --experimental-strip-types \
          "$croot/scripts/validate-built-config.ts" --schema-only 2>&1) || cstatus=$?
    fi
  fi

  if [ "$cstatus" != 0 ]; then
    echo >&2
    printf '%s\n' "$cout" | grep -vE "^ok:|: ok — " >&2 || true
    echo >&2
    echo "pre-commit: the above read the config manifest and no longer validate." >&2
    echo "A regenerated manifest can invalidate a config this commit never" >&2
    echo "touched. Fix them, or commit anyway with SKIP_CONFIG_CHECK=1." >&2
    exit "$cstatus"
  fi
fi

if [ "${SKIP_OXFMT:-}" = 1 ]; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)
oxfmt=$root/node_modules/.bin/oxfmt
if [ ! -x "$oxfmt" ]; then
  echo "pre-commit: no $oxfmt, skipping format (run pnpm install)" >&2
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then
  exit 0
fi

# A file with unstaged edits cannot be formatted in place, because the `git add`
# afterwards would stage the rest of those edits too. Only its staged blob is
# formatted, further down.
#
# `git commit -- <paths>` commits the working tree at those paths through a
# temporary index, so nothing reads as unstaged there and every path gets
# formatted -- which is what that form is asking for.
dirty=$(git diff --name-only)

whole=
partial=
oldifs=$IFS
IFS='
'
for f in $staged; do
  if printf '%s\n' "$dirty" | grep -Fxq -- "$f"; then
    partial=$partial$f'
'
  else
    whole=$whole$f'
'
  fi
done
IFS=$oldifs

if [ -n "$whole" ]; then
  # oxfmt skips paths it has no formatter for, and --no-error-on-unmatched-
  # pattern keeps "everything you passed is in .prettierignore" from being an
  # error. Both are ordinary here: generated shader modules and agent-docs are
  # ignored, .astro belongs to prettier below.
  printf '%s' "$whole" | tr '\n' '\0' |
    xargs -0 "$oxfmt" --no-error-on-unmatched-pattern --write
  printf '%s' "$whole" | tr '\n' '\0' | xargs -0 git add --

  astro=$(printf '%s' "$whole" | grep '\.astro$' || true)
  if [ -n "$astro" ] && [ -x "$root/node_modules/.bin/prettier" ]; then
    printf '%s' "$astro" | tr '\n' '\0' |
      xargs -0 "$root/node_modules/.bin/prettier" --write --
    printf '%s' "$astro" | tr '\n' '\0' | xargs -0 git add --
  fi
fi

if [ -n "$partial" ]; then
  # The staged blob is formatted and written back to the index on its own, which
  # leaves the working copy and its unstaged edits alone. --stdin-filepath
  # applies that path's ignore rules and echoes the input back unchanged when it
  # is ignored, so an ignored file is never rewritten; it exits non-zero for a
  # path it cannot format and for one that does not parse, and both of those are
  # left exactly as staged.
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  fixed=
  IFS='
'
  for f in $partial; do
    git show ":$f" >"$tmp/staged"
    if ! "$oxfmt" --stdin-filepath "$f" <"$tmp/staged" >"$tmp/formatted" 2>/dev/null; then
      continue
    fi
    if cmp -s "$tmp/staged" "$tmp/formatted"; then
      continue
    fi
    if [ ! -s "$tmp/formatted" ] && [ -s "$tmp/staged" ]; then
      continue
    fi
    mode=$(git ls-files --stage -- "$f" | cut -d' ' -f1)
    blob=$(git hash-object -w --stdin <"$tmp/formatted")
    git update-index --cacheinfo "$mode,$blob,$f"
    fixed=$fixed'  '$f'
'
  done
  IFS=$oldifs

  if [ -n "$fixed" ]; then
    echo "pre-commit: formatted what is being committed of, but not the working" >&2
    echo "copy of (these have unstaged edits as well):" >&2
    printf '%s' "$fixed" >&2
  fi
fi

# ---------------------------------------------------------------------------
# Lint. Only the fully-staged paths: a partially-staged file's working copy is
# not what is being committed, so an error in the unstaged half would block a
# commit that does not contain it. Those are rare and CI still covers them.
#
# --type-aware because that is the tier that catches what actually reaches main
# -- no-confusing-void-expression, no-unnecessary-condition. It costs ~1.3s for
# two files against ~0.2s untyped, and ~8s for the whole tree, so paying it per
# commit is affordable and skipping it would miss the point.
#
# --fix first: this hook already rewrites your files, and most of what lands
# broken is autofixable. What survives the fix is a real block.
# ---------------------------------------------------------------------------
if [ "${SKIP_LINT:-}" = 1 ] || [ -z "$whole" ]; then
  exit 0
fi

oxlint=$root/node_modules/.bin/oxlint
if [ ! -x "$oxlint" ]; then
  echo "pre-commit: no $oxlint, skipping lint (run pnpm install)" >&2
  exit 0
fi

# --no-error-on-unmatched-pattern: a commit is mostly not JavaScript. Without
# it, oxlint exits 1 with "No files found to lint" on a docs-only commit, and
# every path it has no parser for -- .md, .json, .slang -- reads as unmatched.
status=0
printf '%s' "$whole" | tr '\n' '\0' |
  xargs -0 "$oxlint" --type-aware --deny-warnings \
    --no-error-on-unmatched-pattern --fix -- || status=$?

# oxlint's fixes are not formatted -- it rewrites an arrow shorthand as
# `() =>{  g(); }` and leaves it there. Format runs above this block, so
# without a second pass a commit could satisfy `pnpm lint` and then fail
# `pnpm check-format`, which is the failure this hook exists to prevent.
printf '%s' "$whole" | tr '\n' '\0' |
  xargs -0 "$oxfmt" --no-error-on-unmatched-pattern --write

# Stage whatever the two --fix passes rewrote, whether or not anything survived
# them, so a blocked commit is still strictly closer to green than it started.
printf '%s' "$whole" | tr '\n' '\0' | xargs -0 git add --

if [ "$status" != 0 ]; then
  echo >&2
  echo "pre-commit: lint errors above survived --fix (autofixes are staged)." >&2
  echo "Fix them, or commit anyway with SKIP_LINT=1 git commit." >&2
  exit "$status"
fi
