#!/bin/sh
# Answers "did that land leave main red" at the moment work actually enters main
# here, which is `git merge --ff-only`, not `git push`.
#
# WHICH GATES, and why these three. A generated artifact going stale is the
# oldest of the failures this catches and it is not the only one that lands
# unseen. On 2026-08-22 main took four separate breakages in a day and only two
# were artifacts: the others were a TS4058 in
# `products/jbrowse-web/src/sessionModel/index.ts` -- production code, invisible
# to `pnpm test` because jest strips types -- and an eslint error on git's
# `^{commit}` peel syntax. Neither had ANY local gate. pre-push does not run
# typecheck at all, and its `build:esm` compiles only what we publish, so it
# never reaches `products/`.
#
#   pnpm autogen --check    ~34s
#   pnpm typecheck           ~2s warm
#   pnpm lint                ~7s
#   pnpm lint:eslint         ~29s
#
# Typecheck warm is 2s (scripts/typecheck.ts measures it: 1.8s default, 2.3s at
# --checkers 1, against 45-60s cold), so the gate that caught the worst of that
# day costs a rounding error on a run that was already 34s. eslint is the
# expensive one and earns it by owning the syntactic guards oxlint cannot do,
# which is the class that reaches main without anyone noticing. oxlint is here
# despite pre-commit running it because pre-commit only ever sees the paths in
# ONE commit: a rule that fires on a file the commit did not touch -- a type
# argument that became redundant when someone changed the type elsewhere -- is
# invisible to it and lands. That is exactly what `mst-reflection.ts` did.
#
# WHY THIS EXISTS WHEN pre-push ALREADY CHECKS. It checks on push, and nothing
# here pushes: agents land with `git -C <primary-checkout> merge --ff-only`, so
# main accumulates red locally and the gate does not run until someone finally
# pushes -- at which point they are handed a 2min hook run and somebody else's
# breakage. pre-push's own header diagnosed this ("work lands locally here and
# these gates only ran on push") and then still only ran on push. This is the
# missing half.
#
# IT COSTS THE LANDER NOTHING. The checks are detached and run after the merge
# has already returned, so `git merge` is as fast as it was. Nothing here can
# fail a merge either -- post-merge runs after the fact and git ignores its exit
# status -- which is the right shape: a landed commit is not something to
# refuse, only something to report on.
#
# HOW YOU HEAR ABOUT IT. The background run leaves `autogen-stale` in the common
# git dir -- named for the check it started as, kept because that path is what
# pre-commit reaches for -- and pre-commit prints it on your next commit for the
# cost of one stat. That is deliberately not a terminal
# message from here: by the time the check finishes, the shell that ran the
# merge has moved on, and writing to its tty would land in the middle of
# whatever is there now.
#
# WHOSE DRIFT IT IS, which is the first thing anyone asks and what the message
# used to answer wrongly. It named the head it checked at, so a drift that had
# been sitting on main for twenty commits read as an accusation of whatever had
# just landed -- and the reader either believed it or went hunting through
# `git log -S` to find out otherwise. `autogen-stale-since` holds the head the
# nag FIRST fired at, so a persisting one can say how far back it goes and say
# outright that this land is not what staled it. The pair is cleared together,
# here on a clean check and nowhere else: `pnpm autogen` used to clear it, from
# when the marker reported artifacts alone, and kept doing so after typecheck
# and the linters joined -- a regenerate wiped a nag about a type error, and a
# filtered `pnpm autogen gallery` wiped one about anything. Leaving the anchor
# behind would age the next unrelated drift by this one's lifetime.
#
# READ-ONLY, because the primary checkout is shared. `--check`, `--noEmit` and a
# bare `lint:eslint` all report and write nothing, so this can never rewrite
# another agent's uncommitted work -- the hazard pre-push's header spends two
# paragraphs on, and the reason this does not just run the fixers. The one
# exception is tsc's `tsconfig.tsbuildinfo`, which is what makes the warm
# typecheck 2s rather than 45s: gitignored build state, not anyone's work, and
# the lock below keeps two of these from writing it at once. An agent running
# `pnpm typecheck` by hand IN THE PRIMARY CHECKOUT could still race it; agents
# work in worktrees, which have their own.
#
# WHAT IT CANNOT TELL APART. Every gate reads the working tree, so uncommitted
# source in the shared checkout counts toward the answer. A stale artifact it
# names may be another agent's in-flight edit rather than the land -- the
# marker says so rather than pretending otherwise.
set -eu

[ "${SKIP_AUTOGEN_CHECK:-}" = 1 ] && exit 0

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root"
command -v pnpm >/dev/null 2>&1 || exit 0

# A squash merge ($1 = 1) has no ORIG_HEAD range worth reading, and is not how
# anything lands here.
[ "${1:-0}" = 1 ] && exit 0

# What the merge brought in. No ORIG_HEAD means this was not a merge we can
# scope, so check anyway rather than silently passing.
range=$(git diff --name-only ORIG_HEAD HEAD 2>/dev/null || true)
if [ -n "$range" ]; then
  # The sources the generated artifacts come out of, same broad set pre-push
  # uses: model and config docs are derived from plugin and package sources, so
  # a land touching only code can still leave a doc table stale. A land that is
  # purely CI config matches nothing and skips.
  printf '%s' "$range" | grep -Eq \
    '^(website/|products/|plugins/|packages/|agent-docs/|scripts/|figures\.lock)' ||
    exit 0
fi

common=$(git rev-parse --git-common-dir)
marker=$common/autogen-stale
# The head the check FIRST failed at, kept across lands so a persisting
# staleness can say how old it is instead of restamping itself onto whatever
# landed most recently. Cleared with the marker.
since=$common/autogen-stale-since
lock=$common/autogen-check.lock

# One check at a time. Several agents landing in the same minute would otherwise
# each start a 34s run, and they would all reach the same answer. mkdir is the
# atomic test-and-set; a lock older than 10 minutes is a crashed run, not a live
# one.
if [ -d "$lock" ]; then
  if [ -z "$(find "$lock" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then
    exit 0
  fi
  rm -rf "$lock"
fi
mkdir "$lock" 2>/dev/null || exit 0

# Detached, so the merge returns now and this outlives the shell that ran it.
(
  trap 'rm -rf "$lock"' EXIT

  # The figure-dependent generators derive from the corpus on disk while CI
  # derives from figures.lock, so they answer a different question whenever the
  # two disagree -- which on a machine that shoots figures is the normal state,
  # not the exception. Drop those rather than report a difference that is
  # about the corpus. Same reasoning, and the same two cases, as pre-push.
  flags=
  if [ ! -d website/static/img ] || [ ! -d products/jbrowse-img/img ] ||
    ! pnpm figures:check >/dev/null 2>&1; then
    flags=--skip-figure-dependent
  fi

  out=$(pnpm autogen --check $flags 2>&1) && agen=0 || agen=$?
  # 2s warm, and the only gate here that sees a type error in `products/`.
  tsc=$(pnpm typecheck 2>&1) && tsc_status=0 || tsc_status=$?
  # No --fix, unlike pre-push's copy: that one runs on your own push, this one
  # against a checkout other agents have open.
  esl=$(pnpm lint:eslint 2>&1) && esl_status=0 || esl_status=$?
  oxl=$(pnpm lint 2>&1) && oxl_status=0 || oxl_status=$?

  if [ "$agen" = 0 ] && [ "$tsc_status" = 0 ] && [ "$esl_status" = 0 ] &&
    [ "$oxl_status" = 0 ]; then
    rm -f "$marker" "$since"
  else
    head=$(git rev-parse --short HEAD)

    # How long this has been failing. The previous head is kept only while the
    # marker is; a first failure records this one. Not "which commit staled the
    # artifact" -- nothing here can know that -- but it is the difference
    # between a drift this land introduced and one it merely re-reported, which
    # is the first thing a reader needs and the message used to get wrong by
    # stamping the current head either way.
    first=
    if [ -f "$marker" ] && [ -f "$since" ]; then
      first=$(cat "$since" 2>/dev/null || true)
      # A rewritten or pruned history leaves a ref that no longer describes
      # this branch; start over rather than report against it.
      git merge-base --is-ancestor "$first" HEAD 2>/dev/null || first=
    fi
    if [ -z "$first" ]; then
      first=$head
      printf '%s\n' "$head" >"$since" 2>/dev/null || true
    fi

    # `if`, not `[ ... ] && x=y`: under `set -e` a false test makes the list
    # return 1 and would take this subshell with it, losing the marker.
    failed=
    if [ "$agen" != 0 ]; then
      failed="${failed:+$failed, }a stale generated artifact"
    fi
    if [ "$tsc_status" != 0 ]; then
      failed="${failed:+$failed, }typecheck"
    fi
    if [ "$esl_status" != 0 ]; then
      failed="${failed:+$failed, }eslint"
    fi
    if [ "$oxl_status" != 0 ]; then
      failed="${failed:+$failed, }oxlint"
    fi

    {
      if [ "$first" = "$head" ]; then
        echo "main is red on $failed, first seen at $head (this land)."
      else
        behind=$(git rev-list --count "$first..HEAD" 2>/dev/null || echo '?')
        echo "main has been red since $first, $behind commit(s) back."
        echo "Now failing: $failed."
        echo "$head is where it was last re-checked, NOT what broke it."
      fi
      echo
      echo "(Every gate reads the working tree, so what one names below may be"
      echo "an uncommitted edit rather than the commit that landed.)"
      # Naming the count is the difference between "suspect the land" and
      # "suspect whoever is editing here": typecheck and eslint see in-flight
      # source that `autogen --check` mostly did not, so a dirty checkout is now
      # the first thing to rule out rather than a footnote.
      dirty=$(git status --porcelain 2>/dev/null | grep -c '^' || true)
      if [ "${dirty:-0}" != 0 ]; then
        echo "This checkout has $dirty uncommitted path(s). Rule those out first."
      fi
      echo
      if [ "$agen" != 0 ]; then
        echo "Fix the artifact: pnpm autogen, then commit what it writes."
        echo
        # A crashed generator's diagnostic is inline, above the summary that
        # names it -- so that case takes a window, and only the stale case takes
        # the filter below, which would drop exactly that diagnostic.
        #
        # The filter is anchored on the summary block rather than written as "not
        # the passing lines": every generator words its own success differently
        # ("up to date", "match their source", ": up to date"), so excluding them
        # is a list that grows quietly, while the summary is one line the runner
        # itself writes and already names every stale artifact. Anything earlier
        # saying "out of date" comes along, since that is where the path and the
        # per-checker fix live. This used to be `grep -A20`, which pulled in
        # twenty lines of other checkers reporting success.
        if printf '%s\n' "$out" | grep -q 'did not run to completion'; then
          printf '%s\n' "$out" | tail -40
        else
          summary=$(printf '%s\n' "$out" | awk '
            /generated artifact\(s\) out of date/ { tail = 1 }
            tail { print; next }
            /out of date/ { print }')
          # An output shape neither branch recognizes is still worth showing.
          if [ -n "$summary" ]; then
            printf '%s\n' "$summary"
          else
            printf '%s\n' "$out" | tail -20
          fi
        fi
        echo
        echo "To find what staled one: git log -1 -- <its path> is the last"
        echo "regeneration, and the commits touching its inputs since then are"
        echo "the suspects."
        echo
      fi

      # Both of these print their own file:line, so they are quoted rather
      # than summarized -- there is no per-checker fix line to dig out the
      # way there is for a stale artifact, and the error IS the instruction.
      if [ "$tsc_status" != 0 ]; then
        echo "Typecheck. A green \`pnpm test\` says nothing about this --"
        echo "jest strips types -- and \`build:esm\` compiles only what we"
        echo "publish, so it never reaches products/."
        printf '%s\n' "$tsc" | grep -E 'error TS' | head -20 || true
        echo
      fi

      if [ "$esl_status" != 0 ]; then
        echo "eslint, which owns the guards oxlint cannot do."
        printf '%s\n' "$esl" | grep -E '^/|error ' | head -20 || true
        echo
      fi

      if [ "$oxl_status" != 0 ]; then
        echo "oxlint. pre-commit runs it too, but only over the paths in one"
        echo "commit -- this is the whole tree, where a rule can fire on a file"
        echo "nobody touched."
        printf '%s\n' "$oxl" | grep -E 'error' | head -20 || true
        echo
      fi
    } >"$marker" 2>/dev/null || true
  fi
) </dev/null >/dev/null 2>&1 &

exit 0
