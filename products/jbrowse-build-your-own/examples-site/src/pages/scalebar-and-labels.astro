---
import ScalebarAndGridlines from '../examples/ScalebarAndGridlines.tsx'
import ScalebarAndGridlinesCode from '../examples/ScalebarAndGridlines.tsx?raw'
import TrackLabels from '../examples/TrackLabels.tsx'
import TrackLabelsCode from '../examples/TrackLabels.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('scalebar-and-labels')
const scalebar = section(page, 'scalebar')
const trackLabels = section(page, 'track-labels')
---

<Layout page={page}>
  <Section {...scalebar} code={ScalebarAndGridlinesCode}>
    <ScalebarAndGridlines client:only="react" />
  </Section>
  <Section {...trackLabels} code={TrackLabelsCode}>
    <TrackLabels client:only="react" />
  </Section>
</Layout>
