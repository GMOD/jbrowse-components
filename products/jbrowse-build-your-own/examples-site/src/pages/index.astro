---
import PanAndZoom from '../examples/PanAndZoom.tsx'
import { examples } from '../examples.ts'
import Gallery from '../layouts/Gallery.astro'
import Shell from '../layouts/Shell.astro'
import { componentLabel, mainMaxWidth } from '../siteMeta.ts'
// Measured, not asserted. `pnpm measure-chrome-bundle` bundles both chrome
// entry points for real and writes this file; CI re-checks it, so the figures
// below cannot drift from what the code costs. `~repo` is the repo root, see
// astro.config.mjs -- and because it is a typed JSON import, a renamed field
// fails `astro check` instead of rendering "undefined KB".
import bundle from '~repo/scripts/chromeBundleSizes.json'

const base = import.meta.env.BASE_URL
---

<Shell
  title="Build your own"
  componentLabel={componentLabel}
  examples={examples}
  mainMaxWidth={mainMaxWidth}
>
  <h1>Build your own genome browser</h1>
  <p class="lead">
    JBrowse's engine — assemblies, adapters, workers, coordinates — with your own
    UI around it. Drag to pan; ctrl + wheel to zoom.
  </p>

  {/*
    The example runs here rather than being described, and it runs in the mode
    it documents for exactly this situation: `scrollZoom` off, because a bare
    wheel that zoomed would swallow the page scroll of the reader on their way
    down to the gallery. The checkbox in it turns the other mode on.
  */}
  <div class="demo"><PanAndZoom client:only="react" scrollZoom={false} /></div>

  <p class="note">
    That is the <a href={`${base}pan-and-zoom/`}>Pan and zoom</a> example, running
    its own source. Every page below adds one thing to it.
  </p>
  <p class="note">
    None of them render any Material UI. The chrome around a track — its loading,
    error and too-large states, the controls in its corner — is <strong
      >{bundle.plainGzipKb} KB gzipped</strong
    > with plain components, {bundle.muiGzipKb} KB with Material ones.
  </p>

  <Gallery examples={examples} />
</Shell>

<style>
  .note {
    color: var(--muted);
    max-width: 75ch;
    margin: 12px 0 0;
  }
</style>
