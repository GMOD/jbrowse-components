---
import ScalebarAndGridlines from '../examples/ScalebarAndGridlines.tsx'
import Demo from '../layouts/Demo.astro'
import Gallery from '../layouts/Gallery.astro'
import Shell from '../layouts/Shell.astro'
import { landingDemo } from '../siteMeta.ts'
---

<Shell title="Build your own">
  <h1>Build your own genome browser</h1>
  <p class="lead">
    Each example mounts JBrowse tracks in a React component and builds the
    controls around them from <code>@jbrowse/display-ui/embed</code> and plain
    HTML. For the same tracks inside the complete
    <code>JBrowseLinearGenomeView</code> component, see the{' '}
    <a href="https://jbrowse.org/storybook/lgv/">Linear Genome View examples</a>
    .
  </p>

  <Demo slug={landingDemo}>
    <ScalebarAndGridlines client:only="react" />
  </Demo>

  <Gallery />
</Shell>
