---
import ScalebarAndGridlines from '../examples/ScalebarAndGridlines.tsx'
import { pages } from '../examples.ts'
import Gallery from '../layouts/Gallery.astro'
import Shell from '../layouts/Shell.astro'
import {
  componentLabel,
  demoHeights,
  landingDemo,
  mainMaxWidth,
} from '../siteMeta.ts'
---

<Shell
  title="Build your own"
  componentLabel={componentLabel}
  examples={pages}
  mainMaxWidth={mainMaxWidth}
>
  <h1>Build your own genome browser</h1>
  <p class="lead">
    JBrowse's engine, your own UI. For the same engine with its stock UI, see
    the{' '}
    <a href="https://jbrowse.org/storybook/lgv/">Linear Genome View examples</a>
    .
  </p>

  <div class="demo reserved" style={`min-height:${demoHeights[landingDemo]}px`}>
    <ScalebarAndGridlines client:only="react" />
  </div>

  <Gallery examples={pages} />
</Shell>
