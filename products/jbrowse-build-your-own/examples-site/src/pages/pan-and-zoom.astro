---
import PanAndZoom from '../examples/PanAndZoom.tsx'
import PanAndZoomCode from '../examples/PanAndZoom.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('pan-and-zoom')
const sec = section(page, 'pan-and-zoom')
---

<Layout page={page}>
  <Section {...sec} code={PanAndZoomCode}>
    <PanAndZoom client:only="react" />
  </Section>
</Layout>
