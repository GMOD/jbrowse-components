---
import RunItInAWorker from '../examples/RunItInAWorker.tsx'
import RunItInAWorkerCode from '../examples/RunItInAWorker.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('web-workers')
const sec = section(page, 'run-it-in-a-worker')
---

<Layout page={page}>
  <Section {...sec} code={RunItInAWorkerCode}>
    <RunItInAWorker client:only="react" />
  </Section>
</Layout>
