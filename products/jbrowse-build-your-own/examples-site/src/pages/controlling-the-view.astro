---
import DriveItFromYourApp from '../examples/DriveItFromYourApp.tsx'
import DriveItFromYourAppCode from '../examples/DriveItFromYourApp.tsx?raw'
import EveryChromosome from '../examples/EveryChromosome.tsx'
import EveryChromosomeCode from '../examples/EveryChromosome.tsx?raw'
import YourOwnFeatureDetails from '../examples/YourOwnFeatureDetails.tsx'
import YourOwnFeatureDetailsCode from '../examples/YourOwnFeatureDetails.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('controlling-the-view')
const driveIt = section(page, 'drive-it-from-your-app')
const everyChromosome = section(page, 'every-chromosome')
const featureDetails = section(page, 'your-own-feature-details')
---

<Layout page={page}>
  <Section {...driveIt} code={DriveItFromYourAppCode}>
    <DriveItFromYourApp client:only="react" />
  </Section>
  <Section {...everyChromosome} code={EveryChromosomeCode}>
    <EveryChromosome client:only="react" />
  </Section>
  <Section {...featureDetails} code={YourOwnFeatureDetailsCode}>
    <YourOwnFeatureDetails client:only="react" />
  </Section>
</Layout>
