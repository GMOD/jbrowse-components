---
import ColorAndGroupByAField from '../examples/ColorAndGroupByAField.tsx'
import ColorAndGroupByAFieldCode from '../examples/ColorAndGroupByAField.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('color-and-group-by-a-field')
const sec = section(page, 'color-and-group-by-a-field')
---

<Layout page={page}>
  <Section {...sec} code={ColorAndGroupByAFieldCode}>
    <ColorAndGroupByAField client:only="react" />
  </Section>
</Layout>
