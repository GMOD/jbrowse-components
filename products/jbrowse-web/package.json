{
  "name": "@jbrowse/web",
  "version": "4.3.0",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": ".",
  "main": "build",
  "dir": "src",
  "exports": {
    "./testUtils": "./src/rootModel/test_util.ts",
    "./makeWorkerInstance": "./src/makeWorkerInstance.ts"
  },
  "scripts": {
    "start": "NODE_ENV=development node scripts/start.ts",
    "build": "NODE_ENV=production node scripts/build.ts",
    "prebuild": "rimraf build",
    "postbuild": "node -e \"fs.writeFileSync('build/version.txt',JSON.parse(require('fs').readFileSync('package.json', 'utf8')).version)\"",
    "prepack": "pnpm build",
    "test:browser": "node browser-tests/runner.ts",
    "test:browser:headed": "node browser-tests/runner.ts --headed",
    "test:browser:update": "node browser-tests/runner.ts --update-snapshots",
    "test:browser:compare": "node browser-tests/compare-backends.ts",
    "test:browser:gate": "node browser-tests/runner.ts --backend=all --swiftshader --gate-only",
    "test:browser:gate:ci": "node browser-tests/runner.ts --backend=all --skip-webgpu --swiftshader --gate-only --ci-gate",
    "review-snapshots-web": "node browser-tests/review-snapshots-web.ts",
    "snapshots": "node browser-tests/snapshots.ts",
    "snapshots:pull": "node browser-tests/snapshots.ts pull",
    "snapshots:push": "node browser-tests/snapshots.ts push"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@jbrowse/app-core": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/plugin-alignments": "workspace:^",
    "@jbrowse/plugin-arc": "workspace:^",
    "@jbrowse/plugin-authentication": "workspace:^",
    "@jbrowse/plugin-bed": "workspace:^",
    "@jbrowse/plugin-breakpoint-split-view": "workspace:^",
    "@jbrowse/plugin-canvas": "workspace:^",
    "@jbrowse/plugin-circular-view": "workspace:^",
    "@jbrowse/plugin-comparative-adapters": "workspace:^",
    "@jbrowse/plugin-config": "workspace:^",
    "@jbrowse/plugin-data-management": "workspace:^",
    "@jbrowse/plugin-dotplot-view": "workspace:^",
    "@jbrowse/plugin-gccontent": "workspace:^",
    "@jbrowse/plugin-gff3": "workspace:^",
    "@jbrowse/plugin-grid-bookmark": "workspace:^",
    "@jbrowse/plugin-gtf": "workspace:^",
    "@jbrowse/plugin-gwas": "workspace:^",
    "@jbrowse/plugin-hic": "workspace:^",
    "@jbrowse/plugin-jobs-management": "workspace:^",
    "@jbrowse/plugin-legacy-jbrowse": "workspace:^",
    "@jbrowse/plugin-linear-comparative-view": "workspace:^",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/plugin-maf": "workspace:^",
    "@jbrowse/plugin-menus": "workspace:^",
    "@jbrowse/plugin-rdf": "workspace:^",
    "@jbrowse/plugin-sequence": "workspace:^",
    "@jbrowse/plugin-spreadsheet-view": "workspace:^",
    "@jbrowse/plugin-sv-inspector": "workspace:^",
    "@jbrowse/plugin-trix": "workspace:^",
    "@jbrowse/plugin-variants": "workspace:^",
    "@jbrowse/plugin-wiggle": "workspace:^",
    "@jbrowse/product-core": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/web-core": "workspace:^",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "idb": "^8.0.3",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "private": true,
  "devDependencies": {
    "@jbrowse/add-track-core": "workspace:*",
    "@jbrowse/browser-test-utils": "workspace:*",
    "@jbrowse/cli": "workspace:*",
    "generic-filehandle2": "^2.4.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
