---
import { Code } from 'astro:components'

import Shell from './Shell.astro'
import { getPage, pages } from '~site/examples.ts'
import {
  componentLabel,
  demoFillHeight,
  demoHeights,
  mainMaxWidth,
} from '~site/siteMeta.ts'

import type { MarkdownInstance } from 'astro'

// One example page: the live demo (slotted in, so its React island hydrates in
// the page file), then src/docs/<slug>.md, then the demo's own source. The demo
// comes first because it is the argument and the prose annotates it. The slug
// is the page's own URL segment, so a page file cannot name another page.
const slug = Astro.url.pathname.split('/').findLast(Boolean) ?? ''
const page = getPage(slug)
const exampleFile = `${slug.replaceAll(/(?:^|-)(\w)/g, (_, c: string) => c.toUpperCase())}.tsx`

const sources = import.meta.glob<string>('~site/examples/*.tsx', {
  query: '?raw',
  import: 'default',
})
const loadSource = Object.entries(sources).find(([path]) =>
  path.endsWith(`/examples/${exampleFile}`),
)?.[1]
if (!loadSource) {
  throw new Error(`no src/examples/${exampleFile} for page "${slug}"`)
}
const code = await loadSource()
const sourceLines = code.trimEnd().split('\n').length

// held before the island mounts, so the prose below does not slide down
const reserved = demoHeights[slug]

const docs = import.meta.glob<MarkdownInstance<Record<string, unknown>>>(
  '~site/docs/*.md',
)
const loader = Object.entries(docs).find(([path]) =>
  path.endsWith(`/docs/${slug}.md`),
)?.[1]
const doc = loader ? await loader() : undefined
const Doc = doc?.Content
---

<Shell
  title={page.title}
  componentLabel={componentLabel}
  examples={pages}
  mainMaxWidth={mainMaxWidth}
>
  <h1>{page.title}</h1>
  <p class="lead">{page.description}</p>
  <section id={slug} class="example-section">
    <div
      class:list={['demo', { fill: demoFillHeight, reserved: !!reserved }]}
      style={reserved ? `min-height:${reserved}px` : undefined}
    >
      <slot />
    </div>
    {Doc && (
      <div class="doc">
        <Doc />
      </div>
    )}
    <details class="source">
      <summary>
        <span class="when-closed">Show</span>
        <span class="when-open">Hide</span>
        source · {sourceLines} lines
        <button type="button" class="copy-btn">
          Copy
        </button>
      </summary>
      <Code code={code} lang="tsx" />
    </details>
  </section>
</Shell>
