---
// Shared chrome for every product's examples-site (lgv / cgv / app). Each site
// symlinks src/layouts/Shell.astro to this file, so it must stay self-contained
// — NO relative imports (`astro check` resolves them from the symlink's own
// directory, not this file's real path, so they fail). All site-specific data
// arrives via props; the example shape is inlined for the same reason.
interface ExampleMeta {
  slug: string
  title: string
  group: string
  sections: { slug: string; title: string }[]
}

interface Props {
  title: string
  componentLabel: string
  examples: ExampleMeta[]
  mainMaxWidth?: string
}

const { title, componentLabel, examples, mainMaxWidth = '920px' } = Astro.props
const base = import.meta.env.BASE_URL
const docsHref = 'https://jbrowse.org/jb2/docs/embedded_components/'

// the three sibling examples-sites, cross-linked so a reader who lands on the
// wrong component can hop. the current one is matched off BASE_URL rather than
// threaded in as a prop, so adding a site here lights it up everywhere.
//
// The hrefs are absolute (https://jbrowse.org/...) rather than root-relative on
// purpose: CI link-checks each site alone, staging only that one under
// link-check/storybook/<prefix>, so a root-relative /storybook/cgv is a genuine
// dead link in that crawl root and fails the build. Absolute URLs are treated
// as external and skipped, and they're where these sites actually live.
const siblings = [
  { label: 'LGV', base: '/storybook/lgv/', title: 'Linear Genome View' },
  { label: 'CGV', base: '/storybook/cgv/', title: 'Circular Genome View' },
  { label: 'App', base: '/storybook/app/', title: 'Full React App' },
  { label: 'BYO', base: '/storybook/byo/', title: 'Build Your Own' },
]
const withSlash = (s: string) => (s.endsWith('/') ? s : `${s}/`)
const isSelf = (b: string) => withSlash(base) === b
const siteHref = (b: string) => `https://jbrowse.org${b}`

// highlight the current example in the sidebar by matching the URL, so pages
// don't need to thread their slug through
const trimSlash = (s: string) => s.replace(/\/+$/, '')
const here = trimSlash(Astro.url.pathname)
const isActive = (slug: string) => trimSlash(`${base}${slug}`) === here

// sidebar is grouped by each page's `group`, in first-appearance order (the
// pages list is already group-contiguous), mirroring the index Gallery
const groups = [...new Set(examples.map(e => e.group))]

// A multi-section page nests its sections under its own entry, expanded, with
// no disclosure to open — the page you are on is the one place the extra demos
// are worth a nav line, and a control that has to be clicked before it shows
// them is worse than the scroll it replaces.
//
// **Only the current page's, and that is the whole design.** Sections exist so
// several demos can share one sidebar entry (EXAMPLES_SITES.md, "Pages and
// groups"); rendering every page's would undo exactly that — the LGV site is 18
// pages and 44 sections, so its sidebar would go to 62 lines and the mechanism
// that keeps it short would be doing nothing. Nesting the current page's costs
// at most four.
//
// A single-section page nests nothing: its one section is the page, and the
// same rule already governs the "On this page" card in ExampleLayout.
const sectionLinks = (e: ExampleMeta) =>
  isActive(e.slug) && e.sections.length > 1 ? e.sections : []

// Which commit produced the page you are looking at. These sites deploy to a
// fixed, unversioned S3 prefix (/storybook/<site>/) behind CloudFront, so there
// is otherwise no way to tell a freshly-deployed page from a cached older one —
// which is the whole question when you push a fix and go check it live.
//
// `GITHUB_SHA` when CI built it, a local `git rev-parse` otherwise, and 'dev'
// when neither answers (a packed tarball or a sandbox with no git). Frontmatter
// runs in Node at build time, so `node:child_process` is available; it is a bare
// specifier, not a relative import, so it keeps this file self-contained the way
// the symlink requires.
let buildCommit = 'dev'
try {
  const { execSync } = await import('node:child_process')
  buildCommit = (
    process.env.GITHUB_SHA ??
    execSync('git rev-parse HEAD', {
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
    })
  )
    .trim()
    .slice(0, 7)
} catch {
  // no CI env and no git — 'dev' is the honest answer, and a missing stamp must
  // never fail the build
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
    <meta name="jbrowse-build-commit" content={buildCommit} />
    <title>{title} — JBrowse {componentLabel}</title>
    {/* apply the saved theme before first paint to avoid a flash */}
    <script is:inline>
      const saved = localStorage.getItem('jb-theme')
      if (saved === 'dark' || saved === 'light') {
        document.documentElement.dataset.theme = saved
      }
    </script>
    <style is:global>
      /*
        `color-scheme` tracks the palette below, and it is load-bearing rather
        than a nicety. The demos are copy-pasteable files, so they cannot reach
        for the custom properties on this page -- they style themselves with CSS
        *system* colours (`Canvas`, `CanvasText`, `color-mix` of the two), on the
        stated grounds that those read correctly on whatever host they are pasted
        into. Without this declaration they don't: `color-scheme` defaults to
        `normal`, system colours stay on the light palette whatever `data-theme`
        says, and `color-mix(in srgb, CanvasText 8%, Canvas)` paints a near-white
        box on a dark page while the text inside it inherits `--fg` and stays
        near-white too. That is a 1.0 contrast ratio, and it shipped: the
        notification on BYO's Loading and error states page -- the one thing that
        page exists to prove a host must draw -- was unreadable in dark mode.
        Declared in all three states for the same reason the palette is.
      */
      :root {
        color-scheme: light;
        --accent: #135ba8;
        --accent-fg: #ffffff;
        --bg: #ffffff;
        --fg: #1a1a1a;
        --fg-soft: #333333;
        --muted: #5a5a5a;
        --border: #e2e2e2;
        --rule: #eeeeee;
        --hover: #f1f5fa;
        --card-hover: #f5f9fd;
        --code-inline-bg: #f4f4f4;
        --sidebar-width: 260px;
        --topbar-h: 53px;
      }
      /* dark palette: explicit toggle wins; otherwise follow the OS setting */
      :root[data-theme='dark'] {
        color-scheme: dark;
        --accent: #6db3f2;
        --accent-fg: #10151b;
        --bg: #16191d;
        --fg: #e4e6e8;
        --fg-soft: #c6c9cd;
        --muted: #9aa0a6;
        --border: #2c3138;
        --rule: #262b31;
        --hover: #1e242b;
        --card-hover: #1e242b;
        --code-inline-bg: #23282f;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          color-scheme: dark;
          --accent: #6db3f2;
          --accent-fg: #10151b;
          --bg: #16191d;
          --fg: #e4e6e8;
          --fg-soft: #c6c9cd;
          --muted: #9aa0a6;
          --border: #2c3138;
          --rule: #262b31;
          --hover: #1e242b;
          --card-hover: #1e242b;
          --code-inline-bg: #23282f;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica,
          Arial, sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.55;
      }
      a {
        color: var(--accent);
      }
      header.topbar {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 20px;
        background: var(--bg);
        border-bottom: 1px solid var(--border);
      }
      header.topbar .brand {
        font-weight: 700;
        color: var(--fg);
        text-decoration: none;
        font-size: 1.05em;
      }
      header.topbar .brand span {
        color: var(--muted);
        font-weight: 400;
      }
      header.topbar nav {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 0.92em;
      }
      header.topbar nav a {
        text-decoration: none;
      }
      header.topbar nav a:hover {
        text-decoration: underline;
      }
      /* segmented lgv / cgv / app switcher */
      .siblings {
        display: inline-flex;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
      }
      .sibling {
        padding: 3px 10px;
        font-size: 0.9em;
        font-weight: 600;
        color: var(--muted);
        text-decoration: none;
      }
      .sibling + .sibling {
        border-left: 1px solid var(--border);
      }
      .sibling.current {
        color: var(--accent-fg);
        background: var(--accent);
      }
      header.topbar nav a.sibling:hover {
        background: var(--hover);
        text-decoration: none;
      }
      /* the deploy stamp: legible when you look for it, quiet when you don't */
      .build-commit {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.8em;
        color: var(--muted);
        opacity: 0.7;
      }
      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        padding: 0;
        font-size: 1em;
        line-height: 1;
        cursor: pointer;
        color: var(--fg);
        background: transparent;
        border: 1px solid var(--border);
        border-radius: 6px;
      }
      .theme-toggle:hover {
        background: var(--hover);
      }
      .layout {
        display: flex;
        align-items: flex-start;
      }
      /* mobile-only disclosure for the example list. hidden outright on
      desktop, where the sidebar is always open and a focusable-but-invisible
      control would be a keyboard trap */
      .nav-toggle-cb {
        display: none;
      }
      .nav-toggle-label {
        display: none;
      }
      aside.sidebar {
        flex: 0 0 var(--sidebar-width);
        width: var(--sidebar-width);
        position: sticky;
        top: var(--topbar-h);
        align-self: flex-start;
        height: calc(100vh - var(--topbar-h));
        overflow-y: auto;
        border-right: 1px solid var(--border);
        padding: 16px 12px 48px;
      }
      aside.sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
      }
      aside.sidebar .nav-group + .nav-group {
        margin-top: 6px;
      }
      aside.sidebar .nav-group-title {
        padding: 10px 8px 3px;
        font-size: 0.7em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted);
      }
      aside.sidebar a {
        display: block;
        padding: 2px 8px;
        color: inherit;
        text-decoration: none;
      }
      aside.sidebar a:hover {
        text-decoration: underline;
      }
      aside.sidebar a[aria-current='page'] {
        color: var(--accent);
        font-weight: bold;
      }
      /* the current page's sections. Indented against a rule rather than by
      padding alone, so a section title that wraps to two lines still reads as
      one entry under its page instead of as two entries. */
      aside.sidebar .nav-sections {
        margin: 2px 0 6px 8px;
        padding-left: 10px;
        border-left: 1px solid var(--border);
      }
      aside.sidebar .nav-sections a {
        font-size: 0.88em;
        color: var(--muted);
        line-height: 1.35;
        padding: 3px 6px;
      }
      aside.sidebar .nav-sections a:hover {
        color: var(--fg);
      }
      main {
        flex: 1 1 auto;
        min-width: 0;
        margin: 0 auto;
        padding: 24px 16px 80px;
      }
      h1 {
        margin-top: 0;
      }
      /* keep sticky-header-anchored jumps from hiding under the topbar */
      main [id] {
        scroll-margin-top: calc(var(--topbar-h) + 12px);
      }
      /* example-page chrome (ExampleLayout) */
      .lead {
        font-size: 1.05em;
        color: var(--muted);
        max-width: 75ch;
      }
      .doc h2 {
        margin-top: 28px;
        border-bottom: 1px solid var(--rule);
        padding-bottom: 4px;
      }
      .doc p {
        max-width: 75ch;
      }
      .doc h3 {
        margin-top: 20px;
      }
      .doc code {
        background: var(--code-inline-bg);
        padding: 1px 4px;
        border-radius: 3px;
        font-size: 0.9em;
      }
      .doc pre code {
        background: none;
        padding: 0;
      }
      .astro-code {
        position: relative;
        border-radius: 8px;
        padding: 14px 16px;
      }
      /* copy-to-clipboard button injected into every shiki code block */
      .copy-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        padding: 3px 8px;
        font-size: 0.75em;
        font-family: inherit;
        color: #cdd3da;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.16);
        border-radius: 4px;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.12s;
      }
      .astro-code:hover .copy-btn,
      .copy-btn:focus-visible {
        opacity: 1;
      }
      .copy-btn:hover {
        background: rgba(255, 255, 255, 0.16);
      }
      .demo {
        border: 1px solid var(--border);
        border-radius: 4px;
        margin-bottom: 16px;
      }
      .demo.fill {
        height: 80vh;
        overflow: hidden;
      }
      /* A `client:only` island is an empty element until React hydrates it, and
      Astro gives it `display: contents`, so it draws nothing of its own: a demo
      box sits blank while several hundred KB of engine arrives. Styling the
      island's *empty* state puts a skeleton in that box which removes itself the
      instant React appends a child — no JS, no timer, and nothing left behind to
      shift the page.

      Only on a box that reserves its height (`.reserved`, from the site's
      demoHeights): in a box that doesn't, this line would itself be the layout
      shift it is here to avoid. */
      .demo.reserved > astro-island:empty,
      .demo.fill > astro-island:empty {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        font-size: 0.85em;
      }
      .demo.reserved > astro-island:empty::after,
      .demo.fill > astro-island:empty::after {
        content: 'loading…';
      }
      /* The two ways a box can already own its space need different sizing, and
      neither may add any of its own. `.fill` has a definite height, so `100%`
      resolves against it. `.reserved` has only a min-height, against which
      `100%` would resolve to auto — and an in-flow child given that same
      min-height overflows the content box by the border, because these boxes are
      `border-box`, which is 2px of shift straight back. So: out of flow. */
      .demo.reserved {
        position: relative;
      }
      .demo.reserved > astro-island:empty {
        position: absolute;
        inset: 0;
      }
      .demo.fill > astro-island:empty {
        height: 100%;
      }
      details.source {
        border: 1px solid var(--border);
        border-radius: 4px;
        margin-bottom: 24px;
      }
      details.source > summary {
        cursor: pointer;
        padding: 8px 12px;
        font-weight: 600;
        user-select: none;
      }
      details.source[open] > summary {
        border-bottom: 1px solid var(--border);
      }
      details.source pre {
        padding: 16px;
        border-radius: 0 0 4px 4px;
        overflow: auto;
        margin: 0;
      }
      /* gallery (index) */
      .intro {
        color: var(--muted);
        margin-top: 0;
        max-width: 70ch;
      }
      .gallery section {
        margin-top: 32px;
      }
      .gallery h2 {
        border-bottom: 1px solid var(--rule);
        padding-bottom: 4px;
      }
      .gallery ul {
        list-style: none;
        padding: 0;
        margin: 12px 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 12px;
      }
      .gallery li a {
        display: block;
        height: 100%;
        padding: 12px 14px;
        border: 1px solid var(--border);
        border-radius: 6px;
        text-decoration: none;
        color: inherit;
      }
      .gallery li a:hover {
        border-color: var(--accent);
        background: var(--card-hover);
      }
      .gallery .title {
        font-weight: 600;
        color: var(--accent);
      }
      .gallery .desc {
        color: var(--muted);
        font-size: 0.9em;
        margin-top: 4px;
      }
      @media (max-width: 820px) {
        .layout {
          display: block;
        }
        /* visually-hidden (not display:none) so the checkbox driving the
        disclosure keeps its place in the tab order — otherwise the menu is
        pointer-only */
        .nav-toggle-cb {
          display: block;
          position: absolute;
          width: 1px;
          height: 1px;
          opacity: 0;
          overflow: hidden;
        }
        .nav-toggle-label {
          display: block;
          margin: 0;
          padding: 10px 16px;
          font-size: 0.9em;
          font-weight: 600;
          color: var(--fg);
          cursor: pointer;
          user-select: none;
          border-bottom: 1px solid var(--border);
        }
        .nav-toggle-cb:focus-visible + .nav-toggle-label {
          outline: 2px solid var(--accent);
          outline-offset: -2px;
        }
        aside.sidebar {
          display: none;
          position: static;
          width: 100%;
          height: auto;
          border-right: none;
          border-bottom: 1px solid var(--border);
        }
        .nav-toggle-cb:checked ~ aside.sidebar {
          display: block;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={base}>
        JBrowse 2 <span>· {componentLabel} examples</span>
      </a>
      <nav>
        <div class="siblings" aria-label="JBrowse embedded components">
          {
            siblings.map(s =>
              isSelf(s.base) ? (
                <span
                  class="sibling current"
                  aria-current="true"
                  title={s.title}
                >
                  {s.label}
                </span>
              ) : (
                <a class="sibling" href={siteHref(s.base)} title={s.title}>
                  {s.label}
                </a>
              ),
            )
          }
        </div>
        <a href={docsHref}>Embedding docs</a>
        <a href="https://jbrowse.org/jb2/">jbrowse.org</a>
        {
          /* the deployed commit — see `buildCommit` above. Also emitted as a
            <meta> in <head>, so checking what is live is a curl and a grep
            rather than a screenshot. */
        }
        <span class="build-commit" title="deployed commit">{buildCommit}</span>
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Toggle dark mode"
        >
          ☾
        </button>
      </nav>
    </header>
    <div class="layout">
      <input type="checkbox" id="nav-toggle" class="nav-toggle-cb" />
      <label class="nav-toggle-label" for="nav-toggle">☰ Examples menu</label>
      <aside class="sidebar">
        <nav aria-label="Examples">
          {
            groups.map(group => (
              <div class="nav-group">
                <div class="nav-group-title">{group}</div>
                <ul>
                  {examples
                    .filter(e => e.group === group)
                    .map(e => (
                      <li>
                        <a
                          href={`${base}${e.slug}/`}
                          aria-current={isActive(e.slug) ? 'page' : undefined}
                        >
                          {e.title}
                        </a>
                        {sectionLinks(e).length > 0 && (
                          <ul class="nav-sections">
                            {sectionLinks(e).map(s => (
                              <li>
                                <a href={`${base}${e.slug}/#${s.slug}`}>
                                  {s.title}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>
      <main style={`max-width:${mainMaxWidth}`}>
        <slot />
      </main>
    </div>
    <script is:inline>
      // theme toggle: flip data-theme, remember it, keep the icon in sync
      ;(() => {
        const root = document.documentElement
        const btn = document.getElementById('theme-toggle')
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)')
        const current = () =>
          root.dataset.theme || (prefersDark.matches ? 'dark' : 'light')
        const render = () => {
          btn.textContent = current() === 'dark' ? '☀' : '☾'
        }
        btn.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark'
          root.dataset.theme = next
          localStorage.setItem('jb-theme', next)
          render()
        })
        prefersDark.addEventListener('change', render)
        render()
      })()

      // add a copy button to every shiki code block
      document.querySelectorAll('pre.astro-code').forEach(pre => {
        const code = pre.querySelector('code')
        if (!code) {
          return
        }
        const btn = document.createElement('button')
        btn.type = 'button'
        btn.className = 'copy-btn'
        btn.textContent = 'Copy'
        btn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(code.innerText)
          btn.textContent = 'Copied'
          setTimeout(() => {
            btn.textContent = 'Copy'
          }, 1500)
        })
        pre.appendChild(btn)
      })
    </script>
  </body>
</html>
