---
// Shared example gallery grid for each site's index page. Symlinked into every
// product's src/layouts/, so — like Shell — a site module is imported as
// `~site/...`, never by a relative path.
import { pages } from '~site/examples.ts'

const base = import.meta.env.BASE_URL
const groups = [...new Set(pages.map(e => e.group))]
---

<div class="gallery">
  {groups.map(group => (
    <section>
      <h2>{group}</h2>
      <ul>
        {pages
          .filter(e => e.group === group)
          .map(e => (
            <li>
              <a href={`${base}${e.slug}/`}>
                <div class="title">{e.title}</div>
                <div class="desc">{e.description}</div>
              </a>
            </li>
          ))}
      </ul>
    </section>
  ))}
</div>
