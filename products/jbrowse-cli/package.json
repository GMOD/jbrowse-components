{
  "name": "@jbrowse/cli",
  "version": "5.0.0-beta.2",
  "type": "module",
  "description": "A command line tool for working with JBrowse 2",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "products/jbrowse-cli"
  },
  "author": "JBrowse Team",
  "main": "dist/index.js",
  "bin": {
    "jbrowse": "./dist/bin.js"
  },
  "files": [
    "/dist"
  ],
  "engines": {
    "node": ">=18.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build && pnpm generate-readme",
    "generate-readme": "./generate_readme.sh > README.md"
  },
  "dependencies": {
    "@jbrowse/add-track-core": "workspace:^",
    "@jbrowse/cigar-utils": "workspace:^",
    "@jbrowse/text-indexing-core": "workspace:^",
    "cli-progress": "^3.12.0",
    "ixixx": "^3.0.13",
    "serve-handler": "^6.1.7",
    "tmp": "^0.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
