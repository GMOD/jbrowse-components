{
  "name": "@jbrowse/react-circular-genome-view2",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "JBrowse 2 circular genome view React component",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "MIT",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "products/jbrowse-react-circular-genome-view"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./esm/makeWorkerInstance": "./src/makeWorkerInstance.ts",
    "./esm/makeWorkerInstance.js": "./src/makeWorkerInstance.ts",
    "./esm/rpcWorker": "./src/rpcWorker.ts",
    "./esm/rpcWorker.js": "./src/rpcWorker.ts"
  },
  "files": [
    "esm",
    "dist",
    "docs"
  ],
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm run /^build:/",
    "prepack": "pnpm build",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build:webpack": "webpack -c webpack.config.mjs",
    "clean": "rimraf esm dist *.tsbuildinfo"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/embedded-core": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/plugin-authentication": "workspace:^",
    "@jbrowse/plugin-circular-view": "workspace:^",
    "@jbrowse/plugin-config": "workspace:^",
    "@jbrowse/plugin-data-management": "workspace:^",
    "@jbrowse/plugin-sequence": "workspace:^",
    "@jbrowse/plugin-variants": "workspace:^",
    "@jbrowse/product-core": "workspace:^",
    "@mui/material": "^9.4.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./esm/makeWorkerInstance": "./esm/makeWorkerInstance.js",
      "./esm/makeWorkerInstance.js": "./esm/makeWorkerInstance.js",
      "./esm/rpcWorker": "./esm/rpcWorker.js",
      "./esm/rpcWorker.js": "./esm/rpcWorker.js"
    }
  },
  "sideEffects": false
}
