---
import Example from '../examples/CircularSynteny.tsx'
import code from '../examples/CircularSynteny.tsx?raw'
import { getPage } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('circular-synteny')
---

<Layout page={page}>
  <Section slug="circular-synteny" code={code}>
    <Example client:only="react" />
  </Section>
</Layout>
