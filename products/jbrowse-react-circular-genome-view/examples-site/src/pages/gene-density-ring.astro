---
import Example from '../examples/GeneDensityRing.tsx'
import code from '../examples/GeneDensityRing.tsx?raw'
import GeneDensityMarks from '../examples/GeneDensityMarks.tsx'
import geneDensityMarksCode from '../examples/GeneDensityMarks.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('gene-density-ring')
const ring = section(page, 'gene-density-ring')
const marks = section(page, 'gene-density-marks')
---

<Layout page={page}>
  <Section {...ring} code={code}>
    <Example client:only="react" />
  </Section>
  <Section {...marks} code={geneDensityMarksCode}>
    <GeneDensityMarks client:only="react" />
  </Section>
</Layout>
