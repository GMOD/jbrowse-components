---
import Example from '../examples/SessionInUrl.tsx'
import code from '../examples/SessionInUrl.tsx?raw'
import { pages } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = pages.find(p => p.slug === 'session-in-url')!
---

<Layout page={page}>
  <Section slug="session-in-url" code={code}>
    <Example client:only="react" />
  </Section>
</Layout>
