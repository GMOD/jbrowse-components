---
import WithInlinePlugin from '../examples/WithInlinePlugin.tsx'
import WithInlinePluginCode from '../examples/WithInlinePlugin.tsx?raw'
import WithWebWorker from '../examples/WithWebWorker.tsx'
import WithWebWorkerCode from '../examples/WithWebWorker.tsx?raw'
import { getPage, section } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('plugins')
const sec0 = section(page, 'with-inline-plugin')
const sec1 = section(page, 'with-web-worker')
---

<Layout page={page}>
  <Section {...sec0} code={WithInlinePluginCode}>
    <WithInlinePlugin client:only="react" />
  </Section>
  <Section {...sec1} code={WithWebWorkerCode}>
    <WithWebWorker client:only="react" />
  </Section>
</Layout>
