---
import Example from '../examples/WithLocalFiles.tsx'
import code from '../examples/WithLocalFiles.tsx?raw'
import { getPage } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('local-files')
---

<Layout page={page}>
  <Section slug="with-local-files" code={code}>
    <Example client:only="react" />
  </Section>
</Layout>
