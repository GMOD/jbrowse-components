---
import Example from '../examples/OneLinearGenomeView.tsx'
import Demo from '../layouts/Demo.astro'
import Gallery from '../layouts/Gallery.astro'
import Shell from '../layouts/Shell.astro'
import { landingDemo } from '../siteMeta.ts'
---

<Shell title="Getting started">
  <h1>JBrowse Linear Genome View</h1>
  <p class="lead">
    A genome browser as a React component. For your own UI around the same
    engine, see <a href="https://jbrowse.org/storybook/byo/">Build your own</a>.
  </p>

  <Demo slug={landingDemo}>
    <Example client:only="react" />
  </Demo>

  <Gallery />
</Shell>
