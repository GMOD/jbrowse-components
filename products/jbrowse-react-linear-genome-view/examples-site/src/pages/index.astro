---
import Example from '../examples/WithInit.tsx'
import { examples } from '../examples.ts'
import Gallery from '../layouts/Gallery.astro'
import Shell from '../layouts/Shell.astro'
import {
  componentLabel,
  demoHeights,
  landingDemo,
  mainMaxWidth,
} from '../siteMeta.ts'

const reserved = demoHeights[landingDemo]
---

<Shell
  title="Getting started"
  componentLabel={componentLabel}
  examples={examples}
  mainMaxWidth={mainMaxWidth}
>
  <h1>JBrowse Linear Genome View</h1>
  <p class="lead">A genome browser as a React component.</p>

  <div
    class:list={['demo', { reserved: !!reserved }]}
    style={reserved ? `min-height:${reserved}px` : undefined}
  >
    <Example client:only="react" />
  </div>

  <Gallery examples={examples} />
</Shell>
