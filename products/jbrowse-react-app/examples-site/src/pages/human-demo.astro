---
import Example from '../examples/HumanDemo.tsx'
import code from '../examples/HumanDemo.tsx?raw'
import { getPage } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('human-demo')
---

<Layout page={page}>
  <Section slug="human-demo" code={code}>
    <Example client:only="react" />
  </Section>
</Layout>
