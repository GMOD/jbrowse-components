---
import Example from '../examples/BasicExample.tsx'
import code from '../examples/BasicExample.tsx?raw'
import { getPage } from '../examples.ts'
import Layout from '../layouts/ExampleLayout.astro'
import Section from '../layouts/ExampleSection.astro'

const page = getPage('basic-example')
---

<Layout page={page}>
  <Section slug="basic-example" code={code}>
    <Example client:only="react" />
  </Section>
</Layout>
