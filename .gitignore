# Hand-assembled link to the jb2bench alignment corpus (hundreds of MB of BAM /
# CRAM, generated not downloaded). memsticky.ts and rangecache-probe.ts both
# read a config from here; neither is part of the suite, and neither dataset is
# small enough to commit.
test_data/jb2bench_link/
# Local agent settings stay untracked, but the three jbrowse-* skills are shared
# tools: the docs point readers at them, scripts/sync-skills-repo.ts publishes
# them to cmdcolin/jbrowse-skills, and jbrowse-authoring's config-types.md is
# written by `pnpm autogen`. So they are committed and anything else a
# contributor keeps here is not. Re-including a path needs its parent
# directories un-ignored first — git never descends into an excluded directory,
# and the allowlist is per-skill so a new local one is untracked by default.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/jbrowse-authoring/
!.claude/skills/jbrowse-capture/
!.claude/skills/jbrowse-hosted-data/

# component_tests install npm packages without a committed lockfile (see
# .github/workflows/push.yml); yarn.lock here is a local-only generated artifact
component_tests/*/yarn.lock
component_tests/*/pnpm-lock.yaml
**/.astro

