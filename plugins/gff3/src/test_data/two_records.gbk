                     /mol_type="genomic DNA"
     gene            10..90
                     /locus_tag="CHR_0001"
                     /gene="abcA"
     mRNA            join(10..30,50..90)
                     /locus_tag="CHR_0001"
                     /gene="abcA"
     CDS             join(15..30,50..80)
                     /locus_tag="CHR_0001"
                     /gene="abcA"
                     /codon_start=1
                     /product="ABC transporter, putative; 2=3 & 50%"
