{
  "name": "@jbrowse/plugin-breakpoint-split-view",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "JBrowse 2 breakpoint detail split view",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
