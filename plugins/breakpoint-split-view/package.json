  "dependencies": {
    "@jbrowse/alignments-core": "workspace:^",
    "@jbrowse/cigar-utils": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/modifications-utils": "workspace:^",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/sv-core": "workspace:^",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2"
  },
  "peerDependencies": {
    "react": ">=16.8.4",
    "react-dom": ">=16.8.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
