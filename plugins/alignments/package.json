{
  "name": "@jbrowse/plugin-alignments",
  "version": "4.3.0",
  "type": "module",
  "description": "JBrowse 2 alignments adapters, tracks, etc.",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/alignments"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm run /^build:/",
    "test": "cd ../..; jest --passWithNoTests plugins/alignments",
    "bench:record-shape": "node --expose-gc benches/recordShape.bench.ts",
    "bench:mismatch-walk": "node --expose-gc benches/mismatchWalk.bench.ts",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@gmod/bam": "^9.0.0",
    "@gmod/cram": "^13.4.2",
    "@jbrowse/alignments-core": "workspace:^",
    "@jbrowse/cigar-utils": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/modifications-utils": "workspace:^",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/sv-core": "workspace:^",
    "@jbrowse/wiggle-core": "workspace:^",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "generic-filehandle2": "^2.4.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js"
    }
  },
  "sideEffects": false
}
