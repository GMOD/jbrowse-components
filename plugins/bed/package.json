{
  "name": "@jbrowse/plugin-bed",
  "version": "5.0.0-beta.18",
  "type": "module",
  "description": "JBrowse 2 bed adapters, tracks, etc.",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/bed"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm run /^build:/",
    "test": "cd ../..; jest --passWithNoTests plugins/bed",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@gmod/bbi": "^12.0.0",
    "@gmod/bed": "^2.3.3",
    "@gmod/tabix": "^3.13.0",
    "@gmod/trix": "^3.1.0",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.10.0",
    "mobx": "^7.1.3",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js"
    }
  },
  "sideEffects": false
}
