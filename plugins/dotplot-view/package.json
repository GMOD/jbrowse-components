{
  "name": "@jbrowse/plugin-dotplot-view",
  "version": "5.0.0-beta.22",
  "type": "module",
  "description": "JBrowse 2 dotplot view",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/dotplot-view"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm build:esm",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@jbrowse/alignments-core": "workspace:^",
    "@jbrowse/cigar-utils": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/mobx-state-tree": "catalog:",
    "@jbrowse/plugin-alignments": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/synteny-core": "workspace:^",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "mobx": "catalog:",
    "mobx-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./tables": "./esm/tables.js"
    }
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./tables": "./src/tables.ts"
  }
}
