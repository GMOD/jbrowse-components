{
  "name": "@jbrowse/plugin-variants",
  "version": "4.3.0",
  "type": "module",
  "description": "JBrowse 2 variant adapters, tracks, etc.",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/variants"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm run /^build:/",
    "test": "cd ../..; jest --passWithNoTests plugins/variants",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@gmod/tabix": "^3.8.2",
    "@gmod/vcf": "^7.2.0",
    "@jbrowse/alignments-core": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/ld-core": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.0",
    "@jbrowse/plugin-canvas": "workspace:^",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/sv-core": "workspace:^",
    "@jbrowse/tree-sidebar": "workspace:^",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/x-data-grid": "^9.11.0",
    "fast-deep-equal": "^3.1.3",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "import": "./esm/index.js"
      }
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^"
  }
}
