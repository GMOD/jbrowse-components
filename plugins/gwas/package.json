{
  "name": "@jbrowse/plugin-gwas",
  "version": "5.0.0-beta.18",
  "type": "module",
  "description": "JBrowse 2 GWAS adapters, tracks, and Manhattan plot displays",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/gwas"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm run /^build:/",
    "test": "jest --config ../../jest.config.js --passWithNoTests --testPathPatterns plugins/gwas",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/ld-core": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.10.0",
    "@jbrowse/plugin-bed": "workspace:^",
    "@jbrowse/plugin-marks": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@mui/material": "^9.5.0",
    "mobx": "^7.1.1",
    "mobx-react": "^10.0.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^",
    "@jbrowse/plugin-linear-genome-view": "workspace:^"
  }
}
