{
  "name": "@jbrowse/plugin-maf",
  "version": "5.0.0-beta.23",
  "type": "module",
  "description": "JBrowse 2 multiple alignment format (MAF) viewer",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/maf"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm build:esm",
    "bench:maf-coverage": "cd ../..; node --expose-gc plugins/maf/benches/mafCoverage.bench.ts",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@gmod/bgzf-filehandle": "^6.8.5",
    "@gmod/newick": "^1.1.0",
    "@jbrowse/alignments-core": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/mobx-state-tree": "catalog:",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/tree-sidebar": "workspace:^",
    "@jbrowse/wiggle-core": "workspace:^",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "mobx": "catalog:",
    "mobx-react": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^",
    "@jbrowse/plugin-bed": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js"
    }
  },
  "sideEffects": false
}
