{
  "name": "@jbrowse/plugin-linear-genome-view",
  "version": "4.3.0",
  "type": "module",
  "description": "JBrowse 2 linear genome view",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/linear-genome-view"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "files": [
    "esm"
  ],
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "pnpm run /^build:/",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo",
    "test": "jest --config ../../jest.config.js --passWithNoTests --testPathPatterns plugins/linear-genome-view",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/render-core": "workspace:^",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "import": "./esm/index.js"
      }
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^"
  }
}
