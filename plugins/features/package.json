{
  "name": "@jbrowse/plugin-features",
  "version": "5.0.0-beta.22",
  "type": "module",
  "description": "JBrowse 2 plugin for feature tracks",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/features"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./LinearBasicDisplay/stateModel": "./src/LinearBasicDisplay/model.ts",
    "./LinearBasicDisplay/baseStateModel": "./src/LinearBasicDisplay/baseModel.ts",
    "./tables": "./src/tables.ts",
    "./band": "./src/band.ts",
    "./densityGate": "./src/RenderFeatureDataRPC/densityGate.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm build:esm",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/mobx-state-tree": "catalog:",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@mui/icons-material": "catalog:",
    "@mui/material": "catalog:",
    "mobx": "catalog:",
    "mobx-react": "catalog:",
    "rxjs": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./LinearBasicDisplay/stateModel": "./esm/LinearBasicDisplay/model.js",
      "./LinearBasicDisplay/baseStateModel": "./esm/LinearBasicDisplay/baseModel.js",
      "./tables": "./esm/tables.js",
      "./band": "./esm/band.js",
      "./densityGate": "./esm/RenderFeatureDataRPC/densityGate.js"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^"
  }
}
