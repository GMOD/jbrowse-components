{
  "name": "@jbrowse/plugin-wiggle",
  "version": "5.0.0-beta.2",
  "type": "module",
  "description": "JBrowse 2 wiggle adapters, tracks, etc.",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "plugins/wiggle"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./LinearWiggleDisplay/stateModel": "./src/LinearWiggleDisplay/model.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build": "pnpm run /^build:/",
    "test": "cd ../..; jest --passWithNoTests plugins/wiggle",
    "prepublishOnly": "pnpm test",
    "prepack": "pnpm build",
    "prebuild": "pnpm clean",
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "clean": "rimraf esm *.tsbuildinfo"
  },
  "dependencies": {
    "@gmod/bbi": "^11.2.3",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/tree-sidebar": "workspace:^",
    "@jbrowse/wiggle-core": "workspace:^",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.12.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "rxjs": "^7.8.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "import": "./esm/index.js"
      },
      "./LinearWiggleDisplay/stateModel": {
        "types": "./esm/LinearWiggleDisplay/model.d.ts",
        "import": "./esm/LinearWiggleDisplay/model.js"
      }
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@jbrowse/display-test-utils": "workspace:^"
  }
}
