+// nothing to write.
+describe('the color key is dismissible, like every other row display', () => {
+  function rows(items: MenuItem[]): string[] {
+    return items.flatMap(i => [
+      ...('label' in i && typeof i.label === 'string' ? [i.label] : []),
+      ...('subMenu' in i ? rows(i.subMenu) : []),
+    ])
+  }
