{
  "id": "buffer-churn-pan",
  "measured": "2026-09-04",
  "published": false,
  "source": {
    "kind": "bench",
    "repro": "pnpm --filter @jbrowse/web build, then in products/jbrowse-web: node browser-tests/probe-buffer-churn.ts [--backend=webgl] [--tracks=volvox_alignments] [--tracks=volvox_microarray]",
    "notes": "Headless Chrome with --use-gl=angle on a MacBook Pro (AMD RDNA-1 under WebGPU; the same part under ANGLE for the WebGL2 rung), 1600x900 viewport, a 1588 px LinearGenomeView on volvox ctgA:1-6000 (3.78 bp/px, 2 static blocks). Every GPUDevice.createBuffer / GPUBuffer.destroy and gl.bufferData / gl.deleteBuffer in the page is wrapped, so the uniform ring and UBO are counted too. 'pan' is 60 frames of horizontalScroll(40) — 2400 px, a screen and a half, so the view leaves its loaded blocks and new regions fetch and upload while pruned ones release; 'pan back' is the same distance reversed over ground just left, then settled; '1 px pan' is 60 frames of horizontalScroll(1), a pure redraw inside the loaded blocks. allocs and KB are buffers created and bytes asked for over the whole gesture including the settle; alloc ms is the summed wall time inside the create+write calls, which on WebGPU is the JS call only since the device allocates asynchronously. draws/frame is the median count of instanced draw calls per animation frame that drew anything; the max is the frame an upload landed in."
  },
  "columns": [
    { "key": "scenario", "label": "scenario" },
    { "key": "backend", "label": "rung" },
    { "key": "allocs", "label": "buffers created", "format": "int", "align": "right" },
    { "key": "kb", "label": "bytes", "format": "KB", "align": "right" },
    { "key": "frees", "label": "buffers freed", "format": "int", "align": "right" },
    { "key": "allocMs", "label": "time in create", "format": "ms", "precision": 2, "align": "right" },
    { "key": "panMs", "label": "gesture wall", "format": "ms", "align": "right" },
    { "key": "allocShare", "label": "create share", "format": "percent", "precision": 3, "derived": "allocMs / panMs * 100", "align": "right" },
    { "key": "drawsMed", "label": "draws/frame", "format": "int", "align": "right" },
    { "key": "drawsMax", "label": "draws/frame max", "format": "int", "align": "right" }
  ],
