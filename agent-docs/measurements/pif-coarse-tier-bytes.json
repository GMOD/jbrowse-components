{
  "id": "pif-coarse-tier-bytes",
  "measured": "2026-08-04",
  "source": {
    "kind": "hand",
    "repro": "Build a PIF both ways and compare file sizes: `jbrowse make-pif <paf>` against `jbrowse make-pif --no-coarse <paf>`, at each block length.",
    "notes": "The last column is what the coarse tier costs on disk, so it is computed from the ratio beside it rather than divided out by hand."
  },
  "columns": [
    { "key": "blockLen", "label": "block len" },
    {
      "key": "cigarBytesPerRow",
      "label": "CIGAR bytes/row",
      "format": "compact",
      "suffix": " K"
    },
    {
      "key": "coarseOverFine",
      "label": "coarse/fine bytes",
      "format": "ratio"
    },
    {
      "key": "fileVsNoCoarse",
      "label": "file vs `--no-coarse`",
      "format": "x",
      "derived": "1 + coarseOverFine"
    }
  ],
  "rows": [
