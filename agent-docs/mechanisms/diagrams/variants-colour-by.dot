digraph variant_colour_by {
  rankdir=LR
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] resolve }

  slot [label="color object\nvalue, field, scale", shape=oval]
  slot -> resolve
  resolve [label="cellHueOf\nonce per record"]

  resolve -> none [label=" unset"]
  resolve -> jexl [label=" value: jexl or CSS"]
  resolve -> imp  [label=" field: impact"]
  resolve -> sv   [label=" field: svType"]
  resolve -> ps   [label=" field: phaseSet"]
  resolve -> rec  [label=" any other field"]

  none [label="no hue:\ngenotype colouring"]
  jexl [label="evaluated per record"]
  imp  [label="impact tier, a native fn"]
  sv   [label="palette dealt in the worker\nover the types present"]
  ps   [label="no resolver: a flag the\ncell loops read PS with"]
  rec  [label="read off the record, a colour\nper value or threshold bin;\nno value keeps the alt hue"]

  cells [label="alt-carrying cells\ntake the hue"]
  imp -> cells  sv -> cells  jexl -> cells  rec -> cells
  ps -> cells [style=dashed]

  legend [label="legend reads the same\nfunctions and constants"]
  cells -> legend  none -> legend
}
