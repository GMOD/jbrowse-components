digraph maf_layout {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] drawn; dragged; fits }

  wire [label="the wire names rows by species"]
  place [label="rowIndexBySrc:\nspecies -> screen row"]
  wire -> place
  drawn [label="the display lists this species"]
  place -> drawn
  drawn -> dropped [label=" no"]
  drawn -> row     [label=" yes"]
  dropped [label="dropped, not placed\nat a sentinel"]
  row [label="a placed row, its sequence\na view into the arena"]

  reorder [label="a reorder re-places the cached payload", style=bold]
  row -> reorder

  bands [label="rowsTopOffset:\neach band zeroed by its DATA,\nnot by its setting"]
  reorder -> bands

  dragged [label="the user has dragged a height"]
  bands -> dragged
  dragged -> fixedH [label=" yes"]
  dragged -> autoH  [label=" no"]
  fixedH [label="the height slot wins"]
  autoH [label="fit the species,\nup to a ceiling"]

  viewport [label="rowsHeight: the VIEWPORT,\nnot the content", style=bold]
  fixedH -> viewport  autoH -> viewport

  fits [label="rowHeight is 0 (fit)"]
  viewport -> fits
  fits -> split [label=" yes"]
  fits -> stack [label=" no"]
  split [label="viewport / nrow,\nnot floored at 1px"]
  stack [label="the configured px height"]

  scroll [label="the overflow scrolls;\nfit mode never does"]
  split -> scroll  stack -> scroll
}
