digraph hic_pack {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] hasData; rev }

  pairs [label="every region pair (i, j), i <= j"]
  fetch [label="bounded concurrent reads"]
  pairs -> fetch
  hasData [label="the file has this pair\nat this binsize"]
  fetch -> hasData
  hasData -> drop [label=" no"]
  hasData -> keep [label=" yes"]
  drop [label="contributes nothing"]
  keep [label="un-swap the parser's transpose"]

  concat [label="concatenate, one run per pair"]
  keep -> concat
  layout [label="per-region offset, span, orientation"]
  concat -> layout

  rev [label="the region is reversed"]
  layout -> rev
  rev -> mirror  [label=" yes"]
  rev -> forward [label=" no"]
  mirror  [label="reflect within the region's own span"]
  forward [label="u = (bin + combinedOffset) * binWidth"]

  pack [label="the shader's own instance layout", style=bold]
  mirror -> pack  forward -> pack

  stats [label="max and 95th percentile,\nfinite counts only"]
  pack -> stats
  wire [label="transferred and uploaded zero-copy"]
  stats -> wire

  hover [label="the same map, inverted"]
  wire -> hover [label=" first mousemove"]
}
