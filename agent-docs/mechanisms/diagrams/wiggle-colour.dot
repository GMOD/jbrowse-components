digraph wiggle_colour {
  rankdir=LR
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] declared; layout }

  declared [label="color\na string, or a field\nthrough a scale"]
  declared -> resolved [label=" the config wrote one"]
  declared -> layout   [label=" unset"]

  layout [label="how many plots\nshare the box"]
  layout -> shared [label=" shared"]
  layout -> row    [label=" row"]

  shared [label="several sources in one box:\nfield: source, so each takes a\npalette entry and paints both\nsides of the origin in it"]
  row    [label="a row per source, or one plot:\nfield: score through threshold,\nthe pos/neg pair about the origin"]

  resolved [label="resolveWiggleColor:\nposColor, negColor, pivot,\nrampLut, perSource", style=bold]
  shared -> resolved  row -> resolved

  density [label="under density the pair is the ramp's\ntwo fade ends, so a hue set on a row\nwould replace the scale it is read by:\nidentity moves to labelColor"]
  resolved -> density

  legend [label="the colour key follows the SCALE,\nso the channel and its fallback\ncome from one table"]
  resolved -> legend  density -> legend

  palette [label="one cursor hands out every entry:\ngroups first, then ungrouped rows"]
  shared -> palette
}
