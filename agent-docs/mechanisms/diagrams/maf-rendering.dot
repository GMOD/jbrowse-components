digraph maf_rendering {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] summaryTier; field; y }

  slots [label="color and y\ntwo independent channels"]

  selected [label="selectedRowRendering\nthe radio's tick, zoom-independent", style=bold]
  slots -> selected

  summaryTier [label="summary tier owns the view"]
  slots -> summaryTier
  summaryTier -> fallback [label=" yes"]
  fallback [label="mismatch, no y"]

  field [label="can the color field\ndraw at this zoom"]
  summaryTier -> field [label=" no"]
  field -> keep [label=" yes"]
  field -> mismatch [label=" no: codon off base level,\n identity at base level"]
  keep [label="the field"]
  mismatch [label="mismatch"]

  rowsColor [label="rowsColor\nwhat colours the cells", style=bold]
  fallback -> rowsColor  keep -> rowsColor  mismatch -> rowsColor

  y [label="y set, off the summary tier,\nidentity not yielding at base level"]
  slots -> y
  rowsY [label="rowsY\nwhat the bar height carries", style=bold]
  y -> rowsY

  active [label="activeRowRendering\nxyplot while rowsY, else rowsColor", style=bold]
  rowsColor -> active  rowsY -> active

  marks [label="one GPU mark per rendering\nbases, identity, bars, codon,\nsource chromosome, summary"]
  active -> marks
  base [label="basesRenderingActive\nletters, insertions and\ndeletion counts draw over"]
  active -> base
}
