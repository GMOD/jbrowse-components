digraph maf_rendering {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] slots; summaryTier; kind; base }

  slots [label="three config slots"]
  slots -> codon [label=" showTranslation"]
  slots -> chrom [label=" colorByChromosome"]
  slots -> ident [label=" rowIdentityMode"]
  slots -> bases [label=" none set"]
  codon [label="codon"]
  chrom [label="sourceChrom"]
  ident [label="heatmap / xyplot"]
  bases [label="bases"]

  selected [label="selectedRowRendering\nthe setting, zoom-independent", style=bold]
  codon -> selected  chrom -> selected  ident -> selected  bases -> selected

  summaryTier [label="showSummary"]
  selected -> summaryTier
  summaryTier -> fallback [label=" yes"]
  summaryTier -> kind     [label=" no"]
  fallback [label="bases"]

  kind [label="which selection won"]
  kind -> codonZoom [label=" codon"]
  kind -> identZoom [label=" identity"]
  kind -> chrom2    [label=" sourceChrom"]
  codonZoom [label="codon at base level,\nelse bases"]
  identZoom [label="bases at base level,\nelse the plot"]
  chrom2 [label="sourceChrom, at every zoom"]

  active [label="activeRowRendering\nwhat is painting", style=bold]
  fallback -> active  codonZoom -> active  identZoom -> active  chrom2 -> active

  base [label="basesRenderingActive\ncan the GPU canvas draw it"]
  active -> base
  base -> gpu   [label=" yes"]
  base -> other [label=" no"]
  gpu [label="the GPU canvas owns the rows"]
  other [label="a sibling surface owns them"]

  clear [label="the GPU canvas clears,\nand still counts as a paint", style=bold]
  other -> clear
}
