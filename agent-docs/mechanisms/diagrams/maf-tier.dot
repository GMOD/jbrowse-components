digraph maf_tier {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] zoom; hasSummary; overBudget; framesOn; framesBudget }

  zoom [label="aboveForceLoadFloor"]
  hasSummary [label="a summaryAdapter\nis configured"]
  zoom -> hasSummary [label=" zoomed out"]
  zoom -> detail     [label=" zoomed in"]
  hasSummary -> summary [label=" yes"]
  hasSummary -> detail  [label=" no"]
  summary [label="per-species summary rows"]
  detail  [label="the alignment"]

  gate [label="byteGateAdapterConfig:\nthe file THIS tier reads", style=bold]
  summary -> gate  detail -> gate
  overBudget [label="over fetchSizeLimit"]
  gate -> overBudget
  overBudget -> banner [label=" yes"]
  overBudget -> fetch  [label=" no"]
  banner [label="too-large banner,\nquoting this tier's number"]
  fetch [label="one RPC per buffered region"]

  framesOn [label="CDS frames wanted"]
  fetch -> framesOn
  framesBudget [label="the frames file's\nOWN estimate"]
  framesOn -> framesBudget [label=" yes"]
  framesBudget -> framesFetch [label=" under"]
  framesBudget -> framesOff   [label=" over"]
  framesFetch [label="concurrent, same stop token"]
  framesOff [label="the overlay alone goes missing,\nand says so"]

  swap [label="both tiers cached side by side,\ncleared one way only", style=bold]
  fetch -> swap
}
