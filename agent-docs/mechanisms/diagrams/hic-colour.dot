digraph hic_colour {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] pct; ls; visible }

  data [label="rpcData: maxScore, percentile95\n(both finite by construction)"]
  pct [label="useColorPercentile"]
  data -> pct
  pct -> p95 [label=" on"]
  pct -> ls  [label=" off"]
  p95 [label="percentile95"]
  ls [label="useLogScale"]
  ls -> max    [label=" on"]
  ls -> twentieth [label=" off"]
  max [label="maxScore"]
  twentieth [label="maxScore / 20 — contact counts are\nskewed, so the true max leaves\neverything off-diagonal at the bottom"]

  sat [label="colorMaxScore\n0 is the no-data sentinel,\ninterpreted only by hasLegendData", style=bold]
  p95 -> sat  max -> sat  twentieth -> sat

  map [label="mapHicCount(count, colorMaxScore, useLogScale)\nauthored in hic.slang, lifted to JS by //! js-export.\nBoth floors are load-bearing: log2(1) is 0,\nand a zero max makes the linear branch 0/0"]
  sat -> map

  ramp [label="sample the 256x1 ramp built from\nthe scheme's stops — one table for the GPU\ntexture, the Canvas2D LUT, the CSS legend\nand the SVG legend"]
  map -> ramp

  visible [label="alpha >= MIN_VISIBLE_ALPHA"]
  ramp -> visible
  visible -> paint [label=" yes"]
  visible -> skip  [label=" no"]
  paint [label="fragment returns premultiplied rgb;\nCanvas2D fills the rect"]
  skip [label="the fragment discards and the LUT\nreturns undefined — the same bins are\nabsent from the picture and the export", style=bold]

  legend [label="the legend reads the same stops,\nflattened over white for CSS and split\ninto stop-opacity for SVG"]
  ramp -> legend
}
