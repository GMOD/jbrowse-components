digraph hic_colour {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] pct; ls; visible }

  data [label="maxScore, percentile95"]
  pct [label="useColorPercentile"]
  data -> pct
  pct -> p95 [label=" on"]
  pct -> ls  [label=" off"]
  p95 [label="the 95th percentile"]
  ls [label="useLogScale"]
  ls -> max       [label=" on"]
  ls -> twentieth [label=" off"]
  max [label="the max"]
  twentieth [label="a twentieth of the max"]

  sat [label="colorMaxScore", style=bold]
  p95 -> sat  max -> sat  twentieth -> sat

  map [label="mapHicCount\nauthored in hic.slang"]
  sat -> map
  ramp [label="one 256-entry ramp"]
  map -> ramp

  visible [label="alpha >= MIN_VISIBLE_ALPHA"]
  ramp -> visible
  visible -> paint [label=" yes"]
  visible -> skip  [label=" no"]
  paint [label="painted"]
  skip [label="absent from the figure\nAND from the export", style=bold]

  legend [label="the legend reads the same stops"]
  ramp -> legend
}
