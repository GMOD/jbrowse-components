digraph hic_color {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] pinned; q; visible }

  data [label="maxScore, quantileScore\n(finite counts only)"]
  pinned [label="color.domainMax set"]
  data -> pinned
  pinned -> set [label=" yes"]
  pinned -> q   [label=" no"]
  set [label="domainMax"]
  q [label="domainQuantile < 1"]
  q -> quant [label=" yes"]
  q -> max   [label=" no"]
  quant [label="quantileScore,\nthe 95th percentile by default"]
  max [label="maxScore"]

  domain [label="colorDomain\n[domainMin or 0, top]", style=bold]
  set -> domain  quant -> domain  max -> domain

  norm [label="normalizeScore\nlinear or log, shared with wiggle"]
  domain -> norm
  ramp [label="one 256-entry ramp"]
  norm -> ramp

  visible [label="alpha >= MIN_VISIBLE_ALPHA"]
  ramp -> visible
  visible -> paint [label=" yes"]
  visible -> skip  [label=" no"]
  paint [label="painted"]
  skip [label="absent from the figure\nAND from the export", style=bold]

  legend [label="the legend reads the same stops"]
  ramp -> legend
}
