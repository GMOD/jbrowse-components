digraph maf_rendering {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] summaryTier; baseLevel; bars; codon }

  slots [label="encoding.color, encoding.y,\nalignments.mismatches, alignments.bases\nthe settings, zoom-independent", style=bold]

  summaryTier [label="summary tier owns the view"]
  slots -> summaryTier
  summaryTier -> constant [label=" yes"]
  constant [label="constant fill, no layer"]

  baseLevel [label="base level"]
  summaryTier -> baseLevel [label=" no"]
  baseLevel -> yields [label=" yes"]
  yields [label="identity fill and the\nX-Y plot yield to the constant"]
  baseLevel -> fill [label=" no"]
  fill [label="the fill as written"]

  bars [label="encoding.y set"]
  yields -> bars  fill -> bars
  bars -> barMark [label=" yes"]
  barMark [label="mark bar: the fill\ncolors the bars, no layer"]

  codon [label="bases is codon"]
  bars -> codon [label=" no"]
  codon -> codonLayer [label=" frames file\n and base level"]
  codonLayer [label="the codon layer,\nthe mismatches yield to it"]
  codon -> layers [label=" otherwise"]
  layers [label="the base layer, or\nthe mismatches where shown"]

  plan [label="rowPlan\n{ mark, color, mismatches, bases, perBase }", style=bold]
  constant -> plan  barMark -> plan  codonLayer -> plan  layers -> plan

  marks [label="one GPU mark per channel set:\ncells, identity, bars, codon,\nsource ranks, summary"]
  plan -> marks
  perBase [label="perBase: letters, insertions\nand deletion counts draw over"]
  plan -> perBase
}
