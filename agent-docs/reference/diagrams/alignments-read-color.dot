digraph read_color {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  edge [fontname=monospace fontsize=9]
  { node [shape=diamond] mate; frame; split; unmapped; interchrom; field }

  start [label="read", shape=oval]
  start -> mate

  mate [label="the color field reads the mate:\ninsert size, pair orientation,\nor both"]
  mate -> frame [label=" yes"]
  mate -> field [label=" no"]

  frame [label="in a chain under an orientation\nfield, an unpaired read whose\nchain has a split segment"]
  frame -> framecol [label=" yes"]
  frame -> split    [label=" no"]
  framecol [label="forward or reverse strand,\nrelative to the chain's frame"]

  split [label="in a chain under an orientation\nfield, a paired read whose\nmate is split"]
  split -> inv [label=" inversion"]
  split -> del [label=" deletion"]
  split -> unmapped [label=" neither"]
  inv [label="split inversion"]
  del [label="split deletion"]

  unmapped [label="mate unmapped"]
  unmapped -> unmappedcol [label=" yes"]
  unmapped -> interchrom   [label=" no"]
  unmappedcol [label="unmapped mate"]

  interchrom [label="mate on another chromosome"]
  interchrom -> interchromcol [label=" yes"]
  interchrom -> field         [label=" no"]
  interchromcol [label="interchromosomal"]

  field [label="color field"]
  field -> plain     [label=" none"]
  field -> modbody   [label=" none, under a\n modification layer"]
  field -> strand    [label=" strand"]
  field -> mapq      [label=" mapq"]
  field -> insert    [label=" insert size"]
  field -> firstpair [label=" first-of-pair strand"]
  field -> orient    [label=" pair orientation"]
  field -> both      [label=" insert size and orientation"]
  field -> value     [label=" a tag, an attribute,\n or the mate's chromosome"]
  plain     [label="the plain fill"]
  modbody   [label="a pale tint by\nthe read's own strand"]
  strand    [label="forward or reverse"]
  mapq      [label="its bin's color, or\nunavailable"]
  insert    [label="long, short, or normal insert"]
  firstpair [label="the first mate's strand"]
  orient    [label="one fill per orientation class,\nor none"]
  both      [label="short insert wins, then\norientation, then insert size"]
  value     [label="the value's color, or\nno value"]
}
