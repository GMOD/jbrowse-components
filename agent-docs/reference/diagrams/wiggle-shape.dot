digraph wiggle_shape {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] many; layout; summary; nests }

  many [label="sources"]
  many -> single [label=" one"]
  many -> layout [label=" many"]
  single [label="LinearWiggleDisplay\ninset so end labels are not clipped"]

  layout [label="facet"]
  layout -> multirow [label=" source"]
  layout -> overlay  [label=" unset"]
  multirow [label="one row per source:\nrow height, a scalebar each,\na dendrogram beside it"]
  overlay  [label="every source on row 0,\ninset so end labels are not clipped"]

  plot [label="plot type\nxyplot, density, line (step),\nline (interpolated), scatter"]
  single -> plot  multirow -> plot  overlay -> plot

  summary [label="aggregate, effectiveExtent"]
  plot -> summary
  summary -> range [label=" any mode, line plots"]
  summary -> bands [label=" mean, min or max,\l min-max or none\l (density resolves to none)"]
  range [label="one line through every bin,\ncolored by the origin side it is on;\na min-max extent adds a\ntranslucent band under it"]
  bands [label="one band without an extent,\nthree under min-max; each value\ncolored by its own sign\nagainst the origin"]

  nests [label="density, or filled bars\nthat nest"]
  bands -> nests
  nests -> split [label=" yes"]
  nests -> whole [label=" no"]
  split [label="solid layers, back to front,\nlargest magnitude first"]
  whole [label="one band, per-instance colors"]

  encoded [label="encoded layers\nthe pass, the buffer, the rendering-type\nuniform and the Canvas2D painter\nare all read from these", style=bold]
  split -> encoded  whole -> encoded  range -> encoded

  gaps  [label="gaps: the step line breaks on bp\nadjacency; the interpolated line breaks\nonly past the gap limit, measured in bp"]
  width [label="width: a shared minimum-fill floor,\ngrown from the bin's start;\nthe Canvas2D-only fudge is not in the shader"]
  encoded -> gaps -> width
}
