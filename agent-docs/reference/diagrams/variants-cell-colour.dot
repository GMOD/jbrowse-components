digraph variant_cell_colour {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  edge [fontname=monospace fontsize=9]
  { node [shape=diamond] have; mode; ps; phased; allele; alt; override; called; allref }

  start [label="genotype at (variant, row)", shape=oval]
  start -> have
  have [label="genotype present"]
  have -> nothing [label=" no"]
  have -> mode    [label=" yes"]
  nothing [label="draw nothing"]

  mode [label="unit"]
  mode -> phased [label=" haplotype"]
  mode -> called [label=" sample"]

  phased [label="genotype carries no /\n(phased or haploid)"]
  phased -> uncalled [label=" no"]
  phased -> ps       [label=" yes"]
  uncalled [label="no-call fill, or the\nunphased fill, on every\nhaplotype row (1/1 too)"]

  ps [label="colorByPhaseSet, FORMAT\ncarries PS, and this\nsample has one"]
  ps -> pshue  [label=" yes, on an alt"]
  ps -> allele [label=" otherwise"]
  pshue [label="hue from the phase-set id"]

  allele [label="this row's allele"]
  allele -> nothing   [label=" the sample has no\n such haplotype"]
  allele -> nocallcol [label=" ."]
  allele -> refcol    [label=" 0"]
  allele -> override  [label=" an alt"]
  nocallcol [label="no-call fill"]
  refcol    [label="reference fill,\nor nothing"]

  override [label="a color hue\nresolved for this record"]
  override -> ovcol [label=" yes"]
  override -> alt   [label=" no"]
  ovcol [label="that hue"]

  alt [label="the site's most\nfrequent alt"]
  alt -> althue    [label=" yes"]
  alt -> secondary [label=" no"]
  althue    [label="the alt hue"]
  secondary [label="secondary alt fill"]

  called [label="any allele called"]
  called -> nocallcol [label=" no"]
  called -> allref    [label=" yes"]

  allref [label="every called allele\nis reference"]
  allref -> refcol [label=" yes"]
  allref -> dosage [label=" no"]
  dosage [label="shade(override or alt hue,\nalt / called alleles),\nflat with shadeByDosage off"]
}
