digraph maf_layout {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] drawn }

  wire [label="the wire names rows by species"]
  place [label="rowIndexBySrc:\nspecies -> screen row"]
  wire -> place
  drawn [label="the display lists this species"]
  place -> drawn
  drawn -> dropped [label=" no"]
  drawn -> row     [label=" yes"]
  dropped [label="dropped, not placed\nat a sentinel"]
  row [label="a placed row, its sequence\na view into the arena"]

  reorder [label="a reorder re-places the cached payload", style=bold]
  row -> reorder

  bands [label="rowsTopOffset:\neach band zeroed by its DATA,\nnot by its setting"]
  reorder -> bands

  viewport [label="rowsHeight: the height slot\nless the bands", style=bold]
  bands -> viewport

  split [label="rowsHeight / nrow, not floored\nat 1px: the rows never scroll"]
  viewport -> split
}
