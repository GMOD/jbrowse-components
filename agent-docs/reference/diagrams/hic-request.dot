digraph hic_request {
  rankdir=TB
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] listed; qualifies; offered }

  header [label="CoreGetInfo\nthe file's binsize and\nnormalization lists"]
  listed [label="any binsizes"]
  header -> listed
  listed -> terminal [label=" no"]
  listed -> sorted   [label=" yes"]
  terminal [label="setError"]
  sorted [label="availableResolutions,\nascending"]

  qualifies [label="binSize <= 2 * bpPerPx"]
  sorted -> qualifies
  qualifies -> auto   [label=" some"]
  qualifies -> finest [label=" none"]
  auto   [label="autoResolutionIdx"]
  finest [label="the finest binsize"]

  bias [label="+ resolutionBias, clamped"]
  auto -> bias  finest -> bias
  bias -> effective
  effective [label="effectiveResolution", style=bold]

  selected [label="selectedNormalization"]
  offered [label="the file offers it"]
  selected -> offered
  offered -> active   [label=" yes"]
  offered -> nextBest [label=" no"]
  nextBest [label="the next best it has"]
  active   [label="activeNormalization", style=bold]
  nextBest -> active

  applied [label="appliedNormalization", style=bold]
  active -> applied [label=" the fetch answers"]

  call [label="RenderHicData"]
  effective -> call  active -> call
}
