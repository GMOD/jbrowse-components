digraph wiggle_color {
  rankdir=LR
  node [shape=box fontname=monospace fontsize=10]
  { node [shape=diamond] declared; layout }

  declared [label="color\na string, or a field\nthrough a scale"]
  declared -> encoding [label=" the config wrote one"]
  declared -> layout   [label=" unset"]

  layout [label="the mark, and how many\nplots share the box"]
  layout -> shared [label=" shared"]
  layout -> row    [label=" row"]
  layout -> heat   [label=" span"]

  shared [label="several sources in one box:\nfield: source, so each takes a\npalette entry and paints both\nsides of the origin in it"]
  row    [label="a row per source, or one plot:\nfield: score through threshold,\nthe pos/neg pair about the origin"]
  heat   [label="a heatmap: the same pair,\nas a linear ramp through\nwhite at the origin"]

  encoding [label="colorEncodingOf:\nthe one resolver every\ndisplay's color goes through"]
  shared -> encoding  row -> encoding  heat -> encoding

  resolved [label="resolveWiggleColor:\nposColor, negColor, pivot,\nrampLut", style=bold]
  encoding -> resolved

  density [label="a gradient paints every mark, so a\nhue set on a row would replace the\nscale it is read by: the row color\nstays on its label bar"]
  resolved -> density

  legend [label="the color key follows the SCALE,\nso the channel and its fallback\ncome from one table"]
  resolved -> legend  density -> legend

  palette [label="one cursor hands out range,\nthen the default palette:\ngroups first, then ungrouped rows"]
  shared -> palette
}
