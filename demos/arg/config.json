{
  "plugins": [
    {
      "name": "Arg",
      "umdUrl": "https://jbrowse.org/demos/arg/367573d768a1/jbrowse-plugin-arg.umd.js"
    }
  ],
  "assemblies": [
    {
      "name": "hg38",
      "displayName": "Human (hg38)",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "hg38-refseq",
        "adapter": {
          "type": "TwoBitAdapter",
          "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.2bit",
          "chromSizes": "https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.chrom.sizes"
        }
      },
      "refNameAliases": {
        "adapter": {
          "type": "RefNameAliasAdapter",
          "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/hg38/bigZips/hg38.chromAlias.txt"
        }
      },
      "geneticCodes": {
        "chrM": 2
      }
    },
    {
      "name": "sim",
      "displayName": "Simulated 2 Mb chromosome",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "sim-refseq",
        "adapter": {
          "type": "IndexedFastaAdapter",
          "uri": "https://jbrowse.org/demos/arg/sim/sim.fa"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "FeatureTrack",
      "trackId": "genes",
      "name": "NCBI RefSeq genes",
      "assemblyNames": ["hg38"],
      "category": ["Genes"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://jbrowse.org/genomes/GRCh38/ncbi_refseq/GCA_000001405.15_GRCh38_full_analysis_set.refseq_annotation.sorted.gff.gz"
      }
    },
    {
      "type": "ArgTrack",
      "trackId": "chr20_arg",
      "name": "Simulated ARG (msprime, 50 haplotypes)",
      "assemblyNames": ["hg38"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "https://jbrowse.org/demos/arg/chr20_sim.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr20"
      },
      "displays": [
        {
          "type": "LinearArgDisplay",
          "displayId": "chr20_arg-LinearArgDisplay",
          "height": 420
        }
      ]
    },
    {
      "type": "ArgTrack",
      "trackId": "prnp_arg",
      "name": "Inferred ARG at PRNP (Wohns et al. 2022, 50 haplotypes)",
      "assemblyNames": ["hg38"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "https://jbrowse.org/demos/arg/prnp_real.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr20"
      },
      "displays": [
        {
          "type": "LinearArgDisplay",
          "displayId": "prnp_arg-LinearArgDisplay",
          "height": 330
        }
      ]
    },
    {
      "type": "VariantTrack",
      "trackId": "prnp_variants",
      "name": "1000 Genomes genotypes (the same 23 individuals)",
      "assemblyNames": ["hg38"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "VcfTabixAdapter",
        "uri": "https://jbrowse.org/demos/arg/prnp_variants.vcf.gz"
      },
      "displays": [
        {
          "type": "LinearMultiSampleVariantDisplay",
          "variantLayout": "columns",
          "displayId": "prnp_variants-matrix",
          "height": 200
        }
      ]
    },
    {
      "type": "ArgTrack",
      "trackId": "sim_sweep",
      "name": "Simulated: a beneficial mutation swept to fixation at 1 Mb",
      "assemblyNames": ["sim"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "https://jbrowse.org/demos/arg/sim/sweep.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "ArgTrack",
      "trackId": "sim_introgression",
      "name": "Simulated: population A took in 3% of its DNA from B, 500 generations ago",
      "assemblyNames": ["sim"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "https://jbrowse.org/demos/arg/sim/introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      }
    },
    {
      "type": "FeatureTrack",
      "trackId": "sim_introgression_painting",
      "name": "Simulated introgression, painted by each haplotype's nearest relatives",
      "assemblyNames": ["sim"],
      "category": ["Ancestral recombination graph"],
      "adapter": {
        "type": "ArgAdapter",
        "treesLocation": {
          "uri": "https://jbrowse.org/demos/arg/sim/introgression.trees",
          "locationType": "UriLocation"
        },
        "refName": "chr1"
      },
      "displays": [
        {
          "type": "LinearMultiRowFeatureDisplay",
          "displayId": "sim_introgression_painting-LinearMultiRowFeatureDisplay",
          "rows": "row",
          "color": "jexl:get(feature,'color')",
          "height": 280,
          "rowGroups": [
            {
              "match": "^A ",
              "group": "A",
              "color": "#0072b2"
            },
            {
              "match": "^B ",
              "group": "B",
              "color": "#e69f00"
            }
          ],
          "legend": [
            {
              "label": "relatives mostly A",
              "color": "#0072b2"
            },
            {
              "label": "relatives mostly B",
              "color": "#e69f00"
            }
          ]
        }
      ]
    }
  ],
  "defaultSession": {
    "name": "ARG at PRNP",
    "views": [
      {
        "id": "arg_lgv",
        "type": "LinearGenomeView",
        "assembly": "hg38",
        "loc": "chr20:4,689,000..4,693,000",
        "tracks": ["genes", "prnp_arg", "prnp_variants"]
      }
    ]
  }
}
