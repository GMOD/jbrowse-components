{
  "name": "@jbrowse/alignments-core",
  "version": "5.0.0-beta.18",
  "type": "module",
  "description": "Shared GPU rendering utilities for alignments and synteny displays",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "gpu",
    "webgl",
    "webgpu"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/alignments-core"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./CoverageTooltipTables": "./src/CoverageTooltipTables.tsx",
    "./coverageBandConfigSchema": "./src/coverageBandConfigSchema.ts",
    "./coverageMenuItems": "./src/coverageMenuItems.ts",
    "./layerFilterRules": "./src/layerFilterRules.ts",
    "./variantSortColumn": "./src/variantSortColumn.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/alignments-core",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/cigar-utils": "workspace:^",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@jbrowse/wiggle-core": "workspace:^",
    "mobx": "^7.1.3",
    "mobx-react": "^10.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./CoverageTooltipTables": "./esm/CoverageTooltipTables.js",
      "./coverageBandConfigSchema": "./esm/coverageBandConfigSchema.js",
      "./coverageMenuItems": "./esm/coverageMenuItems.js",
      "./layerFilterRules": "./esm/layerFilterRules.js",
      "./variantSortColumn": "./esm/variantSortColumn.js"
    }
  },
  "sideEffects": false
}
