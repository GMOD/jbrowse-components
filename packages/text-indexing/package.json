{
  "name": "@jbrowse/text-indexing",
  "version": "5.0.0-beta.2",
  "type": "module",
  "description": "JBrowse 2 text indexing for desktop",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "bionode",
    "biojs",
    "genomics"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/text-indexing"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./util": "./src/util.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/text-indexing",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/core": "workspace:^",
    "@jbrowse/text-indexing-core": "workspace:^",
    "ixixx": "^3.0.13"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./util": "./esm/util.js"
    }
  },
  "sideEffects": false
}
