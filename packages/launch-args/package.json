{
  "name": "@jbrowse/launch-args",
  "version": "5.0.0-beta.17",
  "type": "module",
  "description": "The command-line grammar jbrowse-img, jb2capture and JBrowse Desktop share: data files, a genome, a location and tracks, turned into JBrowse config",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "genomics"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/launch-args"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./trackIds": "./src/trackIds.ts",
    "./hostedGenomes": "./src/hostedGenomes.ts",
    "./displaySettings": "./src/displaySettings.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/launch-args",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/add-track-core": "workspace:^",
    "@jbrowse/cigar-utils": "workspace:^"
  },
  "devDependencies": {
    "@jbrowse/core": "workspace:^"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./trackIds": "./esm/trackIds.js",
      "./hostedGenomes": "./esm/hostedGenomes.js",
      "./displaySettings": "./esm/displaySettings.js"
    }
  },
  "sideEffects": false
}
