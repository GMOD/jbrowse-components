{
  "name": "@jbrowse/synteny-core",
  "version": "4.1.14",
  "type": "module",
  "description": "Shared utilities for synteny and dotplot rendering",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "synteny",
    "dotplot"
  ],
  "license": "Apache-2.0",
