{
  "name": "@jbrowse/tree-sidebar",
  "version": "5.0.0-beta.21",
  "type": "module",
  "description": "Shared tree sidebar component for multi-sample displays",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "tree",
    "sidebar",
    "clustering"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/tree-sidebar"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./arrangeRows": "./src/arrangeRows.ts",
    "./binColumns": "./src/binColumns.ts",
    "./clusterMatrix": "./src/clusterMatrix.ts",
    "./clusterUtils": "./src/clusterUtils.ts",
    "./narrowRows": "./src/narrowRows.ts",
    "./rowColorScale": "./src/rowColorScale.ts",
    "./RowHeightMixin": "./src/rowHeight/RowHeightMixin.ts",
    "./RowArrangementDialog": "./src/rowArrangementDialog/RowArrangementDialog.tsx",
    "./treeSidebarRowViews": "./src/treeSidebarRowViews.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/tree-sidebar",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@gmod/hclust": "6.0.0",
    "@gmod/newick": "^1.1.0",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/display-ui": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.10.0",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@jbrowse/render-core": "workspace:^",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/system": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "mobx": "^7.1.6",
    "mobx-react": "^10.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./arrangeRows": "./esm/arrangeRows.js",
      "./binColumns": "./esm/binColumns.js",
      "./clusterMatrix": "./esm/clusterMatrix.js",
      "./clusterUtils": "./esm/clusterUtils.js",
      "./narrowRows": "./esm/narrowRows.js",
      "./rowColorScale": "./esm/rowColorScale.js",
      "./RowHeightMixin": "./esm/rowHeight/RowHeightMixin.js",
      "./RowArrangementDialog": "./esm/rowArrangementDialog/RowArrangementDialog.js",
      "./treeSidebarRowViews": "./esm/treeSidebarRowViews.js"
    }
  },
  "sideEffects": false
}
