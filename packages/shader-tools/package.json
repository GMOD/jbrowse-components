{
  "name": "@jbrowse/shader-tools",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "Slang → WGSL/GLSL + typed-TS shader codegen for JBrowse GPU displays (the `pnpm gen:shaders` pipeline)",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "slang",
    "wgsl",
    "glsl",
    "shader",
    "codegen"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/shader-tools"
  },
  "author": "JBrowse Team",
  "main": "src/build-shaders.ts",
  "bin": {
    "jbrowse-build-shaders": "./src/build-shaders.ts"
  },
  "files": [
    "esm"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/build-shaders.js",
    "types": "esm/build-shaders.d.ts",
    "bin": {
      "jbrowse-build-shaders": "esm/build-shaders.js"
    }
  },
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/shader-tools",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "sideEffects": false
}
