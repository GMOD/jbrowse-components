    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@gmod/vcf": "^7.2.0",
    "@jbrowse/core": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/plugin-linear-genome-view": "workspace:^",
    "@mui/material": "^9.4.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
