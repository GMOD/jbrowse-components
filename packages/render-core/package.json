{
  "name": "@jbrowse/render-core",
  "version": "4.3.0",
  "type": "module",
  "description": "GPU/Canvas2D rendering primitives for JBrowse displays: the HAL, the draw-lifecycle mixin, per-region/global backend bases, and the React backend hooks",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "webgl",
    "webgpu",
    "rendering"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/render-core"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "//files": "src/shaders ships the shared .slang modules (hpmath, colorPack, pointGlyph) that any shader imports. @jbrowse/shader-tools resolves its include path here, so an out-of-tree plugin can compile its own .slang against them.",
  "files": [
    "esm",
    "src/shaders"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./RenderCanvas": "./src/RenderCanvas.tsx",
    "./RenderLifecycleMixin": "./src/RenderLifecycleMixin.ts",
    "./blockClipUtils": "./src/blockClipUtils.ts",
    "./canvas2dUtils": "./src/canvas2dUtils.ts",
    "./canvasContext": "./src/canvasContext.ts",
    "./createRenderingBackend": "./src/createRenderingBackend.ts",
    "./displayPhase": "./src/displayPhase.ts",
    "./globalRenderingBackend": "./src/globalRenderingBackend.ts",
    "./globalUploadSync": "./src/globalUploadSync.ts",
    "./gpuDevice": "./src/gpuDevice.ts",
    "./hal": "./src/hal/index.ts",
    "./installPerRegionLifecycle": "./src/installPerRegionLifecycle.ts",
    "./OverlayCanvas": "./src/OverlayCanvas.tsx",
    "./keyedUploadSync": "./src/keyedUploadSync.ts",
    "./perRegionRenderingBackend": "./src/perRegionRenderingBackend.ts",
    "./regionUploadSync": "./src/regionUploadSync.ts",
    "./renderBlock": "./src/renderBlock.ts",
    "./renderingBackendBase": "./src/renderingBackendBase.ts",
    "./ScrollLockedOverlay": "./src/ScrollLockedOverlay.tsx",
    "./shaders/hpmath": "./src/shaders/hpmath.js.generated.ts",
    "./shaders/pointGlyph": "./src/shaders/pointGlyph.js.generated.ts",
    "./shaders/pointGlyphConsts": "./src/shaders/pointGlyph.generated.ts",
    "./shaders/rowRect": "./src/shaders/rowRect.js.generated.ts",
    "./shaders/rowRectConsts": "./src/shaders/rowRect.generated.ts",
    "./slangPass": "./src/slangPass.ts",
    "./useRenderingBackend": "./src/useRenderingBackend.ts",
    "./useTabVisibilityRerender": "./src/useTabVisibilityRerender.ts"
  },
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/render-core",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/mobx-state-tree": "^6.1.0",
    "mobx": "^7.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "//publishConfig": "The shader subpaths are spelled out because `./*` cannot reach them: it rewrites `./shaders/pointGlyph` to `esm/shaders/pointGlyph.js`, but the source is `pointGlyph.js.generated.ts`, so tsc emits `pointGlyph.js.generated.js` and the wildcard resolves to a file that was never written. Nothing catches that in the workspace — the source `exports` above name the .ts directly — so it only surfaces once a consumer installs the packed tarball.",
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": {
        "types": "./esm/index.d.ts",
        "import": "./esm/index.js"
      },
      "./shaders/hpmath": {
        "types": "./esm/shaders/hpmath.js.generated.d.ts",
        "import": "./esm/shaders/hpmath.js.generated.js"
      },
      "./shaders/pointGlyph": {
        "types": "./esm/shaders/pointGlyph.js.generated.d.ts",
        "import": "./esm/shaders/pointGlyph.js.generated.js"
      },
      "./shaders/pointGlyphConsts": {
        "types": "./esm/shaders/pointGlyph.generated.d.ts",
        "import": "./esm/shaders/pointGlyph.generated.js"
      },
      "./shaders/rowRect": {
        "types": "./esm/shaders/rowRect.js.generated.d.ts",
        "import": "./esm/shaders/rowRect.js.generated.js"
      },
      "./shaders/rowRectConsts": {
        "types": "./esm/shaders/rowRect.generated.d.ts",
        "import": "./esm/shaders/rowRect.generated.js"
      },
      "./*": {
        "types": "./esm/*.d.ts",
        "import": "./esm/*.js"
      }
    }
  },
  "sideEffects": false
}
