{
  "name": "@jbrowse/wiggle-core",
  "version": "5.0.0-beta.1",
  "type": "module",
  "description": "Shared scale and autoscale utilities for wiggle and coverage displays",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "wiggle",
    "scale"
  ],
  "license": "Apache-2.0",
  "homepage": "https://jbrowse.org",
  "bugs": "https://github.com/GMOD/jbrowse-components/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/jbrowse-components.git",
    "directory": "packages/wiggle-core"
  },
  "author": "JBrowse Team",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./normalize": "./src/normalize.ts"
  },
  "files": [
    "esm"
  ],
  "scripts": {
    "build:esm": "node ../../node_modules/typescript7/bin/tsc --build tsconfig.build.esm.json",
    "build": "pnpm build:esm",
    "test": "cd ../..; jest --passWithNoTests packages/wiggle-core",
    "clean": "rimraf esm *.tsbuildinfo",
    "prebuild": "pnpm clean",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@jbrowse/core": "workspace:^",
    "@jbrowse/display-kit": "workspace:^",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/render-core": "workspace:^",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "mobx-react": "^10.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": {
      ".": "./esm/index.js",
      "./constants": "./esm/constants.js",
      "./normalize": "./esm/normalize.js"
    }
  },
  "sideEffects": false
}
